// Full Phase 2 schema. See ARCHITECTURE.md section 4 for the design
// rationale (unified AutomationRule, DB-mediated WorkerCommand channel,
// atomic outbound queue claiming, etc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — kept in sync by convention with packages/shared/src/enums.ts
// ---------------------------------------------------------------------------

enum MessageDirection {
  INCOMING
  OUTGOING
  SYSTEM
}

enum ProcessingStatus {
  PENDING
  PROCESSED
  IGNORED
  FAILED
}

enum RuleStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum RuleType {
  TEAM_FILTER
  DEFAULT_IGNORE
  LAST_SENDER
  EXCEPTION
  SUPPORT_ESCALATION
  AUTO_REPLY
  GENERIC
}

enum MatchType {
  EXACT
  CONTAINS
  KEYWORDS
  REGEX
  ALWAYS
}

enum ActionType {
  IGNORE
  TAG
  AUTO_REPLY
  SUPPORT_REQUIRED
  NOTIFY_TEAMS
  NOTIFY_WHATSAPP
  FORWARD
  STOP_PROCESSING
  /// Manual custom send to a WhatsApp group via the Group Message Sender —
  /// never produced by the rule engine, only by a human-confirmed broadcast job.
  GROUP_BROADCAST
  /// A human typing a reply in the WhatsApp Chat inbox. Never produced by the rule
  /// engine or by AI — only by an authenticated dashboard user pressing send. Still
  /// travels the one outbound queue like every other send, but the queue treats it
  /// differently: the automation kill switch does not cancel it (the switch stops the
  /// robot, not the operator), and hitting an account rate limit defers it rather than
  /// discarding it, so a person's message is never silently dropped.
  MANUAL_REPLY
}

enum OutboundMessageStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
  RATE_LIMITED
  /// Group Message Sender only: queued item deliberately not sent (e.g. group
  /// membership could not be verified, or it was skipped for duplicate-send
  /// protection) — distinct from FAILED, which implies a send was attempted.
  SKIPPED
}

/// Group Message Sender job lifecycle: QUEUED -> RUNNING (first item starts
/// processing) -> COMPLETED (no items left PENDING/PROCESSING), or QUEUED/
/// RUNNING -> CANCELLED (explicit stop) / STOPPED_KILL_SWITCH (automation
/// paused mid-job) — both terminal and never overwritten by the normal
/// COMPLETED transition.
enum GroupBroadcastJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  STOPPED_KILL_SWITCH
}

enum GroupBroadcastSource {
  MANUAL
  EXCEL
  MIXED
}

/// Add-to-Groups job lifecycle — mirrors GroupBroadcastJobStatus (see its
/// doc comment): QUEUED -> RUNNING -> COMPLETED, or a sticky CANCELLED /
/// STOPPED_KILL_SWITCH short-circuit.
enum GroupParticipantAddJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  STOPPED_KILL_SWITCH
}

enum GroupParticipantAddItemStatus {
  PENDING
  PROCESSING
  ADDED
  FAILED
  /// Job was stopped (by a user or the kill switch) before this item's turn came up.
  CANCELLED
}

/// Support tier for Priority-Based Support Monitoring & Escalation. Null on WhatsAppGroup means
/// no tier assigned — the feature never triggers (opt-in per group).
enum SupportPriority {
  P1
  P2
  P3
}

/// A support escalation case's lifecycle. `status` records what the case is CURRENTLY waiting
/// on; the full historical sequence (including which tier actually fired, to whom, when) lives
/// in SupportEscalationEvent — this column is deliberately not a strict re-statement of every
/// diagram box in the spec, just "where is this case stuck right now."
enum EscalationStatus {
  NEW
  MONITORING
  WAITING_FOR_HUMAN
  SECOND_ALERT
  MEMBER_ESCALATED
  ADMIN_ESCALATED
  FOLLOW_UP
  HUMAN_REPLIED
  RESOLVED
  PAUSED
  CANCELLED
}

enum EscalationEventType {
  FIRST_NOTIFICATION
  SECOND_NOTIFICATION
  MEMBER_NOTIFICATION
  ADMIN_NOTIFICATION
  FOLLOW_UP
  HUMAN_REPLIED
  RESOLVED
  PAUSED
  RESUMED
  MANUAL_ESCALATE
  REASSIGNED
  RESET
}

enum EscalationRecipientType {
  GROUP
  MEMBER
  ADMIN
  SYSTEM
}

enum NotificationType {
  TEAMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum WorkerCommandType {
  GET_QR
  RECONNECT
  SEND_LIVE_TEST
  RESYNC_GROUPS
  /// On-demand, single-group participant count lookup (payload: { groupId }) — deliberately NOT
  /// part of the bulk RESYNC_GROUPS path, which only fetches group names for cost reasons.
  GET_GROUP_PARTICIPANT_COUNT
  /// Ends the current WhatsApp session and invalidates its persisted session data so a different
  /// account can scan a fresh QR — distinct from RECONNECT, which reuses the existing session.
  LOGOUT
  /// Dashboard "Run AI analysis now" button (Conversation Learning) — runs
  /// processOneAiAnalysisBatch() immediately instead of waiting for its own long scheduled
  /// interval. No accountId/payload needed; the job scans PatternCandidate rows globally.
  AI_ANALYSIS_BATCH
  /// Microsoft Teams Integration's "Sync Now" button — runs one Teams graph sync + resolution
  /// pass immediately instead of waiting for startTeamsSyncProcessor's own interval. Same
  /// account-agnostic shape as AI_ANALYSIS_BATCH: there is at most one connected TeamsAccount, and
  /// it needs no WhatsApp session at all.
  TEAMS_SYNC_NOW
  /// "Add from a group" on Internal Team Members (payload: { groupId }) — asks WhatsApp who is
  /// actually in a group, so colleagues can be added by ticking real names instead of typing
  /// numbers. Distinct from reading Message history, which only knows people who have already
  /// spoken; a quiet group, or one being set up before any traffic, has nobody there.
  GET_GROUP_PARTICIPANTS
  /// The dashboard's "Build knowledge now" button (payload: { groupId }) — reads one group's
  /// stored conversation and distils it into knowledge entries immediately, instead of waiting
  /// for that group's turn in startGroupKnowledgeProcessor's hourly rotation. Reads the Message
  /// table only; needs no WhatsApp session, same as the two above.
  BUILD_GROUP_KNOWLEDGE
}

enum WorkerCommandStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum AutomationMode {
  MANUAL_ONLY
  SAFE_AUTO_REPLY
  FULL_RULE_AUTOMATION
}

enum TeamMemberStatus {
  ACTIVE
  INACTIVE
}

enum WhatsAppAccountStatus {
  CONNECTED
  DISCONNECTED
  RECONNECTING
  AUTHENTICATION_REQUIRED
  SESSION_ERROR
  OUTBOUND_PAUSED
  RATE_LIMITED
  ERROR
}

/// Real, currently-existing WhatsApp-sending services that can be routed to a specific account
/// instead of Primary. Deliberately a closed enum, not a free string — a typo can't create a
/// silently-dead route. Extend this (plus a migration) the day a new routable service ships;
/// do not add speculative entries for features that don't exist yet.
enum WhatsAppServiceKey {
  /// The rule engine's NOTIFY_WHATSAPP action (alerts a support group when a rule matches).
  NOTIFY_WHATSAPP
  /// Priority-Based Support Monitoring & Escalation's group alerts + member/admin DMs.
  PRIORITY_SUPPORT
  /// Conversation Learning's Unknown Pattern alerts (patternDetectionJob.ts) — a distinct routing
  /// key so an admin can send these to a different account than ordinary rule-matched alerts.
  CONVERSATION_LEARNING
  /// Microsoft Teams Integration's customer resolution notifications (apps/worker/src/teams/
  /// resolutionEngine.ts) — a distinct routing key so a developer-resolved Teams thread notifies
  /// the customer through whichever account owns their original WhatsApp conversation's account,
  /// or an explicitly configured fallback if an admin prefers a dedicated notification account.
  TEAMS_RESOLUTION_NOTIFY
}

enum WhatsAppFallbackPolicy {
  /// Configured account unavailable -> use Primary instead.
  PRIMARY_FALLBACK
  /// Configured account unavailable -> return a clear error, never silently switch accounts.
  STRICT_NO_FALLBACK
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique // optional: login is by username, not email; every existing
  // display site already does `createdBy?.email ?? "—"`, so a missing email was already a
  // normal, handled case before this field was ever made nullable.
  passwordHash String
  name         String

  isActive            Boolean   @default(true) // inactive users are rejected at login and every
  // already-issued session is rejected too (see UserSession/getSession) — never deleted, so
  // audit history (createdRules etc. below) stays intact. Matches this app's existing
  // soft-delete-over-hard-delete standard.
  permissionModuleId  String?
  permissionModule    PermissionModule? @relation(fields: [permissionModuleId], references: [id], onDelete: Restrict)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0) // reset to 0 on every successful login
  lastFailedLoginAt   DateTime? // dedicated timestamp for the lockout window check — deliberately
  // separate from updatedAt, which changes for unrelated reasons (e.g. an admin editing the user)
  // and would otherwise make the rolling-window check unreliable
  lockedUntil         DateTime? // set once failedLoginAttempts crosses SecuritySettings'
  // loginLockoutThreshold within loginLockoutWindowMinutes; checked before the password itself

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions UserSession[]

  createdRules               AutomationRule[]
  createdBroadcastJobs       GroupBroadcastJob[]
  createdOutboundSends       OutboundMessage[]
  createdParticipantAddJobs  GroupParticipantAddJob[]
  createdKnowledgeItems      AiKnowledgeItem[]
  createdKnowledgeImports    KnowledgeImport[]
  createdKnowledgeVersions   AiKnowledgeVersion[]
  resolvedEscalationCases    SupportEscalationCase[]
  triggeredEscalationEvents  SupportEscalationEvent[]
  triggeredLearningBatchJobs LearningBatchJob[]
  reviewedPatternCandidates  PatternCandidate[]
  reviewedRuleProposals      RuleProposal[]
  createdSupportIssues       SupportIssue[]
  /// Set only when an admin manually closes a SupportSession that never received a completion
  /// keyword (apps/web/src/server/actions/supportSessions.ts) — mirrors resolvedEscalationCases'
  /// existing "which logged-in admin resolved this" pattern above.
  closedSupportSessions      SupportSession[]
}

// ---------------------------------------------------------------------------
// App User Management + Permission Modules + Session Management.
//
// UserSession replaces the old stateless signed-cookie token with a real, server-side-revocable
// session record: the cookie carries only a random high-entropy secret, never stored raw — only
// its sha256 (secretHash, unique+indexed) is persisted, so a lookup is an O(1) equality match,
// never a scan. expiresAt is baked in at creation time from SecuritySettings.sessionLifetimeHours
// and is never recalculated — changing the setting later only affects sessions created afterward.
//
// PermissionModule is a reusable, admin-manageable permission profile (Administrator/Support
// Manager/Support Agent/Read Only by default, plus custom ones); Permission is a real table (not
// a Prisma enum, and not a String[] on PermissionModule) seeded from the single source of truth at
// packages/shared/src/permissions.ts, so a permission key typo fails closed against a real FK
// rather than trusting an unchecked string. One PermissionModule per User (source of truth for
// this phase — no per-user permission overrides, see CLAUDE.md/plan for why).
// ---------------------------------------------------------------------------

model PermissionModule {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // true only for the 4 seeded defaults — the delete/rename
  // action blocks on this; permissions assigned to it remain editable
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions PermissionModulePermission[]
  users       User[]
}

/// Canonical permission catalogue — one row per key in packages/shared/src/permissions.ts,
/// seeded/synced by packages/db/prisma/seed.ts. Never created ad hoc from the UI: the key set is
/// code-defined: the UI only lets an admin toggle which keys belong to which PermissionModule.
model Permission {
  id       String @id @default(cuid())
  key      String @unique // e.g. "automation_rules.delete" — matches packages/shared/src/permissions.ts
  label    String
  category String // e.g. "Automation Rules" — for grouped UI display only, not a FK

  modules PermissionModulePermission[]
}

model PermissionModulePermission {
  permissionModuleId String
  permissionModule    PermissionModule @relation(fields: [permissionModuleId], references: [id], onDelete: Cascade)
  permissionId        String
  permission          Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([permissionModuleId, permissionId])
}

model UserSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretHash    String    @unique // sha256(raw secret); the raw secret only ever lives in the cookie
  createdAt     DateTime  @default(now())
  expiresAt     DateTime // absolute: createdAt + SecuritySettings.sessionLifetimeHours at creation
  // time — see banner comment above for why this is never recalculated
  lastUsedAt    DateTime  @default(now())
  ipAddress     String?
  userAgent     String?
  revokedAt     DateTime?
  revokedReason String? // "USER_LOGOUT" | "ADMIN_REVOKED" | "ADMIN_REVOKED_ALL" |
  // "PASSWORD_CHANGED" — plain string, internal bookkeeping only, never a user-facing status enum

  @@index([userId])
  @@index([expiresAt])
}

/// Singleton settings row, same pattern as AutomationSettings (id: "global", upsert-only).
model SecuritySettings {
  id                          String   @id @default("global")
  sessionLifetimeHours        Int      @default(24) // app-layer clamps to [1, 720] (30 days) in
  // the server action — this schema has no numeric CHECK constraints anywhere else, so validation
  // stays entirely in code, consistent with every other settings model
  loginLockoutThreshold       Int      @default(5)
  loginLockoutWindowMinutes   Int      @default(15)
  loginLockoutDurationMinutes Int      @default(15)
  updatedAt                   DateTime @updatedAt
}

model WhatsAppAccount {
  id              String                @id @default(cuid())
  label           String
  phoneNumber     String?
  status          WhatsAppAccountStatus @default(DISCONNECTED)
  qrCode          String? // data URL, written by the worker, polled by the dashboard
  qrUpdatedAt     DateTime?
  lastConnectedAt DateTime?
  lastHeartbeatAt DateTime?
  sessionDataPath String?
  /// OpenWA's own session identifier — distinct from `id` because it doubles as part of the
  /// on-disk Chromium profile path (`${sessionDataPath}/_IGNORE_${sessionId}`, see
  /// OpenWAProvider.clearStaleChromiumLock()). The pre-existing account keeps its historical
  /// value (from WHATSAPP_SESSION_NAME) so its already-authenticated session is never orphaned;
  /// new accounts get a fresh one at creation time.
  sessionId       String?
  /// Exactly one account may be true at a time — enforced by a partial unique index added by
  /// hand to this field's migration (`CREATE UNIQUE INDEX ... WHERE "isPrimary" = true`), not
  /// expressible in the Prisma schema DSL directly. See also the transactional service-layer
  /// guard in setPrimaryAccount() (apps/web/src/server/actions/accounts.ts).
  isPrimary       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  groups               WhatsAppGroup[]
  messages             Message[]
  outboundMessages     OutboundMessage[]
  broadcastJobs        GroupBroadcastJob[]
  participantAddJobs   GroupParticipantAddJob[]
  processingCheckpoint ProcessingCheckpoint?
  escalationCases      SupportEscalationCase[]
  workerCommands       WorkerCommand[]
  notifications        Notification[]
  serviceRoutes        WhatsAppServiceRoute[]
  conversationSessions ConversationSession[]
  supportActivities    SupportActivity[]
  supportSessions      SupportSession[]
  aiFallbackDecisions  AiFallbackDecision[]
  supportIssues        SupportIssue[]
}

/// One row per WhatsAppServiceKey (seeded lazily, like every other settings model in this app —
/// see resolveWhatsAppAccount() in packages/db/src/whatsappRouting.ts). accountId null means
/// "use Primary" — the default, and the only state that exists until an admin explicitly picks
/// a specific account for a service.
model WhatsAppServiceRoute {
  serviceKey     WhatsAppServiceKey     @id
  accountId      String?
  account        WhatsAppAccount?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fallbackPolicy WhatsAppFallbackPolicy @default(PRIMARY_FALLBACK)
  enabled        Boolean                @default(true)
  updatedAt      DateTime               @updatedAt
}

model WhatsAppGroup {
  id                          String              @id @default(cuid())
  accountId                   String
  account                     WhatsAppAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  whatsappGroupId             String // WhatsApp chat id, e.g. "1234567890-1234567890@g.us"
  name                        String
  isMonitored                 Boolean             @default(false)
  /// False once a resync's getAllGroups() no longer returns this group (account left/removed) —
  /// soft-deactivation only, never deleted, so Message history keeps a valid groupId FK.
  isActive                    Boolean             @default(true)
  /// Best-effort, fetched on demand (never during bulk sync — too expensive across hundreds of
  /// real groups) — null until an admin explicitly requests it for this group.
  participantCount            Int?
  lastSyncedAt                DateTime?
  /// Null = no priority tier assigned — Priority-Based Support Monitoring never triggers for this
  /// group (matches today's exact behavior; the feature is entirely opt-in per group).
  priority                    SupportPriority?
  assignedTeamMemberId        String?
  assignedTeamMember          InternalTeamMember? @relation(fields: [assignedTeamMemberId], references: [id], onDelete: SetNull)
  /// Independent kill switch from `priority` itself — lets an admin keep the priority tier
  /// assigned but temporarily pause escalation for this one group without clearing it.
  escalationMonitoringEnabled Boolean             @default(true)
  /// Opt-in for the Hybrid AI Automation fallback layer — mirrors escalationMonitoringEnabled's
  /// per-group-toggle shape. Default false: under AiAutomationScope.PER_GROUP a group must be
  /// explicitly enabled in addition to being isMonitored and the global AiSettings gates being
  /// on, before AI ever fires for it. Ignored under ALL_MONITORED_GROUPS — use
  /// aiAutomationExcluded to hold a group back in that mode.
  aiAutomationEnabled         Boolean             @default(false)
  /// A hard "never let AI answer here", honoured under every scope. For the groups where a
  /// wrong answer costs more than a slow one — a key account, a billing dispute, anywhere a
  /// human must always speak. Beats every other AI gate.
  aiAutomationExcluded        Boolean             @default(false)
  /// Hybrid AI Automation (Slice 3) human-takeover: set to now + AiSettings.
  /// humanTakeoverCooldownMinutes whenever a team member sends a message in this group (see
  /// processIncomingMessage.ts); the AI fallback layer treats a future value here as a silent
  /// ineligibility gate (apps/worker/src/aiFallback/eligibility.ts) — "AI must not immediately
  /// interfere" once a human is actively handling the conversation. Null means not suppressed.
  aiSuppressedUntil           DateTime?
  /// Knowledge builder: when this group's conversation was last distilled into knowledge
  /// entries, and the timestamp of the newest message that run covered. The pair is the
  /// incremental watermark — a later run only reads what arrived after it, so re-running
  /// is cheap and never re-reads the same conversation twice.
  knowledgeBuiltAt            DateTime?
  knowledgeBuiltThroughAt     DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  messages             Message[]
  knowledgeItems       AiKnowledgeItem[]
  broadcastMessages    OutboundMessage[]
  participantAddItems  GroupParticipantAddItem[]
  escalationCases      SupportEscalationCase[]
  conversationSessions ConversationSession[]
  supportActivities    SupportActivity[]
  supportSessions      SupportSession[]
  supportRuleScopes    SupportRuleGroup[]
  aiFallbackDecisions  AiFallbackDecision[]
  supportIssues        SupportIssue[]

  @@unique([accountId, whatsappGroupId])
  @@index([accountId, isActive])
  @@index([accountId, isMonitored])
}

model InternalTeamMember {
  id          String           @id @default(cuid())
  name        String
  phoneNumber String           @unique
  role        String
  department  String?
  status      TeamMemberStatus @default(ACTIVE)
  /// Maps this team member to their Microsoft Teams sender identity (Graph API messages carry an
  /// email/UPN, not a phone number) — nullable/additive since most team members won't have a
  /// Teams account, or won't be mapped yet. Used only for Issue "handled by" attribution
  /// (apps/worker/src/teams/resolutionEngine.ts); never required for the integration to function.
  microsoftEmail String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assignedGroups            WhatsAppGroup[]
  assignedEscalationCases   SupportEscalationCase[]
  SupportEscalationSettings SupportEscalationSettings[]
  supportActivities         SupportActivity[]
  startedSupportSessions    SupportSession[]        @relation("SupportSessionStarted")
  completedSupportSessions  SupportSession[]        @relation("SupportSessionCompleted")
  supportRuleScopes         SupportRuleTeamMember[]
  supportIssues             SupportIssue[]
}

model Message {
  id                String           @id @default(cuid())
  accountId         String
  account           WhatsAppAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId           String?
  group             WhatsAppGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  whatsappMessageId String
  chatId            String
  senderPhone       String
  senderName        String?
  isFromTeamMember  Boolean          @default(false)
  direction         MessageDirection
  body              String
  normalizedBody    String
  timestampWa       DateTime
  receivedAt        DateTime         @default(now())
  isDuplicate       Boolean          @default(false)
  processingStatus  ProcessingStatus @default(PENDING)
  createdAt         DateTime         @default(now())

  /// Set by the (separate, off-by-default) Conversation Learning segmentation job — never written
  /// by the message pipeline itself. Null for every message until that job processes it, and for
  /// every message ever if LearningSettings.conversationLearningEnabled stays false.
  conversationSessionId String?
  conversationSession   ConversationSession? @relation(fields: [conversationSessionId], references: [id], onDelete: SetNull)

  /// Resolved from the WhatsApp "quoted message" (swipe-to-reply) reference, only when the quoted
  /// message is itself already tracked in this table — null if the reply quotes a message from
  /// before this account was tracked, or if the message isn't a reply at all. Powers Support
  /// Activity Tracking's REPLY_TO_CUSTOMER trigger type. SetNull (not Cascade) so deleting the
  /// quoted message never deletes the message that quoted it.
  quotedMessageId  String?
  quotedMessage    Message?  @relation("MessageQuote", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotedByMessages Message[] @relation("MessageQuote")
  /// Digits-only phone numbers @-mentioned in this message (from WhatsApp's mentionedJidList).
  /// Powers Support Activity Tracking's MENTION trigger type.
  mentionedPhones  String[]  @default([])

  executions               AutomationExecution[]
  outboundReplies          OutboundMessage[]
  notifications            Notification[]
  triggeredEscalationCases SupportEscalationCase[]    @relation("EscalationTriggerMessage")
  patternCandidateEvidence PatternCandidateEvidence[]
  supportActivity          SupportActivity?
  aiFallbackDecision       AiFallbackDecision?
  triggeredSupportIssues   SupportIssue[]             @relation("IssueTriggerMessage")

  @@unique([accountId, whatsappMessageId])
  @@index([chatId, timestampWa])
  @@index([groupId, timestampWa])
  @@index([processingStatus])
  @@index([conversationSessionId])
  @@index([quotedMessageId])
  @@index([senderPhone])
}

model AutomationRule {
  id              String     @id @default(cuid())
  name            String
  description     String?
  type            RuleType
  matchType       MatchType
  matchValue      String? // exact/contains/regex pattern; unused for KEYWORDS/ALWAYS
  keywords        String[]   @default([]) // used when matchType = KEYWORDS
  conditions      Json       @default("{}") // RuleConditions (packages/shared)
  actions         Json       @default("[]") // RuleAction[] (packages/shared)
  priority        Int        @default(0)
  status          RuleStatus @default(DRAFT)
  cooldownSeconds Int?
  replyMessage    String?
  replyDelayMinMs Int?
  replyDelayMaxMs Int?
  executionCount  Int        @default(0)
  lastExecutedAt  DateTime?
  createdById     String?
  createdBy       User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  executions       AutomationExecution[]
  outboundMessages OutboundMessage[]
  notifications    Notification[]
  ruleProposal     RuleProposal?

  @@index([status, priority])
}

model AutomationExecution {
  id              String          @id @default(cuid())
  messageId       String
  message         Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  ruleId          String?
  rule            AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  matchedAt       DateTime        @default(now())
  actionsExecuted Json // ActionType[] actually executed (post-idempotency-check)
  decision        String // final pipeline decision, e.g. "IGNORE" | "AUTO_REPLY" | "SUPPORT_REQUIRED" | "NO_MATCH"
  reasonTrace     Json // explainable trace: rules evaluated, matched, skipped, why
  idempotencyKey  String          @unique
  createdAt       DateTime        @default(now())

  @@index([messageId])
  @@index([ruleId])
}

model OutboundMessage {
  id               String                @id @default(cuid())
  accountId        String
  account          WhatsAppAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId           String
  toPhone          String
  body             String
  relatedMessageId String?
  relatedMessage   Message?              @relation(fields: [relatedMessageId], references: [id], onDelete: SetNull)
  ruleId           String?
  rule             AutomationRule?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  actionType       ActionType
  idempotencyKey   String                @unique
  status           OutboundMessageStatus @default(PENDING)
  scheduledAt      DateTime              @default(now())
  attemptCount     Int                   @default(0)
  lastAttemptAt    DateTime?
  sentAt           DateTime?
  failureReason    String?
  delayMs          Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  /// Group Message Sender only (actionType = GROUP_BROADCAST) — every field
  /// below is null for automation-generated rows.
  groupId           String?
  group             WhatsAppGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Group name at send time, independent of the group later being renamed/removed.
  groupNameSnapshot String?
  broadcastJobId    String?
  broadcastJob      GroupBroadcastJob? @relation(fields: [broadcastJobId], references: [id], onDelete: SetNull)
  providerMessageId String?
  createdById       String?
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  aiFallbackDecision   AiFallbackDecision?
  issueResolutionEvent IssueResolutionEvent?

  @@index([status, scheduledAt])
  @@index([toPhone, sentAt])
  @@index([sentAt])
  @@index([broadcastJobId, status])
  @@index([groupId, status])
  @@index([relatedMessageId])
}

/// One row per "send this message to these groups" batch created through the
/// Group Message Sender. Each target group becomes its own OutboundMessage
/// row (actionType = GROUP_BROADCAST) reusing the existing outbound queue —
/// this row is only the batch header: who requested it, the safety
/// configuration it was queued under, and its own stop/kill-switch state.
model GroupBroadcastJob {
  id                  String                  @id @default(cuid())
  accountId           String
  account             WhatsAppAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdById         String?
  createdBy           User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  source              GroupBroadcastSource
  /// Fallback message used for any target group that didn't supply its own
  /// per-row message (e.g. from the Excel "Message" column).
  defaultMessage      String
  status              GroupBroadcastJobStatus @default(QUEUED)
  /// Snapshot of how many groups were queued vs. skipped before sending even
  /// started (unmatched/ambiguous Excel rows, duplicate rows, cooldown
  /// skips) — kept distinct from the OutboundMessage-level SKIPPED status,
  /// which is for a queued row skipped at send time (e.g. failed membership
  /// check).
  totalRequested      Int                     @default(0)
  queuedCount         Int                     @default(0)
  preQueueSkipped     Int                     @default(0)
  /// [{ groupName: string, reason: string }] — rows that never became a
  /// queue item at all, so there is no OutboundMessage row to show why.
  preQueueSkipReasons Json                    @default("[]")
  delayMinMs          Int
  delayMaxMs          Int
  maxPerMinute        Int
  maxPerJob           Int
  retryMaxAttempts    Int
  createdAt           DateTime                @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?

  messages OutboundMessage[]

  @@index([accountId, createdAt])
  @@index([status])
}

/// Singleton row (id is always the literal string "global"), analogous to
/// AutomationSettings but scoped to manual Group Message Sender jobs so
/// tuning bulk-send safety never touches automation's own limits.
model GroupBroadcastSettings {
  id                            String   @id @default("global")
  delayMinMs                    Int      @default(5000)
  delayMaxMs                    Int      @default(15000)
  maxPerMinute                  Int      @default(6)
  maxPerJob                     Int      @default(200)
  retryMaxAttempts              Int      @default(2)
  /// A group that already received a SENT broadcast within this window is
  /// skipped (not re-queued) by a new job — duplicate-send protection beyond
  /// same-job idempotency.
  duplicateGroupCooldownMinutes Int      @default(60)
  updatedAt                     DateTime @updatedAt
}

/// Batch header for the "Add to Groups" module: one phone number, added to
/// N groups (all synchronized groups for the account, or a manual
/// selection). Deliberately its own model rather than reusing
/// GroupBroadcastJob/OutboundMessage — adding a participant is a distinct
/// WhatsApp action with its own (notably stricter) ban-risk profile, so its
/// throttling must be tunable independently (see GroupParticipantAddSettings).
model GroupParticipantAddJob {
  id                  String                       @id @default(cuid())
  accountId           String
  account             WhatsAppAccount              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdById         String?
  createdBy           User?                        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Normalized digits-only phone number (no "+", no leading zeros beyond the country code).
  phoneNumber         String
  status              GroupParticipantAddJobStatus @default(QUEUED)
  /// Snapshot of how many groups were requested vs. skipped before queueing even started
  /// (e.g. "all groups" resolved to zero active groups) — distinct from a per-item FAILED result.
  totalRequested      Int                          @default(0)
  queuedCount         Int                          @default(0)
  preQueueSkipped     Int                          @default(0)
  preQueueSkipReasons Json                         @default("[]")
  delayMinMs          Int
  delayMaxMs          Int
  maxPerMinute        Int
  maxPerJob           Int
  retryMaxAttempts    Int
  createdAt           DateTime                     @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?

  items GroupParticipantAddItem[]

  @@index([accountId, createdAt])
  @@index([status])
}

model GroupParticipantAddItem {
  id                String                        @id @default(cuid())
  jobId             String
  job               GroupParticipantAddJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  groupId           String
  group             WhatsAppGroup                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupNameSnapshot String
  status            GroupParticipantAddItemStatus @default(PENDING)
  attemptCount      Int                           @default(0)
  failureReason     String?
  scheduledAt       DateTime                      @default(now())
  processedAt       DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@unique([jobId, groupId])
  @@index([status, scheduledAt])
}

/// Singleton row (id is always the literal string "global"), analogous to
/// GroupBroadcastSettings but for the Add-to-Groups module. Defaults are
/// deliberately more conservative than GroupBroadcastSettings — WhatsApp
/// treats bulk "add participant" actions as a stronger ban signal than
/// bulk messaging.
model GroupParticipantAddSettings {
  id               String   @id @default("global")
  delayMinMs       Int      @default(10000)
  delayMaxMs       Int      @default(30000)
  maxPerMinute     Int      @default(3)
  maxPerJob        Int      @default(100)
  retryMaxAttempts Int      @default(1)
  updatedAt        DateTime @updatedAt
}

model Notification {
  id                        String             @id @default(cuid())
  type                      NotificationType
  /// Which WhatsApp account this was (or will be) sent through — only meaningful for
  /// type=WHATSAPP; null for TEAMS. Nullable so pre-existing history stays valid, and so a
  /// deleted account's audit trail survives (onDelete: SetNull, not Cascade).
  accountId                 String?
  account                   WhatsAppAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  destination               String
  relatedMessageId          String?
  relatedMessage            Message?           @relation(fields: [relatedMessageId], references: [id], onDelete: SetNull)
  relatedRuleId             String?
  relatedRule               AutomationRule?    @relation(fields: [relatedRuleId], references: [id], onDelete: SetNull)
  /// Set only for Conversation Learning's Unknown Pattern alerts — lets the dashboard list every
  /// alert ever sent for a given PatternCandidate without duplicating pattern data onto this row.
  relatedPatternCandidateId String?
  relatedPatternCandidate   PatternCandidate?  @relation(fields: [relatedPatternCandidateId], references: [id], onDelete: SetNull)
  payload                   Json
  status                    NotificationStatus @default(PENDING)
  attemptCount              Int                @default(0)
  lastAttemptAt             DateTime?
  sentAt                    DateTime?
  failureReason             String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  escalationEvents   SupportEscalationEvent[]
  aiFallbackDecision AiFallbackDecision?

  @@index([status])
  @@index([relatedMessageId])
  @@index([relatedPatternCandidateId])
}

model WorkerCommand {
  id          String              @id @default(cuid())
  type        WorkerCommandType
  /// Nullable so pre-multi-account historical rows (created before this column existed) remain
  /// valid, and so account-agnostic command types (AI_ANALYSIS_BATCH) can omit it entirely — every
  /// other, account-scoped command type still always sets this. onDelete: Cascade since a
  /// queued-but-unprocessed command for a deleted account is meaningless.
  accountId   String?
  account     WhatsAppAccount?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payload     Json?
  status      WorkerCommandStatus @default(PENDING)
  result      Json?
  createdAt   DateTime            @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([accountId, status])
}

model ProcessingCheckpoint {
  id                       String          @id @default(cuid())
  accountId                String          @unique
  account                  WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lastProcessedTimestampWa DateTime?
  lastProcessedMessageId   String?
  updatedAt                DateTime        @updatedAt
}

/// Singleton row (id is always the literal string "global").
model AutomationSettings {
  id                           String         @id @default("global")
  mode                         AutomationMode @default(SAFE_AUTO_REPLY)
  automationEnabled            Boolean        @default(true)
  maxRepliesPerClientPerHour   Int            @default(3)
  maxRepliesPerClientPerDay    Int            @default(10)
  globalMaxPerMinute           Int            @default(5)
  globalMaxPerHour             Int            @default(100)
  globalMaxPerDay              Int            @default(500)
  rateLimitingEnabled          Boolean        @default(true)
  defaultReplyDelayMinMs       Int            @default(3000)
  defaultReplyDelayMaxMs       Int            @default(15000)
  retryMaxAttempts             Int            @default(3)
  retryIntervalsMs             Json           @default("[30000,300000,900000]")
  teamsWebhookUrl              String?
  whatsappNotificationGroupIds String[]       @default([])
  updatedAt                    DateTime       @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  level     LogLevel
  scope     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
}

// ---------------------------------------------------------------------------
// AI Learning & Knowledge System — Phase 1 (foundation only: settings,
// provider/model config, and a manually-curated, versioned Knowledge Base).
// Ingestion (software/chat/document learning, embeddings, duplicate
// detection, AI-generated responses) is deliberately NOT built yet — these
// models exist so later phases have somewhere to write to without another
// migration, per the project's own "do not build everything in one step"
// rule. Activity is logged through the existing SystemLog table (scope
// "ai-learning"), not a parallel audit log.
// ---------------------------------------------------------------------------

enum AiProviderKind {
  ANTHROPIC
  OPENAI
  /// OpenRouter — one key, hundreds of models behind the standard OpenAI
  /// chat-completions protocol. Its own kind rather than OPENAI-with-a-URL so the
  /// provider form can prefill the endpoint and the docs can name it.
  OPENROUTER
  /// A local Ollama (or any other keyless OpenAI-compatible runtime). The only kind
  /// that legitimately has no API key — see AiProvider.apiKeyCiphertext.
  OLLAMA
  GOOGLE
  CUSTOM
}

/// How widely the Hybrid AI Automation fallback is allowed to answer. Both values keep
/// AI strictly reply-triggered and only on a genuine NO_MATCH — the scope decides which
/// groups are eligible, never whether AI outranks a rule that already matched.
/// What the AI is permitted to answer from.
///
/// The distinction this encodes is the important one: a model *knowing* an answer is not the
/// same as this software having the *authority* to give it. A model can describe how billing
/// software generally works; it cannot know how THIS company's billing works, and a fluent guess
/// about a refund window or support hours is worse than no answer at all.
enum AiResponseMode {
  /// Nothing verified covers it, nothing gets answered. The safe default.
  STRICT_KNOWLEDGE_ONLY
  /// General questions ("what is PPPoE?") may be answered from the model's own knowledge, while
  /// anything about this company — its product behaviour, policies, pricing, accounts — still
  /// requires verified knowledge. That second half is not configurable; see AiSettings.
  KNOWLEDGE_PLUS_GENERAL
}

enum AiAutomationScope {
  /// Today's behaviour: a group must have WhatsAppGroup.aiAutomationEnabled set.
  PER_GROUP
  /// Every monitored group is eligible without per-group opt-in. Groups flagged
  /// WhatsAppGroup.aiAutomationExcluded are still held back.
  ALL_MONITORED_GROUPS
}

enum AiProviderStatus {
  ACTIVE
  INACTIVE
}

/// Which job a model is assigned to — mirrors the spec's "Learning Model /
/// Response Model / Vision Model / Document Model / Embedding Model" split,
/// so a future phase can pick a cheaper/faster model per job without a
/// schema change.
enum AiModelJob {
  LEARNING
  RESPONSE
  VISION
  DOCUMENT
  EMBEDDING
  /// The floating AI Admin Assistant chat widget (read-only tool-calling) — apps/web/src/server/
  /// aiAdmin/. Distinct from RESPONSE (reserved for a future customer-facing auto-response phase)
  /// since these are semantically different consumers that shouldn't share one config slot.
  ADMIN_ASSISTANT
}

enum AiKnowledgeCategory {
  SOFTWARE
  WORKFLOW
  FAQ
  TROUBLESHOOTING
  CUSTOMER_RESPONSE
  SOP
  REQUIREMENT
  FEATURE
  POLICY
  ANNOUNCEMENT
  SCREENSHOT
}

/// How a batch of pasted text or an uploaded document is turned into knowledge entries.
/// Modelled as a job rather than done inline because a manual can be far larger than one
/// model call: it is chunked, each chunk costs an API round trip, and the whole thing has to
/// survive a worker restart and report progress while it runs.
enum KnowledgeImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  /// Some chunks produced entries before a later one failed — whatever was extracted is kept.
  PARTIAL
  FAILED
}

enum KnowledgeImportSourceType {
  PASTED_TEXT
  DOCUMENT
}

model KnowledgeImport {
  id         String                    @id @default(cuid())
  /// What this came from, in the operator's words — a file name, or a title they typed.
  /// Copied onto every entry it produces so a reviewer can see the origin without a join.
  label      String
  sourceType KnowledgeImportSourceType @default(PASTED_TEXT)
  /// The extracted plain text. Kept after processing so a failed or disappointing import can be
  /// re-run against a better prompt without asking anyone to find the original file again.
  rawText    String
  /// Optional module hint applied to every entry produced, e.g. "MikroTik Integration".
  module     String?
  status     KnowledgeImportStatus     @default(PENDING)
  chunksTotal    Int                   @default(0)
  chunksDone     Int                   @default(0)
  entriesCreated Int                   @default(0)
  /// Operator-facing failure text; never a stack trace.
  error       String?
  createdById String?
  createdBy   User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  items AiKnowledgeItem[]

  @@index([status, createdAt])
}

enum AiKnowledgeStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Singleton row (id is always the literal string "global"). Every switch
/// defaults OFF/conservative, matching AutomationSettings/GroupBroadcastSettings —
/// none of these actually gate anything yet since the learning/response
/// pipelines they're meant to control don't exist until a later phase.
model AiSettings {
  id                              String   @id @default("global")
  aiEngineEnabled                 Boolean  @default(false)
  learningEnabled                 Boolean  @default(false)
  autoResponseEnabled             Boolean  @default(false)
  /// The Hybrid AI Automation fallback layer's own confidence gate (spec default 90%) — deliberately
  /// separate from learningConfidenceThreshold/autoApprovalThreshold above, which are reserved for
  /// the not-yet-built AI Learning/Knowledge phases and would be an ambiguous field to overload here.
  autoResponseConfidenceThreshold Int      @default(90)
  /// Hybrid AI Automation (Slice 3): reuses the same cooldown mechanism as per-rule AUTO_REPLY
  /// cooldowns (apps/worker/src/queue/cooldown.ts's isCooldownActive(), generalized to accept a
  /// null ruleId) — prevents AI from replying to the same client again too soon. 0 disables it.
  aiReplyCooldownSeconds          Int      @default(300)
  /// Hybrid AI Automation (Slice 3): how long a team-member message suppresses the AI fallback
  /// layer for that group (see WhatsAppGroup.aiSuppressedUntil) — "AI must not immediately
  /// interfere" once a human is actively handling a conversation.
  humanTakeoverCooldownMinutes    Int      @default(30)
  /// Which groups the AI fallback may answer in. Default PER_GROUP preserves the exact
  /// behaviour that shipped before this field existed.
  aiAutomationScope               AiAutomationScope @default(PER_GROUP)
  /// After AI answers a message, draft a reusable AutomationRule from it so the same
  /// question is handled deterministically (and for free) next time. The draft always
  /// lands as a PENDING_REVIEW RuleProposal — never an active rule.
  aiRuleGenerationEnabled         Boolean  @default(false)
  /// Minimum AI confidence before a reply is worth turning into a rule draft. Above the
  /// reply threshold on purpose: answering once at 90% is fine, but codifying that answer
  /// into a standing rule deserves a higher bar.
  aiRuleGenerationMinConfidence   Int      @default(95)
  /// WhatsApp group ids that receive "AI could not handle this, a human is needed" alerts.
  /// Empty falls back to AutomationSettings.whatsappNotificationGroupIds, so existing
  /// deployments keep alerting exactly where they already did.
  takeoverNotifyGroupIds          String[] @default([])
  /// Read whole group conversations and distil them into knowledge base entries.
  knowledgeFromChatEnabled        Boolean  @default(false)
  /// A group with fewer stored messages than this is skipped by the knowledge builder —
  /// there is not enough conversation there to draw a reliable conclusion from.
  knowledgeMinMessagesPerGroup    Int      @default(25)
  /// What the AI may answer from. STRICT_KNOWLEDGE_ONLY is the default and the safe choice.
  ///
  /// Note what is deliberately NOT configurable: under either mode, a question about this
  /// company's own product, policies or accounts is answered only from verified knowledge, and
  /// otherwise goes to a person. Relaxing the mode widens what counts as answerable *general*
  /// conversation; it never lets the model invent this business's behaviour.
  aiResponseMode                  AiResponseMode @default(STRICT_KNOWLEDGE_ONLY)
  /// The bar for an answer given from the model's own knowledge with nothing verified behind it.
  /// Deliberately separate from, and normally higher than, autoResponseConfidenceThreshold:
  /// an ungrounded answer carries more risk than one backed by the team's own material.
  generalAnswerMinConfidence      Int      @default(90)
  screenshotResponseEnabled       Boolean  @default(false)
  chatLearningEnabled             Boolean  @default(false)
  softwareLearningEnabled         Boolean  @default(false)
  requirementLearningEnabled      Boolean  @default(false)
  announcementAiEnabled           Boolean  @default(false)
  /// Percentage (0-100). Two pieces of knowledge at/above this similarity are treated as duplicates.
  duplicateSimilarityThreshold    Int      @default(95)
  learningConfidenceThreshold     Int      @default(90)
  autoApprovalThreshold           Int      @default(95)
  humanReviewThreshold            Int      @default(70)
  updatedAt                       DateTime @updatedAt
}

/// A configured AI provider account (e.g. one Anthropic API key). apiKeyCiphertext
/// is AES-256-GCM encrypted at rest (see server/aiCrypto.ts) — the plaintext key
/// never touches the database or, past the initial form submit, the browser.
model AiProvider {
  id               String           @id @default(cuid())
  name             String
  kind             AiProviderKind
  apiUrl           String?
  /// Null only for a keyless local runtime (kind OLLAMA). Every hosted provider still
  /// requires one, enforced in apps/web/src/server/actions/aiProviders.ts rather than by
  /// the column, so the single genuinely-keyless case does not need a sentinel value.
  apiKeyCiphertext String?
  status           AiProviderStatus @default(ACTIVE)
  priority         Int              @default(0)
  lastTestedAt     DateTime?
  lastTestOk       Boolean?
  lastTestError    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  models              AiModelConfig[]
  learningBatchJobs   LearningBatchJob[]
  patternCandidates   PatternCandidate[]
  aiFallbackDecisions AiFallbackDecision[]
}

/// Exactly one active model assignment per job (see @@unique) — the same
/// "singleton per key" pattern as GroupParticipantAddSettings, just keyed by
/// job instead of a fixed "global" id.
model AiModelConfig {
  id         String     @id @default(cuid())
  job        AiModelJob @unique
  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelId    String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

/// The application's permanent knowledge store (spec section 9). In Phase 1
/// every row is human-authored (aiGenerated=false, source=MANUAL) — the
/// aiGenerated/confidence/source fields exist now so later phases (software
/// learning, chat learning, document learning) can populate the same table
/// without a breaking migration. Always reflects the LATEST version; full
/// history lives in AiKnowledgeVersion.
model AiKnowledgeItem {
  id              String              @id @default(cuid())
  title           String
  category        AiKnowledgeCategory
  question        String?
  answer          String
  procedure       String?
  software        String?
  module          String?
  softwareVersion String?
  source          String              @default("MANUAL")
  /// Set when this entry was distilled from a WhatsApp group conversation by the knowledge
  /// builder — the audit trail back to where the claim came from. SetNull, not Cascade:
  /// deleting a group must not erase what was learned from it.
  sourceGroupId   String?
  sourceGroup     WhatsAppGroup?      @relation(fields: [sourceGroupId], references: [id], onDelete: SetNull)
  /// Set when this entry came from a pasted-text or document import. SetNull for the same
  /// reason as sourceGroupId: deleting the import record must not erase what was learned.
  importId        String?
  import          KnowledgeImport?    @relation(fields: [importId], references: [id], onDelete: SetNull)
  /// Free-text origin shown in the review queue — a file name, a group name, or "Manual entry".
  /// Denormalised on purpose so the queue can show provenance without joining two optional
  /// relations for every row.
  sourceLabel     String?
  confidence      Int?
  aiGenerated     Boolean             @default(false)
  humanVerified   Boolean             @default(true)
  status          AiKnowledgeStatus   @default(ACTIVE)
  currentVersion  Int                 @default(1)
  createdById     String?
  createdBy       User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  versions AiKnowledgeVersion[]

  @@index([category])
  @@index([status])
  @@index([sourceGroupId])
  @@index([importId])
  /// The review queue's own query shape: "everything still waiting to be checked, newest first."
  @@index([humanVerified, createdAt])
}

/// One immutable snapshot per edit (spec section 10 — "never simply
/// overwrite important knowledge"). Version 1 is written at creation time;
/// every subsequent edit adds a new row rather than mutating history.
model AiKnowledgeVersion {
  id              String              @id @default(cuid())
  itemId          String
  item            AiKnowledgeItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  version         Int
  title           String
  category        AiKnowledgeCategory
  question        String?
  answer          String
  procedure       String?
  software        String?
  module          String?
  softwareVersion String?
  changeSummary   String?
  createdById     String?
  createdBy       User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())

  @@unique([itemId, version])
}

// ---------------------------------------------------------------------------
// Hybrid AI Automation — fallback layer (apps/worker/src/aiFallback/). Fires only when the
// deterministic rule engine (packages/engine's evaluate()) genuinely misses on a real customer
// message (finalDecision === "NO_MATCH") and the message's group has opted in. Reuses the existing
// AiModelJob.RESPONSE model slot, the existing OutboundMessage queue, and the existing Notification
// system unchanged — this table is purely the audit trail of what the AI decided, never a second
// send path. At most one row per Message.
// ---------------------------------------------------------------------------

enum AiFallbackOutcome {
  AI_REPLIED
  HUMAN_FALLBACK
}

/// Distinguishes how a PatternCandidateEvidence row was resolved, for Conversation Learning's
/// benefit — populated by patternDetectionJob.ts's evidence-linking query (a later, additive
/// change; the column exists now so that migration doesn't need a second one).
enum EvidenceResponseSource {
  EXISTING_RULE
  HUMAN
  AI
  UNRESOLVED
}

/// Audit trail for the Hybrid AI Automation fallback layer — at most one row per genuine NO_MATCH
/// message that reached the eligibility gate (kill switch, mode, group opt-in, AI Settings all
/// passed). A message that never reached the gate (ineligible) gets no row at all, by design — see
/// apps/worker/src/aiFallback/eligibility.ts's doc comment.
model AiFallbackDecision {
  id        String          @id @default(cuid())
  messageId String          @unique
  message   Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  accountId String
  account   WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId   String?
  group     WhatsAppGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  /// Snapshot of which provider/model actually answered — not a live link, since AiModelConfig can
  /// be reassigned later without invalidating past audit rows.
  aiProviderId String?
  aiProvider   AiProvider? @relation(fields: [aiProviderId], references: [id], onDelete: SetNull)
  modelId      String?

  intent          String?
  confidenceScore Int?
  responseText    String?
  outcome         AiFallbackOutcome
  /// Short diagnostic code (e.g. "LOW_CONFIDENCE", "AI_UNAVAILABLE", "SAFETY_BLOCKED: ...") — free
  /// text, same convention as SystemLog's own message field, not branched on anywhere in code.
  reason          String?

  outboundMessageId String?          @unique
  outboundMessage   OutboundMessage? @relation(fields: [outboundMessageId], references: [id], onDelete: SetNull)
  notificationId    String?          @unique
  notification      Notification?    @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  tokensUsed Int?
  createdAt  DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([outcome, createdAt])
}

// ---------------------------------------------------------------------------
// Priority-Based Support Monitoring & Escalation
// ---------------------------------------------------------------------------

/// One row per priority tier (seeded lazily, like every other settings singleton in this app —
/// see getSupportPriorityPolicies()). SLA minutes are snapshotted onto each
/// SupportEscalationCase at creation time, so editing a policy never rewrites an in-flight case.
model SupportPriorityPolicy {
  id                      String          @id @default(cuid())
  priority                SupportPriority @unique
  firstAlertMinutes       Int
  secondAlertMinutes      Int
  memberEscalationMinutes Int
  adminEscalationMinutes  Int
  followUpIntervalMinutes Int
  maxEscalations          Int
  updatedAt               DateTime        @updatedAt
}

/// Singleton row (id is always the literal string "global").
model SupportEscalationSettings {
  id                String              @id @default("global")
  enabled           Boolean             @default(true)
  escalationAdminId String?
  escalationAdmin   InternalTeamMember? @relation(fields: [escalationAdminId], references: [id], onDelete: SetNull)
  updatedAt         DateTime            @updatedAt
}

/// One open "ticket" per chat with an unanswered priority customer message. Created the moment
/// a non-team-member message arrives in a priority-tagged group with no case already open for
/// that chat (a second customer message before anyone replies extends the existing case rather
/// than opening a duplicate one — see escalationQueue.ts).
model SupportEscalationCase {
  id          String           @id @default(cuid())
  accountId   String
  account     WhatsAppAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId     String
  group       WhatsAppGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  chatId      String
  clientPhone String
  priority    SupportPriority
  status      EscalationStatus @default(NEW)

  triggerMessageId      String
  triggerMessage        Message  @relation("EscalationTriggerMessage", fields: [triggerMessageId], references: [id], onDelete: Cascade)
  lastCustomerMessageAt DateTime

  escalationLevel      Int                 @default(0)
  assignedTeamMemberId String?
  assignedTeamMember   InternalTeamMember? @relation(fields: [assignedTeamMemberId], references: [id], onDelete: SetNull)

  /// Snapshot of the matching SupportPriorityPolicy at case-creation time (see model doc comment).
  firstAlertMinutes       Int
  secondAlertMinutes      Int
  memberEscalationMinutes Int
  adminEscalationMinutes  Int
  followUpIntervalMinutes Int
  maxEscalations          Int

  /// When the escalation worker should next evaluate this case — avoids scanning every open case
  /// every tick, same "claim only what's due" shape as OutboundMessage.scheduledAt.
  nextCheckAt    DateTime
  humanRepliedAt DateTime?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  pausedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events SupportEscalationEvent[]

  @@index([status, nextCheckAt])
  @@index([groupId])
  @@index([chatId])
}

/// The escalation audit trail AND the duplicate-notification guard in one table: the unique
/// constraint below makes it structurally impossible for a worker retry/restart/concurrent tick
/// to send the same tier to the same recipient twice — see fireEscalationEvent() in
/// escalationQueue.ts, which always tries to INSERT this row (inside the same transaction as the
/// Notification it creates) before ever sending anything, and treats a unique-constraint failure
/// as "already handled, skip."
model SupportEscalationEvent {
  id             String                  @id @default(cuid())
  caseId         String
  case           SupportEscalationCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  level          Int
  eventType      EscalationEventType
  recipientType  EscalationRecipientType
  /// Stable identity of the recipient (a WhatsApp group id, an InternalTeamMember id, or the
  /// literal "ADMIN"/"SYSTEM") — this, not recipientLabel, is what the uniqueness guarantee below
  /// keys on, so a tier that fans out to multiple groups gets one idempotent row per group.
  recipientKey   String
  recipientLabel String
  notificationId String?
  notification   Notification?           @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  triggeredById  String?
  triggeredBy    User?                   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt      DateTime                @default(now())

  @@unique([caseId, level, eventType, recipientKey])
  @@index([caseId])
}

// ---------------------------------------------------------------------------
// Conversation Learning / Pattern Discovery — Phase 1 (data collection only).
// A background layer that runs alongside the rule engine, never inside it:
// it only reads already-persisted Message rows and tags them with a session,
// entirely off by default (LearningSettings.conversationLearningEnabled).
// Deterministic pattern detection (PatternCandidate), human review
// (RuleProposal), and AI-assisted analysis are later, separate migrations —
// this phase adds no path that can affect message delivery or rule
// evaluation. See ARCHITECTURE.md-style note in apps/worker/src/learning/.
// ---------------------------------------------------------------------------

enum ConversationSessionStatus {
  OPEN
  CLOSED
}

enum LearningBatchJobType {
  CONVERSATION_SEGMENTATION
  /// Not implemented until the deterministic pattern-detection migration/phase.
  PATTERN_DETECTION
  /// Not implemented until the AI-assisted analysis migration/phase.
  AI_ANALYSIS
}

enum LearningBatchJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum LearningBatchJobTrigger {
  MANUAL
  SCHEDULED
}

/// Groups existing Message rows by chat + inactivity gap — copies no message content, just tags
/// Message.conversationSessionId. Built by a separate batch job (apps/worker/src/learning/
/// sessionSegmentation.ts), never by the message pipeline itself.
model ConversationSession {
  id                String                    @id @default(cuid())
  accountId         String
  account           WhatsAppAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId            String
  groupId           String?
  group             WhatsAppGroup?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  status            ConversationSessionStatus @default(OPEN)
  firstMessageAt    DateTime
  lastMessageAt     DateTime
  messageCount      Int                       @default(0)
  /// Distinct Message.senderPhone values seen so far in this session.
  participantPhones String[]                  @default([])
  closedAt          DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  messages Message[]
  evidence PatternCandidateEvidence[]

  @@index([accountId, chatId, status])
  /// The segmentation job's own "claim only what's due" query: OPEN sessions idle past the gap window.
  @@index([status, lastMessageAt])
}

/// Singleton row (id is always the literal string "global"), same pattern as AutomationSettings/
/// AiSettings. Thresholds here are meaningful even with AI fully off, so they live here rather
/// than on AiSettings — this is deliberately not an "AI settings" table.
model LearningSettings {
  id                                 String   @id @default("global")
  /// The one kill switch for this entire feature — false means the segmentation/pattern-detection
  /// jobs no-op on every tick, and zero rows are written anywhere under this section.
  conversationLearningEnabled        Boolean  @default(false)
  /// Minutes of inactivity on a chat before its current session is closed.
  sessionGapMinutes                  Int      @default(30)
  /// Below this occurrence count, a would-be pattern is not yet promoted to a PatternCandidate row
  /// (enforced starting in the pattern-detection phase) — kept here now so the settings shape is
  /// stable across phases and editable from one place.
  minOccurrenceForCandidate          Int      @default(3)
  minDistinctGroupsForCandidate      Int      @default(2)
  minDistinctClientsForCandidate     Int      @default(2)
  candidateExpiryDays                Int      @default(30)
  /// Explicit opt-in, default OFF — an approved-but-not-yet-active auto-approval policy must never
  /// be assumed; see the pattern-detection/rule-proposal phases.
  autoApprovalEnabled                Boolean  @default(false)
  autoApprovalMinConfidence          Int      @default(97)
  weightFrequency                    Int      @default(25)
  weightDiversity                    Int      @default(20)
  weightConsistency                  Int      @default(20)
  weightResolution                   Int      @default(15)
  weightRecency                      Int      @default(10)
  weightAiConfidence                 Int      @default(10)
  /// Explicit opt-in, default OFF — Unknown Pattern alerts (patternDetectionJob.ts) reuse
  /// AutomationSettings.whatsappNotificationGroupIds as their destination; this flag alone gates
  /// whether that reuse ever fires, independent of conversationLearningEnabled (accumulation can
  /// run silently for a while before an admin decides to also turn alerting on).
  unknownPatternNotificationsEnabled Boolean  @default(false)
  /// Minimum minutes between two alerts for the same PatternCandidate — prevents one recurring
  /// unhandled question from re-notifying on every 15-minute pattern-detection tick.
  unknownPatternCooldownMinutes      Int      @default(60)
  updatedAt                          DateTime @updatedAt
}

/// One row per batch-job run (segmentation, pattern detection, or AI analysis) — audit trail and,
/// for AI_ANALYSIS specifically, the cost-visibility record referenced from the dashboard hub.
model LearningBatchJob {
  id                   String                  @id @default(cuid())
  jobType              LearningBatchJobType
  trigger              LearningBatchJobTrigger
  status               LearningBatchJobStatus  @default(QUEUED)
  triggeredById        String?
  triggeredBy          User?                   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  /// Only ever set for AI_ANALYSIS runs.
  aiProviderId         String?
  aiProvider           AiProvider?             @relation(fields: [aiProviderId], references: [id], onDelete: SetNull)
  candidatesConsidered Int                     @default(0)
  candidatesUpdated    Int                     @default(0)
  errorMessage         String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())

  @@index([status, jobType])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Conversation Learning / Pattern Discovery — Phase 2 (deterministic pattern
// detection). Entirely AI-free: packages/engine/src/patternDetection.ts's
// pure scorer never calls an AI provider. aiConfidenceScore/aiProviderId/
// aiAnalysisSummary below are included now (nullable, unused) so the AI-
// assisted analysis phase doesn't need a second migration on this table.
// ---------------------------------------------------------------------------

enum PatternCandidateStatus {
  PENDING_ANALYSIS
  /// Only reachable once the (later, optional) AI-assisted analysis phase has scored this candidate.
  ANALYZED
  PENDING_REVIEW
  APPROVED
  REJECTED
  /// Folded into another candidate covering the same intent (human/reviewer action, later phase).
  MERGED
  /// Aged out without enough evidence — see LearningSettings.candidateExpiryDays (later phase).
  EXPIRED
}

/// One row per detected pattern signature — created as soon as the first occurrence is seen, so
/// evidence has somewhere to accumulate against. The hard floor (LearningSettings.
/// minOccurrenceForCandidate/minDistinctGroupsForCandidate/minDistinctClientsForCandidate) does
/// NOT gate row creation — it gates whether a row is ever surfaced to a human or considered a real
/// "candidate" anywhere downstream (the dashboard list only queries rows currently past the
/// floor; see patternDetectionJob.ts's rescoreCandidate(), which also refuses to advance `status`
/// past PENDING_ANALYSIS until the floor is met). A single isolated conversation can create a row
/// here, but it can never become visible or actionable.
model PatternCandidate {
  id                      String    @id @default(cuid())
  /// Deterministic signature (sorted distinctive-keyword set) — the same recurring intent always
  /// hashes to the same key, order-independent. See packages/engine/src/patternDetection.ts.
  patternKey              String    @unique
  suggestedMatchType      MatchType
  suggestedKeywords       String[]  @default([])
  suggestedMatchValue     String?
  /// Most common team-member reply text seen following a matching message — evidence, not binding.
  suggestedReplyMessage   String?
  suggestedActionCategory String?

  occurrenceCount     Int      @default(0)
  distinctGroupCount  Int      @default(0)
  distinctClientCount Int      @default(0)
  /// Of occurrenceCount, how many evidence rows have no respondingRuleId — i.e. no existing
  /// AutomationRule fired for that historical message. This is the Unknown Pattern signal: a
  /// pattern an existing rule already handles well can still accumulate as a PatternCandidate
  /// (unchanged, existing behavior) without ever being treated as "unknown".
  unhandledCount      Int      @default(0)
  firstSeenAt         DateTime
  lastSeenAt          DateTime

  /// Individual signal scores (0-100), each computed independently — see computeConfidenceScore().
  frequencyScore     Int  @default(0)
  diversityScore     Int  @default(0)
  consistencyScore   Int  @default(0)
  resolutionScore    Int  @default(0)
  recencyScore       Int  @default(0)
  /// Null until an AI batch analyzes it (later phase) — the confidence formula falls back to
  /// frequencyScore when this is null, so it never degrades in AI-off mode.
  aiConfidenceScore  Int?
  /// Only ever incremented via an explicit reviewer action (later phase), capped at 100.
  humanVerifiedBoost Int  @default(0)
  /// Final blended score — see computeConfidenceScore() in packages/engine.
  confidenceScore    Int  @default(0)

  status            PatternCandidateStatus @default(PENDING_ANALYSIS)
  aiAnalysisSummary String?
  aiProviderId      String?
  aiProvider        AiProvider?            @relation(fields: [aiProviderId], references: [id], onDelete: SetNull)
  reviewedById      String?
  reviewedBy        User?                  @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewNote        String?
  mergedIntoId      String?
  mergedInto        PatternCandidate?      @relation("PatternMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom        PatternCandidate[]     @relation("PatternMerge")

  /// Last time an Unknown Pattern alert was sent for this candidate — the cooldown clock
  /// LearningSettings.unknownPatternCooldownMinutes counts against. Null means never alerted.
  unknownPatternNotifiedAt DateTime?
  unknownPatternAlerts     Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence PatternCandidateEvidence[]
  proposal RuleProposal?

  @@index([status, confidenceScore])
  @@index([lastSeenAt])
  @@index([unhandledCount, lastSeenAt])
}

/// Audit trail proving a PatternCandidate isn't a fluke — one row per ConversationSession that
/// contributed to it. The unique constraint also makes the detection job's upsert idempotent: a
/// session already linked to this candidate is never counted or linked twice.
model PatternCandidateEvidence {
  id                    String                 @id @default(cuid())
  patternCandidateId    String
  patternCandidate      PatternCandidate       @relation(fields: [patternCandidateId], references: [id], onDelete: Cascade)
  conversationSessionId String
  conversationSession   ConversationSession    @relation(fields: [conversationSessionId], references: [id], onDelete: Cascade)
  matchedMessageId      String?
  matchedMessage        Message?               @relation(fields: [matchedMessageId], references: [id], onDelete: SetNull)
  /// Heuristic: a team-member reply followed within the same session.
  wasResolved           Boolean                @default(false)
  /// Set if an AutomationExecution in this session already had a non-null ruleId — a historical-
  /// outcome signal, not a foreign key (the rule may since have been deleted/disabled).
  respondingRuleId      String?
  /// Populated by patternDetectionJob.ts's evidence-linking query (a later, additive change) by
  /// checking for an AiFallbackDecision on the matched message — column added now so that future
  /// change is a single migration-free code change, not a second schema migration.
  responseSource        EvidenceResponseSource @default(UNRESOLVED)
  createdAt             DateTime               @default(now())

  @@unique([patternCandidateId, conversationSessionId])
  @@index([patternCandidateId])
}

// ---------------------------------------------------------------------------
// Conversation Learning / Pattern Discovery — Phase 3/4 (human review + real
// rule execution). A RuleProposal is a fully-formed AutomationRule draft, so
// approving it is a pure copy into a real AutomationRule row (status DRAFT,
// never ACTIVE) — see approveRuleProposal() in
// apps/web/src/server/actions/ruleProposals.ts. The rule engine that then
// executes it (once a human separately flips it ACTIVE on the existing Rules
// page) is completely unmodified by any of this.
// ---------------------------------------------------------------------------

enum RuleProposalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  /// Reserved for a later phase (e.g. an approved-but-not-yet-converted state); every proposal
  /// created today reaches APPROVED and a real AutomationRule in the same transaction.
  CONVERTED
}

/// One row per human-facing proposal, at most one per PatternCandidate (see @@unique below) — a
/// candidate that's rejected or withdrawn does not get a second proposal; if the same pattern
/// keeps recurring, that continues to accumulate as fresh evidence on the same candidate.
/// Where a RuleProposal came from. Both land in the same review queue and approve through
/// the same code path; only the evidence behind them differs.
enum RuleProposalSource {
  /// Conversation Learning's deterministic recurring-pattern detector.
  CONVERSATION_LEARNING
  /// A single message the AI fallback answered well enough to be worth codifying.
  AI_REPLY
}

model RuleProposal {
  id                 String            @id @default(cuid())
  /// Null for an AI_REPLY proposal, which has no recurring pattern behind it. Postgres
  /// permits many NULLs under a unique index, so one-candidate-one-proposal still holds.
  patternCandidateId String?           @unique
  patternCandidate   PatternCandidate? @relation(fields: [patternCandidateId], references: [id], onDelete: Cascade)

  source RuleProposalSource @default(CONVERSATION_LEARNING)
  /// The message that prompted an AI_REPLY proposal, kept for review context.
  sourceMessageId String?  @db.Text
  /// Deterministic keyword signature of the message this was drafted from
  /// (packages/engine's derivePatternSignature). Unique, so a question the AI answers
  /// fifty times produces one draft rather than fifty identical ones.
  sourceSignature String?  @unique

  // Fully-formed AutomationRule draft — same shape as the real row, so approval is a pure copy.
  name            String
  description     String?
  type            RuleType
  matchType       MatchType
  matchValue      String?
  keywords        String[]  @default([])
  conditions      Json      @default("{}")
  actions         Json      @default("[]")
  priority        Int       @default(0)
  cooldownSeconds Int?
  replyMessage    String?
  replyDelayMinMs Int?
  replyDelayMaxMs Int?

  /// Copied from PatternCandidate.confidenceScore at proposal-creation time — a snapshot, not a
  /// live link, so it stays meaningful even if the source candidate's score later changes.
  confidenceScoreSnapshot Int
  status                  RuleProposalStatus @default(PENDING_REVIEW)
  /// Reserved for a later auto-approval phase — every proposal created today is created with this
  /// false and moved to APPROVED only via an explicit human action.
  autoApproved            Boolean            @default(false)
  reviewedById            String?
  reviewedBy              User?              @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt              DateTime?
  reviewNote              String?
  createdRuleId           String?            @unique
  createdRule             AutomationRule?    @relation(fields: [createdRuleId], references: [id], onDelete: SetNull)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([status, confidenceScoreSnapshot])
}

// ---------------------------------------------------------------------------
// Support Activity Tracking — detects configured keyword/rule matches sent by
// configured InternalTeamMembers inside WhatsApp groups, records each as a
// raw SupportActivity event, and lets admins view counts computed from that
// raw history under 3 configurable counting modes + a DAILY counting period.
// Off by default (SupportActivitySettings.enabled = false); when off, the
// detector (apps/worker/src/supportActivity/detector.ts) no-ops and zero
// rows are ever written. Entirely independent of AutomationRule/the rule
// engine's own evaluation — runs alongside it, never gated by its decision.
// ---------------------------------------------------------------------------

enum SupportActivityCountingMode {
  UNIQUE_GROUP
  EVERY_ACTIVITY
  PER_TEAM_MEMBER
}

/// Closed enum (not a free string) so periods stay a pure enum-value + query addition, never a
/// shape rewrite. WEEKLY starts Sunday (regional Fri/Sat weekend convention).
enum SupportActivityCountingPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

/// Closed on purpose (same reasoning as WhatsAppServiceKey's own doc comment). The detector's
/// dispatch (apps/worker/src/supportActivity/detector.ts) is a plain switch on this value, not a
/// plugin system. REACTION is intentionally NOT included yet — WhatsApp reactions arrive via a
/// separate event stream (client.onReaction(), not the onAnyMessage payload these three trigger
/// types read from) and need a dedicated ingestion path + table; add it as its own migration when
/// actually built, not speculatively now.
/// Who delivered a recorded piece of support. Split out so AI-handled conversations can be
/// counted as real support without being silently folded into a person's own numbers — a
/// team member's tally must never include work they did not do.
enum SupportActivityActor {
  TEAM_MEMBER
  /// The Hybrid AI Automation fallback answered a customer and no human was needed. Carries a
  /// null teamMemberId, and deliberately never opens or closes a SupportSession: a session
  /// represents a person handling a conversation over time, which is not what happened here.
  AI
}

enum SupportActivityTriggerType {
  KEYWORD_MATCH
  /// Fires when a support team member's message is a WhatsApp "quoted reply" to a message from a
  /// non-team-member (a real customer) — no keyword needed.
  REPLY_TO_CUSTOMER
  /// Fires when a support team member's message @-mentions at least one non-team-member phone
  /// number — no keyword needed.
  MENTION
  /// Fires on ANY message a support team member sends in an in-scope group — no keyword, no
  /// reply, no mention needed. The simplest possible definition of "this person worked in this
  /// group today", for teams whose support conversations do not follow a keyword convention.
  /// Evaluated after every other trigger so a keyword rule (which can mark a session complete)
  /// still wins when both would match.
  ANY_MESSAGE
}

enum SupportKeywordMatchMode {
  CONTAINS
  EXACT
}

/// Lifecycle of a SupportSession. Deliberately just these two values — a "stale" (OPEN for a long
/// time) session is still, technically, OPEN; staleness is a derived/display-only concept computed
/// at query time (apps/web/src/server/supportActivityReports.ts) from `startedAt`, never a stored
/// status, so it never needs a migration to retune the threshold.
enum SupportSessionStatus {
  OPEN
  COMPLETED
}

/// Singleton row (id is always the literal string "global"), same pattern as AutomationSettings/
/// AiSettings/LearningSettings/SupportEscalationSettings. enabled defaults to false — the whole
/// feature is off until an admin opts in; while off, apps/worker/src/supportActivity/detector.ts
/// no-ops on every message and zero SupportActivity rows are ever written. countingMode/
/// countingPeriod are global, not per-rule, by explicit requirement.
model SupportActivitySettings {
  id             String                        @id @default("global")
  enabled        Boolean                       @default(false)
  countingMode   SupportActivityCountingMode   @default(EVERY_ACTIVITY)
  countingPeriod SupportActivityCountingPeriod @default(DAILY)
  updatedAt      DateTime                      @updatedAt
}

/// Admin-managed keyword/phrase. Referenced by zero or more SupportRules via SupportRuleKeyword —
/// not a free-text array on the rule itself, unlike AutomationRule.keywords, because keywords here
/// are independently CRUD-able (add/edit/delete/enable-disable) and reused across rules.
model SupportKeyword {
  id            String                  @id @default(cuid())
  value         String
  matchMode     SupportKeywordMatchMode @default(CONTAINS)
  /// Default false (case-insensitive) — matches every existing text-matching convention in this
  /// app (see packages/engine/src/normalize.ts's normalizeText()).
  caseSensitive Boolean                 @default(false)
  isActive      Boolean                 @default(true)
  /// Flags this keyword as a support-session completion signal (apps/worker/src/supportActivity/
  /// sessionTracker.ts). Still completely inert on its own — it must be attached to an active
  /// KEYWORD_MATCH SupportRule scoped to the relevant group/members to ever actually fire, exactly
  /// like every other SupportKeyword. Read off the already-matched keyword returned by detector.ts;
  /// never a second, parallel matching pass.
  marksCompletion Boolean               @default(false)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  rules      SupportRuleKeyword[]
  activities SupportActivity[]
}

/// One admin-configured detection rule. Global (no accountId), same precedent as AutomationRule.
/// Scope to "all X" vs "selected X" is a boolean flag + a join table used only when the flag is
/// false — the minimal shape for this, not a JSON id array (which is harder to index/join safely).
model SupportRule {
  id                      String                     @id @default(cuid())
  name                    String
  description             String?
  triggerType             SupportActivityTriggerType @default(KEYWORD_MATCH)
  /// true = every WhatsAppGroup is in scope; false = only groups explicitly listed in `groups`.
  appliesToAllGroups      Boolean                    @default(true)
  /// true = every InternalTeamMember is in scope; false = only members explicitly listed in
  /// `teamMembers`.
  appliesToAllTeamMembers Boolean                    @default(true)
  isActive                Boolean                    @default(true)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  keywords    SupportRuleKeyword[]
  groups      SupportRuleGroup[]
  teamMembers SupportRuleTeamMember[]
  activities  SupportActivity[]

  /// The detector's primary WHERE-clause shape: "active rules of this trigger type."
  @@index([isActive, triggerType])
}

model SupportRuleKeyword {
  ruleId    String
  rule      SupportRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  keywordId String
  keyword   SupportKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([ruleId, keywordId])
}

model SupportRuleGroup {
  ruleId    String
  rule      SupportRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  groupId   String
  group     WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([ruleId, groupId])
}

model SupportRuleTeamMember {
  ruleId       String
  rule         SupportRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  teamMemberId String
  teamMember   InternalTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@id([ruleId, teamMemberId])
}

/// One row per detected support-activity event — the raw, permanent history. Aggregated counts
/// (UNIQUE_GROUP / EVERY_ACTIVITY / PER_TEAM_MEMBER, over SupportActivitySettings.countingPeriod)
/// are always computed from this table at query time (see apps/web/src/server/
/// supportActivityReports.ts) — this table never stores a final count, so changing countingMode/
/// countingPeriod retroactively reinterprets all existing history correctly.
model SupportActivity {
  id           String              @id @default(cuid())
  accountId    String
  account      WhatsAppAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId      String
  group        WhatsAppGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Nullable + SetNull (not Cascade) so a later-deleted InternalTeamMember never destroys already-
  /// recorded history — only its per-member attribution on that one row degrades to "unassigned."
  teamMemberId String?
  teamMember   InternalTeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  /// Who delivered this support. TEAM_MEMBER rows always carry a teamMemberId; AI rows never do.
  /// Defaulted so every row written before this column existed keeps its original meaning.
  actor        SupportActivityActor @default(TEAM_MEMBER)
  /// Nullable + SetNull, same reasoning: a deleted SupportRule/SupportKeyword must never delete
  /// history (mirrors AutomationExecution.ruleId's exact pattern).
  ruleId       String?
  rule         SupportRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  keywordId    String?
  keyword      SupportKeyword?     @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  /// The idempotency guard: at most one SupportActivity row can ever exist per Message. Enforced
  /// here as a real DB constraint (insert-and-catch-P2002), not an application-level check-then-
  /// insert race — mirrors how Message's own @@unique([accountId, whatsappMessageId]) is the real
  /// dedup guard, and AutomationExecution.idempotencyKey's @unique column.
  messageId    String              @unique
  message      Message             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// = Message.timestampWa (WhatsApp's own send time), not receivedAt/createdAt — this is what
  /// every DAILY (and future WEEKLY/MONTHLY) period boundary buckets against.
  occurredAt   DateTime
  createdAt    DateTime            @default(now())

  /// Back-relations for SupportSession's two possible references to this exact activity row (the
  /// session it opened, and/or — on a different row — the session it closed via a completion
  /// keyword). A single activity can be at most one of these, never both.
  startedSession   SupportSession? @relation("SupportSessionFirstActivity")
  completedSession SupportSession? @relation("SupportSessionCompletionActivity")

  @@index([accountId, occurredAt])
  @@index([accountId, groupId, occurredAt])
  @@index([accountId, teamMemberId, occurredAt])
  @@index([accountId, actor, occurredAt])
  @@index([ruleId])
}

/// One open-or-completed support session per WhatsAppGroup lifecycle — group-level scope by
/// explicit requirement, NOT per team member: many groups can each have their own OPEN session at
/// the same time, but a single group can never have more than one. Opens on the first tracked
/// team-member SupportActivity in a group with no currently-open session; any other team member's
/// activity in that same group while it's OPEN just accumulates against it (no new session, no
/// attribution change). Closes either (a) automatically, when any team member's message matches a
/// SupportKeyword.marksCompletion keyword via the exact same SupportRule/detector.ts pipeline that
/// already runs for every other trigger type, or (b) manually, via an admin's explicit "Close
/// Session" action (apps/web/src/server/actions/supportSessions.ts) when no completion keyword was
/// ever sent. There is deliberately NO automatic timeout/inactivity-based closure of any kind — an
/// OPEN session stays OPEN forever until one of those two explicit events happens; a long-open
/// session is surfaced to admins as "stale" purely as a derived, query-time UI state (see
/// getGroupSessionHistory in apps/web/src/server/supportActivityReports.ts), never a stored status.
model SupportSession {
  id        String               @id @default(cuid())
  accountId String
  account   WhatsAppAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId   String
  group     WhatsAppGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status    SupportSessionStatus @default(OPEN)

  /// Mirrors `groupId` while status=OPEN; set to null the instant the session completes (either
  /// path). Exists solely so an ordinary (non-partial) `@@unique` can enforce "at most one OPEN
  /// session per group" as a real DB constraint — Prisma's schema DSL has no partial/filtered-index
  /// syntax, and Postgres unique constraints already treat multiple NULLs as non-conflicting, so
  /// this sparse-column trick gets a real constraint without hand-edited migration SQL that a later
  /// `prisma migrate dev` diff could propose dropping (since schema.prisma can't represent it).
  openGroupId String? @unique

  startedAt             DateTime
  /// Whoever's activity opened the session. Never overwritten by later contributors to the same
  /// still-open session — only the first activity sets this.
  startedByTeamMemberId String?
  startedByTeamMember   InternalTeamMember? @relation("SupportSessionStarted", fields: [startedByTeamMemberId], references: [id], onDelete: SetNull)
  /// Nullable + SetNull, same "already-recorded history must outlive a later-deleted row" reasoning
  /// as SupportActivity.ruleId/keywordId — a purged SupportActivity row must never destroy this
  /// session's own startedAt/duration facts.
  firstActivityId String?          @unique
  firstActivity   SupportActivity? @relation("SupportSessionFirstActivity", fields: [firstActivityId], references: [id], onDelete: SetNull)

  completedAt DateTime?
  /// Whoever's completion-keyword activity closed the session (automatic path only). Left null for
  /// a manual admin close, since InternalTeamMember and the admin's own User login are two
  /// unrelated identities in this schema with no reliable mapping between them — see
  /// completedByUserId below for that case instead of guessing/inventing a fake team member.
  completedByTeamMemberId String?
  completedByTeamMember   InternalTeamMember? @relation("SupportSessionCompleted", fields: [completedByTeamMemberId], references: [id], onDelete: SetNull)
  /// Set only for the automatic (completion-keyword) close path; null for a manual admin close,
  /// which has no backing SupportActivity row at all.
  completionActivityId String?          @unique
  completionActivity   SupportActivity? @relation("SupportSessionCompletionActivity", fields: [completionActivityId], references: [id], onDelete: SetNull)
  /// Set only for the manual admin-close path (apps/web/src/server/actions/supportSessions.ts),
  /// mirroring SupportEscalationCase.resolvedById's existing "which logged-in admin resolved this"
  /// pattern — reusing that convention rather than inventing a new audit mechanism. Mutually
  /// exclusive with completedByTeamMemberId in practice (automatic close never sets this; manual
  /// close never sets completedByTeamMemberId).
  completedByUserId String?
  completedByUser   User?     @relation(fields: [completedByUserId], references: [id], onDelete: SetNull)

  /// Computed once at completion time (completedAt - startedAt, in whole seconds) and persisted —
  /// an immutable historical fact once closed, same "snapshot at terminal state" convention
  /// SupportEscalationCase uses for its own SLA-minute fields. Always null while OPEN; an
  /// in-progress session's "duration so far" is computed at render time from startedAt only, never
  /// stored/ticked.
  durationSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, groupId, status])
  @@index([status, startedAt])
  @@index([completedByTeamMemberId, completedAt])
}

// ---------------------------------------------------------------------------
// Microsoft Teams Integration + Unified Support Analytics — P0 slice, refined for one-click
// customer self-service (see "Microsoft Teams — One-Click Customer Connection & Self-Service UX
// Refinement Master Prompt.md"). Bidirectional Graph API integration (via packages/teams-client, a
// dependency-free OAuth2/Graph REST wrapper over plain fetch) linking developer conversations in
// Microsoft Teams to open customer WhatsApp conversations: a developer's resolution-keyword reply
// in a linked Teams thread automatically notifies the customer over the EXISTING WhatsApp outbound
// queue/notification system (never a second send path). Entirely additive and independent of the
// rule engine, the AI Fallback layer, and Priority-Based Support Escalation — no existing model
// here is modified beyond the two narrow, nullable additions above (InternalTeamMember.
// microsoftEmail, Message.triggeredSupportIssues, WhatsAppAccount/WhatsAppGroup.supportIssues,
// Notification.issueResolutionEvents). Polling-based sync (startTeamsSyncProcessor,
// apps/worker/src/teams/), not real-time webhooks — deferred to a later phase, same as full
// session/duration analytics (call-time tracking, verified-vs-estimated duration) — see
// TEAMS_SETUP.md and PROJECT_REFERENCE.md.
// ---------------------------------------------------------------------------

enum TeamsAccountStatus {
  DISCONNECTED
  CONNECTED
  /// Set only while graphSync.ts is actively running a sync pass against this account — lets the
  /// UI show "Synchronizing your Teams data…" distinctly from the steady-state CONNECTED, without
  /// fabricating a percentage (see graphSync.ts's own doc comment on why no fake progress numbers).
  SYNCING
  /// A sync/refresh attempt failed for a reason NOT specific to token validity (network error,
  /// Graph API unavailable, etc) — see TeamsAccount.lastSyncError for why. The account stays in
  /// this state (not silently reverted to DISCONNECTED) until the next successful sync or an
  /// explicit reconnect.
  ERROR
  /// The refresh token itself was rejected by Microsoft (revoked consent, expired, tenant policy
  /// change) — distinct from ERROR because the ONLY fix is the customer clicking through OAuth
  /// again; retrying the same refresh token will never succeed on its own. See
  /// packages/teams-client's classifyTokenError().
  REAUTH_REQUIRED
}

/// Singleton row (id is always the literal string "global"), same pattern as every other settings/
/// connection-state model in this app (AutomationSettings, AiSettings, etc). Exactly one Microsoft
/// tenant connection is supported in this P0 slice — the dashboard's Teams Integration page shows
/// one connect/disconnect card, not a list, matching the master prompt's own single-account mockup.
/// Tokens are encrypted at rest via the EXISTING encryptSecret/decryptSecret (packages/db/src/
/// index.ts, AI_CREDENTIALS_ENCRYPTION_KEY) — no second encryption mechanism introduced for this.
model TeamsAccount {
  id                     String             @id @default("global")
  tenantId               String?
  externalUserId         String?
  email                  String?
  displayName            String?
  status                 TeamsAccountStatus @default(DISCONNECTED)
  accessTokenCiphertext  String?
  refreshTokenCiphertext String?
  tokenExpiresAt         DateTime?
  scopes                 String[]           @default([])
  lastSyncAt             DateTime?
  lastSyncError          String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

/// One row per Microsoft Team the connected account is a member of — discovered by
/// graphSync.ts's listJoinedTeams() call, upserted on every sync tick (insert-and-catch-P2002 /
/// upsert-by-unique-key, same idempotency shape as WhatsAppGroup's own sync).
model TeamsTeam {
  id             String   @id @default(cuid())
  externalTeamId String   @unique
  name           String
  /// Default true ("discover everything, let the admin narrow it down later" — see the Manage
  /// Teams/Channels page) — an admin can exclude a team (e.g. "Management", "General") from ever
  /// being message-synced without disconnecting the whole integration. graphSync.ts always still
  /// discovers every joined team (cheap, no message bodies) so the management UI has something to
  /// toggle regardless of this flag's current value.
  isEnabledForAutomation Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  channels TeamsChannel[]
}

model TeamsChannel {
  id                String    @id @default(cuid())
  teamId            String
  team              TeamsTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  externalChannelId String
  name              String
  channelType       String?
  /// Same purpose as TeamsTeam.isEnabledForAutomation, at channel granularity — a team can be
  /// enabled overall while an admin still excludes one noisy channel (e.g. "General") from sync.
  /// Message-body sync in graphSync.ts requires both the parent team AND this channel enabled,
  /// OR an open SupportIssue explicitly linked to this exact channel (an Issue link always wins,
  /// so linking a channel to an Issue never silently no-ops because of this coarser toggle).
  isEnabledForAutomation Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  messages      TeamsMessage[]
  supportIssues SupportIssue[]

  @@unique([teamId, externalChannelId])
}

/// One row per synced Teams channel message (top-level or a threaded reply) — mirrors Message's
/// own insert-and-catch-P2002 idempotency pattern via the unique constraint below, so a sync tick
/// that re-fetches an already-known message (e.g. after a resumed delta query) never duplicates it.
model TeamsMessage {
  id                String         @id @default(cuid())
  channelId         String
  channel           TeamsChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  externalMessageId String
  senderExternalId  String
  senderDisplayName String?
  body              String
  /// Root message of the thread this reply belongs to — null for a top-level channel message.
  /// SetNull (not Cascade): a deleted parent must never cascade-delete its already-recorded replies.
  parentMessageId String?
  parentMessage   TeamsMessage?  @relation("TeamsMessageThread", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies         TeamsMessage[] @relation("TeamsMessageThread")
  sentAt          DateTime
  createdAt       DateTime       @default(now())

  resolutionEvents IssueResolutionEvent[]

  @@unique([channelId, externalMessageId])
  @@index([channelId, sentAt])
}

/// Admin-managed resolution keyword/phrase (e.g. "fixed", "resolved", "deployed") — schema shape
/// copied directly from SupportKeyword for consistency; matching reuses packages/engine's existing
/// matchSupportKeyword() as-is (it is a generic text matcher, not Support-Activity-specific).
model TeamsResolutionKeyword {
  id            String                  @id @default(cuid())
  value         String
  matchMode     SupportKeywordMatchMode @default(CONTAINS)
  caseSensitive Boolean                 @default(false)
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  rules TeamsResolutionRuleKeyword[]
}

/// One admin-configured resolution rule — same "global, no accountId" precedent as SupportRule.
/// Unlike SupportRule, there is no group/team-member scoping: a resolution rule applies to every
/// Teams message evaluated against an open, linked SupportIssue (scoping already happens via the
/// Issue's own teamsChannelId/teamsThreadExternalId link).
model TeamsResolutionRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  keywords         TeamsResolutionRuleKeyword[]
  resolutionEvents IssueResolutionEvent[]

  @@index([isActive])
}

model TeamsResolutionRuleKeyword {
  ruleId    String
  rule      TeamsResolutionRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  keywordId String
  keyword   TeamsResolutionKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  createdAt DateTime               @default(now())

  @@id([ruleId, keywordId])
}

/// A support case's lifecycle, per the master prompt's own state model. Deliberately a NEW, minimal
/// model rather than a reuse of SupportEscalationCase — that model is tightly coupled to SLA-timer/
/// tier escalation mechanics (firstAlertMinutes, nextCheckAt, escalationLevel, etc) that have no
/// meaning here; an Issue's lifecycle is driven entirely by Teams-side developer activity, not a
/// timer. RESOLUTION_DETECTED is a transient state between a keyword match firing and the customer
/// notification actually being confirmed queued — most issues pass through it in the same tick.
enum SupportIssueStatus {
  OPEN
  IN_PROGRESS
  WAITING_DEVELOPER
  RESOLUTION_DETECTED
  WAITING_CUSTOMER_CHECK
  RESOLVED
  CLOSED
}

/// Created manually by an admin (linking an existing WhatsApp chat/group to a Teams channel +
/// optional thread) — see apps/web/src/server/actions/issues.ts. Deliberately NOT auto-created
/// from every incoming WhatsApp message: that would require its own detection/keyword system
/// (duplicating Support Activity Tracking's own complexity) for a P0 slice whose actual
/// requirement is linking a conversation an admin has already identified as needing developer
/// help, not guessing which conversations qualify.
model SupportIssue {
  id          String              @id @default(cuid())
  accountId   String
  account     WhatsAppAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId     String
  group       WhatsAppGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  chatId      String
  clientPhone String
  title       String?

  supportExecutiveId String?
  supportExecutive   InternalTeamMember? @relation(fields: [supportExecutiveId], references: [id], onDelete: SetNull)

  status SupportIssueStatus @default(OPEN)

  /// The WhatsApp message that prompted creating this issue — nullable + SetNull so a deleted
  /// message never destroys the issue's own history, same reasoning as every other trigger-message
  /// FK in this schema (SupportEscalationCase.triggerMessageId's stricter Cascade is intentional
  /// there; here the issue is the admin's own record and should outlive the specific message).
  triggerMessageId String?
  triggerMessage   Message? @relation("IssueTriggerMessage", fields: [triggerMessageId], references: [id], onDelete: SetNull)

  /// The Teams side of the link — both nullable because an issue can be created before the Teams
  /// thread exists yet (an admin creates the issue first, then pastes in the thread once a
  /// developer starts one). SetNull so removing a channel from tracking never deletes issue history.
  teamsChannelId        String?
  teamsChannel          TeamsChannel? @relation(fields: [teamsChannelId], references: [id], onDelete: SetNull)
  teamsThreadExternalId String?

  resolvedAt  DateTime?
  closedAt    DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  resolutionEvents IssueResolutionEvent[]

  @@index([status])
  @@index([accountId, chatId])
  @@index([teamsChannelId, teamsThreadExternalId])
  @@index([supportExecutiveId])
}

/// Distinguishes how resolutionEngine.ts handled a candidate Teams message match — an audit trail
/// covering both the success path and every safety-check skip (section 18's explicit requirement:
/// never silently fail to notify without a recorded reason).
enum IssueResolutionOutcome {
  NOTIFIED
  SKIPPED_ALREADY_RESOLVED
  SKIPPED_NO_PHONE_MAPPING
  SKIPPED_NOTIFICATIONS_DISABLED
  SKIPPED_MANUALLY_IGNORED
  /// resolveWhatsAppAccount() returned an error (no Primary/configured account connected) — the
  /// same account-unavailable condition every other WhatsApp-sending feature can hit, surfaced
  /// here instead of silently dropping the resolution.
  SKIPPED_ACCOUNT_UNAVAILABLE
}

/// The resolution-detection audit trail AND the duplicate-notification guard in one table — exact
/// same pattern as SupportEscalationEvent's own doc comment: the unique constraint below makes it
/// structurally impossible for a re-synced or re-evaluated Teams message to notify the same issue's
/// customer twice. resolutionEngine.ts always tries to INSERT this row before ever enqueueing a
/// send, and treats a unique-constraint failure as "already handled, skip." Links to OutboundMessage
/// (not Notification) because the actual action taken is a customer-facing WhatsApp send through
/// the EXISTING outbound queue — the same "one outbound mechanism" every other feature uses — not
/// an internal admin alert (which is what the Notification model is for).
model IssueResolutionEvent {
  id                String                  @id @default(cuid())
  issueId           String
  issue             SupportIssue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  teamsMessageId     String
  teamsMessage       TeamsMessage            @relation(fields: [teamsMessageId], references: [id], onDelete: Cascade)
  matchedRuleId      String?
  matchedRule        TeamsResolutionRule?    @relation(fields: [matchedRuleId], references: [id], onDelete: SetNull)
  matchedKeyword     String?
  outcome            IssueResolutionOutcome
  outboundMessageId  String?                 @unique
  outboundMessage    OutboundMessage?        @relation(fields: [outboundMessageId], references: [id], onDelete: SetNull)
  detectedAt         DateTime                @default(now())

  @@unique([issueId, teamsMessageId])
  @@index([issueId])
}

/// Singleton row (id is always the literal string "global"). enableCustomerNotification defaults
/// false — same conservative-default convention as every automation toggle in this app
/// (ENGINEERING_STANDARDS.md's anti-spam philosophy: an admin must explicitly opt in before the
/// system ever sends a WhatsApp message to a real customer on Teams-side developer activity alone).
model TeamsIntegrationSettings {
  id                         String   @id @default("global")
  enableResolutionDetection  Boolean  @default(true)
  enableCustomerNotification Boolean  @default(false)
  notificationTemplate       String   @default("Hi {{customerName}}, your issue has been resolved by our support team. Thank you for your patience!")
  pollingIntervalMinutes     Int      @default(3)
  updatedAt                  DateTime @updatedAt
}
