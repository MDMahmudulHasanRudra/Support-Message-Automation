// Full Phase 2 schema. See ARCHITECTURE.md section 4 for the design
// rationale (unified AutomationRule, DB-mediated WorkerCommand channel,
// atomic outbound queue claiming, etc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — kept in sync by convention with packages/shared/src/enums.ts
// ---------------------------------------------------------------------------

enum MessageDirection {
  INCOMING
  OUTGOING
  SYSTEM
}

enum ProcessingStatus {
  PENDING
  PROCESSED
  IGNORED
  FAILED
}

enum RuleStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum RuleType {
  TEAM_FILTER
  DEFAULT_IGNORE
  LAST_SENDER
  EXCEPTION
  SUPPORT_ESCALATION
  AUTO_REPLY
  GENERIC
}

enum MatchType {
  EXACT
  CONTAINS
  KEYWORDS
  REGEX
  ALWAYS
}

enum ActionType {
  IGNORE
  TAG
  AUTO_REPLY
  SUPPORT_REQUIRED
  NOTIFY_TEAMS
  NOTIFY_WHATSAPP
  FORWARD
  STOP_PROCESSING
  /// Manual custom send to a WhatsApp group via the Group Message Sender —
  /// never produced by the rule engine, only by a human-confirmed broadcast job.
  GROUP_BROADCAST
  /// A human typing a reply in the WhatsApp Chat inbox. Never produced by the rule
  /// engine or by AI — only by an authenticated dashboard user pressing send. Still
  /// travels the one outbound queue like every other send, but the queue treats it
  /// differently: the automation kill switch does not cancel it (the switch stops the
  /// robot, not the operator), and hitting an account rate limit defers it rather than
  /// discarding it, so a person's message is never silently dropped.
  MANUAL_REPLY
}

enum OutboundMessageStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
  RATE_LIMITED
  /// Group Message Sender only: queued item deliberately not sent (e.g. group
  /// membership could not be verified, or it was skipped for duplicate-send
  /// protection) — distinct from FAILED, which implies a send was attempted.
  SKIPPED
}

/// Group Message Sender job lifecycle: QUEUED -> RUNNING (first item starts
/// processing) -> COMPLETED (no items left PENDING/PROCESSING), or QUEUED/
/// RUNNING -> CANCELLED (explicit stop) / STOPPED_KILL_SWITCH (automation
/// paused mid-job) — both terminal and never overwritten by the normal
/// COMPLETED transition.
enum GroupBroadcastJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  STOPPED_KILL_SWITCH
}

enum GroupBroadcastSource {
  MANUAL
  EXCEL
  MIXED
}

/// Add-to-Groups job lifecycle — mirrors GroupBroadcastJobStatus (see its
/// doc comment): QUEUED -> RUNNING -> COMPLETED, or a sticky CANCELLED /
/// STOPPED_KILL_SWITCH short-circuit.
enum GroupParticipantAddJobStatus {
  /// Reading each group's roster to work out who is genuinely missing. Nothing is added in this
  /// phase — it exists so an operator sees the answer before spending a single WhatsApp operation.
  CHECKING
  /// The check finished and the job is waiting for a person to choose what to add. A job can sit
  /// here indefinitely; it holds no queue slot and costs nothing.
  AWAITING_REVIEW
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  STOPPED_KILL_SWITCH
}

/// The lifecycle of one (number, group) pair.
///
/// The first block is the CHECK phase, which is new: every item used to be claimable work the
/// moment it existed, so the only way to discover somebody was already in a group was to attempt
/// the add and be told. Adding a participant is the strongest ban signal WhatsApp reacts to, so
/// "find out by trying" is the one approach this feature cannot take.
enum GroupParticipantAddItemStatus {
  /// Waiting for its group's roster to be read.
  PENDING_CHECK
  /// The roster read is in flight.
  CHECKING
  /// Not in the group, reachable, and this account may add to it — safe to offer.
  READY
  /// Absence could not be PROVEN. The roster came back carrying LIDs, which are opaque ids
  /// deliberately unrelated to a phone number, so "no match" cannot be read as "not a member".
  /// Offered, but never silently as READY: the difference is a wasted add on somebody already
  /// there, which is exactly the operation this phase exists to avoid.
  CANNOT_VERIFY
  /// Already a participant, established before anything was attempted.
  ALREADY_MEMBER
  /// Not a usable phone number at all (wrong length, or nothing but punctuation).
  INVALID_NUMBER
  /// WhatsApp says no account exists for this number.
  NOT_ON_WHATSAPP
  /// This account is not an admin of that group, so WhatsApp will refuse every add to it.
  NO_PERMISSION
  /// The group is gone, left, or no longer readable.
  GROUP_UNAVAILABLE
  /// The check itself failed. Distinct from every result above: nothing was learned, so a recheck
  /// is the right response rather than a decision.
  CHECK_FAILED
  /// Eligible, and the operator chose not to include it. Kept rather than deleted so a job stays a
  /// complete record of what was considered.
  NOT_SELECTED

  PENDING
  PROCESSING
  ADDED
  FAILED
  /// Job was stopped (by a user or the kill switch) before this item's turn came up.
  CANCELLED
  /// This number was already in the group, so no add was attempted. Distinct from ADDED because
  /// nothing changed, and distinct from FAILED because nothing went wrong — an operator re-running
  /// a roster across every group needs to see which of the two happened.
  SKIPPED_ALREADY_MEMBER
}

/// Support tier for Priority-Based Support Monitoring & Escalation. Null on WhatsAppGroup means
/// no tier assigned — the feature never triggers (opt-in per group).
enum SupportPriority {
  P1
  P2
  P3
}

/// A support escalation case's lifecycle. `status` records what the case is CURRENTLY waiting
/// on; the full historical sequence (including which tier actually fired, to whom, when) lives
/// in SupportEscalationEvent — this column is deliberately not a strict re-statement of every
/// diagram box in the spec, just "where is this case stuck right now."
enum EscalationStatus {
  NEW
  MONITORING
  WAITING_FOR_HUMAN
  SECOND_ALERT
  MEMBER_ESCALATED
  ADMIN_ESCALATED
  FOLLOW_UP
  HUMAN_REPLIED
  RESOLVED
  PAUSED
  CANCELLED
}

enum EscalationEventType {
  FIRST_NOTIFICATION
  SECOND_NOTIFICATION
  MEMBER_NOTIFICATION
  ADMIN_NOTIFICATION
  FOLLOW_UP
  HUMAN_REPLIED
  RESOLVED
  PAUSED
  RESUMED
  MANUAL_ESCALATE
  REASSIGNED
  RESET
}

enum EscalationRecipientType {
  GROUP
  MEMBER
  ADMIN
  SYSTEM
}

/// The CHANNEL a notification goes out on. Distinct from NotificationEvent, which is why it was
/// sent — the two were conflated before the Notification Center existed, so nothing recorded the
/// reason and per-event routing, muting or reporting were all impossible.
enum NotificationType {
  TEAMS
  WHATSAPP
}

/// Why a notification was sent. Derived from the places in the worker that actually raise one,
/// not invented — see apps/web/src/app/(dashboard)/notifications/events.
enum NotificationEvent {
  /// A rule with a NOTIFY_TEAMS action matched.
  RULE_NOTIFY_TEAMS
  /// A rule with a NOTIFY_WHATSAPP action matched.
  RULE_NOTIFY_WHATSAPP
  /// The AI could not answer a customer and handed the conversation to a person.
  AI_HUMAN_FALLBACK
  /// Pattern detection found a recurring question nothing handles yet.
  UNKNOWN_PATTERN
  /// A priority support case crossed an SLA tier.
  SUPPORT_ESCALATION
  /// The system itself has stopped working: a WhatsApp session that should be collecting messages
  /// is not, or is stuck in a state only a person can clear.
  ///
  /// The only member that is not about a conversation, and the reason the 18 Sep 2026 outage ran
  /// for three hours unnoticed — every other event here describes something a customer said, so
  /// there was no vocabulary for "nothing a customer says is reaching us at all".
  COLLECTION_BROKEN
  /// Mood Detection found a customer angry, very angry, frustrated or urgent enough to act on
  /// (MOOD_DETECTION.md). One per escalation, inside the configured cooldown.
  MOOD_ALERT
}

/// One team member's opt-in to be alerted directly about one kind of event.
///
/// The Notification Center's per-event settings decide whether an alert is raised and which shared
/// groups it goes to. This decides who additionally gets it as a direct message — the difference
/// between "the escalations group was told" and "the person on call was told".
///
/// Opt-in per member per event rather than a single "notify me" switch: the whole point is that
/// somebody wants escalations at 2am and does not want unknown-pattern suggestions ever.
model TeamMemberNotificationPreference {
  teamMemberId String
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId    String             @default(dbgenerated("project_id_required()"))
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  teamMember   InternalTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  event        NotificationEvent

  createdAt DateTime @default(now())

  @@id([teamMemberId, event])
  @@index([event])
}

/// Per-event delivery settings — the Notification Center's unit of configuration.
///
/// Rows are created lazily on first use, so a deployment that has never opened the page behaves
/// exactly as it did before: `enabled` defaults true and the destination overrides are null,
/// which means "use the global destinations", which is the old behaviour exactly.
/// A customised notification message. Rows exist ONLY for templates somebody edited — the default
/// wording lives in packages/shared/src/notificationTemplates.ts, so a fresh install works with
/// nothing here, an unedited template keeps tracking improvements shipped later, and "reset to
/// default" is a delete rather than a copy of whatever the default was that day.
///
/// `key` is a plain string rather than an enum on purpose: the catalogue is defined in code and
/// validated against it, so adding a template is a code change with no migration attached.
model NotificationTemplate {
  key       String
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String  @default(dbgenerated("project_id_required()"))
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  /// The custom wording, with {{placeholder}} variables. Validated against the key's declared
  /// variables before it is written — an unknown placeholder is refused at save time rather than
  /// discovered in front of a customer.
  body String

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@id([projectId, key])
}

model NotificationEventSetting {
  event     NotificationEvent
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String            @default(dbgenerated("project_id_required()"))
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)

  /// Off means the event raises nothing at all. The point of the module: a team drowning in
  /// unknown-pattern alerts can silence that one without losing escalation alerts.
  enabled Boolean @default(true)

  /// Per-channel switches. Both default on, matching the previous behaviour where an event went
  /// wherever the global settings pointed.
  sendToTeams    Boolean @default(true)
  sendToWhatsApp Boolean @default(true)

  /// WhatsApp groups for THIS event. Empty means fall back to
  /// AutomationSettings.whatsappNotificationGroupIds, so routing is opt-in per event rather than
  /// something every deployment has to configure before notifications work at all.
  whatsappGroupIds String[] @default([])

  updatedAt DateTime @updatedAt

  @@id([projectId, event])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum WorkerCommandType {
  RECONNECT
  SEND_LIVE_TEST
  RESYNC_GROUPS
  /// On-demand, single-group participant count lookup (payload: { groupId }) — deliberately NOT
  /// part of the bulk RESYNC_GROUPS path, which only fetches group names for cost reasons.
  GET_GROUP_PARTICIPANT_COUNT
  /// Ends the current WhatsApp session and invalidates its persisted session data so a different
  /// account can scan a fresh QR — distinct from RECONNECT, which reuses the existing session.
  LOGOUT
  /// Dashboard "Run AI analysis now" button (Conversation Learning) — runs
  /// processOneAiAnalysisBatch() immediately instead of waiting for its own long scheduled
  /// interval. No accountId/payload needed; the job scans PatternCandidate rows globally.
  AI_ANALYSIS_BATCH
  /// RETIRED with the Microsoft Teams Integration module (27 Sep 2026). Nothing issues it any more;
  /// kept only because old WorkerCommand rows may still hold it, and Prisma throws on reading a row
  /// whose enum value the schema no longer lists.
  TEAMS_SYNC_NOW
  /// Forge's "Sync now" button — re-reads the ISPDIGITAL repository immediately instead of waiting
  /// for startForgeKnowledgeProcessor's six-hour interval. Account-agnostic like AI_ANALYSIS_BATCH:
  /// it talks to Forge and the knowledge base, never to a WhatsApp session.
  FORGE_SYNC_NOW
  /// The Communication Style page's "Rebuild now" — reads the team's own replies and re-derives
  /// the style profile immediately instead of waiting for the twelve-hour loop. Account-agnostic
  /// like the other three: it reads stored messages and writes one settings row.
  BUILD_COMMUNICATION_STYLE
  /// "Add from a group" on Internal Team Members (payload: { groupId }) — asks WhatsApp who is
  /// actually in a group, so colleagues can be added by ticking real names instead of typing
  /// numbers. Distinct from reading Message history, which only knows people who have already
  /// spoken; a quiet group, or one being set up before any traffic, has nobody there.
  GET_GROUP_PARTICIPANTS
  /// The dashboard's "Build knowledge now" button (payload: { groupId }) — reads one group's
  /// stored conversation and distils it into knowledge entries immediately, instead of waiting
  /// for that group's turn in startGroupKnowledgeProcessor's hourly rotation. Reads the Message
  /// table only; needs no WhatsApp session, same as the two above.
  BUILD_GROUP_KNOWLEDGE
  /// React to an existing message with one emoji (payload: { whatsappMessageId, emoji }) — a live
  /// browser action, so it is a WorkerCommand like everything else in this enum rather than a queue
  /// row: there is no send to retry or rate-limit, only a call to make and a result to report.
  REACT_TO_MESSAGE
  /// Edit the text of a message this account already sent (payload: { whatsappMessageId, newBody
  /// }). Marked experimental by the underlying library — most accounts do not have this feature —
  /// so a reported failure here is the ordinary outcome on many accounts, not evidence of a bug.
  EDIT_MESSAGE
  /// Create a new WhatsApp group (payload: { groupName, contactPhoneNumbers }). The created group
  /// is not written into WhatsAppGroup by this command; the next RESYNC_GROUPS or scheduled sync
  /// discovers and upserts it like any other newly-seen group, at its default (unmonitored) flags.
  CREATE_GROUP
  /// Join a group via its invite link (payload: { inviteLink }). Same non-write behaviour as
  /// CREATE_GROUP — the joined group is picked up by the next sync, not written here.
  JOIN_GROUP
  /// Update this account's own WhatsApp profile — display name, About text and/or photo (payload:
  /// { displayName?, about?, pictureDataUrl? }). A partial update: a field left out of the payload
  /// is left untouched on WhatsApp.
  UPDATE_PROFILE
}

enum WorkerCommandStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum AutomationMode {
  MANUAL_ONLY
  SAFE_AUTO_REPLY
  FULL_RULE_AUTOMATION
}

enum TeamMemberStatus {
  ACTIVE
  INACTIVE
}

enum TeamStatus {
  ACTIVE
  DISABLED
}

/// Every state a WhatsApp account can actually be in — and nothing else.
///
/// `OUTBOUND_PAUSED` and `RATE_LIMITED` used to be members here, written by nothing anywhere in
/// the codebase and yet rendered on the Accounts page as real states with their own colours and
/// hint text ("Receiving, but not sending", "Holding back sends to protect the number"). They
/// described a per-account throttling mechanism that does not exist: throttling is per OUTBOUND
/// MESSAGE, which is what `OutboundMessageStatus.RATE_LIMITED` is for, and that one is real.
///
/// A vocabulary that can describe states the system cannot reach is worse than a smaller one. It
/// invites a reader to diagnose against a mechanism that was never built, and it made the account
/// status enum an unreliable guide to what the account statuses are.
/// An account's group-list sync (GROUP_SYNC.md).
enum GroupSyncStatus {
  RUNNING
  COMPLETED
  /// Finished, but some groups were not saved or the list was judged incomplete.
  PARTIAL
  FAILED
  /// Stopped on purpose by a Logout or Reconnect of the account — not a failure. A Reconnect
  /// starts a new sync once connected.
  CANCELLED
}

enum WhatsAppAccountStatus {
  CONNECTED
  DISCONNECTED
  RECONNECTING
  AUTHENTICATION_REQUIRED
  SESSION_ERROR
  ERROR
}

/// The two ways WhatsApp itself offers to link a device, both of which `@open-wa/wa-automate`
/// supports. They are mutually exclusive per connection attempt, not a fallback chain: the
/// library's initializer races EITHER its QR watcher OR its link-code call, never both.
enum WhatsAppPairingMethod {
  /// Show a QR code for the phone's camera. The library refreshes it on its own until it is
  /// scanned, which is why this stays the default.
  QR_CODE

  /// Ask WhatsApp for a nine-character code the operator types into Linked devices on the phone.
  /// Useful when nobody can hold a phone up to the screen — a remote server, a number in another
  /// office, an operator working from a screen reader.
  ///
  /// One real constraint, and the UI has to say it out loud: the library requests this code ONCE
  /// per connection attempt and never refreshes it, unlike the QR. When WhatsApp expires the code,
  /// a new connection attempt is the only way to get another.
  PHONE_CODE
}

/// Real, currently-existing WhatsApp-sending services that can be routed to a specific account
/// instead of Primary. Deliberately a closed enum, not a free string — a typo can't create a
/// silently-dead route. Extend this (plus a migration) the day a new routable service ships;
/// do not add speculative entries for features that don't exist yet.
enum WhatsAppServiceKey {
  /// The rule engine's NOTIFY_WHATSAPP action (alerts a support group when a rule matches).
  NOTIFY_WHATSAPP
  /// Priority-Based Support Monitoring & Escalation's group alerts + member/admin DMs.
  PRIORITY_SUPPORT
  /// Conversation Learning's Unknown Pattern alerts (patternDetectionJob.ts) — a distinct routing
  /// key so an admin can send these to a different account than ordinary rule-matched alerts.
  CONVERSATION_LEARNING
  /// RETIRED with the Microsoft Teams Integration module (27 Sep 2026). No sender uses it; kept only
  /// because existing routing rows may still name it, and Prisma throws on an unknown enum value.
  TEAMS_RESOLUTION_NOTIFY
}

enum WhatsAppFallbackPolicy {
  /// Configured account unavailable -> use Primary instead.
  PRIMARY_FALLBACK
  /// Configured account unavailable -> return a clear error, never silently switch accounts.
  STRICT_NO_FALLBACK
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

