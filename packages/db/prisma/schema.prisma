// Full Phase 2 schema. See ARCHITECTURE.md section 4 for the design
// rationale (unified AutomationRule, DB-mediated WorkerCommand channel,
// atomic outbound queue claiming, etc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — kept in sync by convention with packages/shared/src/enums.ts
// ---------------------------------------------------------------------------

enum MessageDirection {
  INCOMING
  OUTGOING
  SYSTEM
}

enum ProcessingStatus {
  PENDING
  PROCESSED
  IGNORED
  FAILED
}

enum RuleStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum RuleType {
  TEAM_FILTER
  DEFAULT_IGNORE
  LAST_SENDER
  EXCEPTION
  SUPPORT_ESCALATION
  AUTO_REPLY
  GENERIC
}

enum MatchType {
  EXACT
  CONTAINS
  KEYWORDS
  REGEX
  ALWAYS
}

enum ActionType {
  IGNORE
  TAG
  AUTO_REPLY
  SUPPORT_REQUIRED
  NOTIFY_TEAMS
  NOTIFY_WHATSAPP
  FORWARD
  STOP_PROCESSING
  /// Manual custom send to a WhatsApp group via the Group Message Sender —
  /// never produced by the rule engine, only by a human-confirmed broadcast job.
  GROUP_BROADCAST
}

enum OutboundMessageStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
  RATE_LIMITED
  /// Group Message Sender only: queued item deliberately not sent (e.g. group
  /// membership could not be verified, or it was skipped for duplicate-send
  /// protection) — distinct from FAILED, which implies a send was attempted.
  SKIPPED
}

/// Group Message Sender job lifecycle: QUEUED -> RUNNING (first item starts
/// processing) -> COMPLETED (no items left PENDING/PROCESSING), or QUEUED/
/// RUNNING -> CANCELLED (explicit stop) / STOPPED_KILL_SWITCH (automation
/// paused mid-job) — both terminal and never overwritten by the normal
/// COMPLETED transition.
enum GroupBroadcastJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  STOPPED_KILL_SWITCH
}

enum GroupBroadcastSource {
  MANUAL
  EXCEL
  MIXED
}

/// Add-to-Groups job lifecycle — mirrors GroupBroadcastJobStatus (see its
/// doc comment): QUEUED -> RUNNING -> COMPLETED, or a sticky CANCELLED /
/// STOPPED_KILL_SWITCH short-circuit.
enum GroupParticipantAddJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  STOPPED_KILL_SWITCH
}

enum GroupParticipantAddItemStatus {
  PENDING
  PROCESSING
  ADDED
  FAILED
  /// Job was stopped (by a user or the kill switch) before this item's turn came up.
  CANCELLED
}

/// Support tier for Priority-Based Support Monitoring & Escalation. Null on WhatsAppGroup means
/// no tier assigned — the feature never triggers (opt-in per group).
enum SupportPriority {
  P1
  P2
  P3
}

/// A support escalation case's lifecycle. `status` records what the case is CURRENTLY waiting
/// on; the full historical sequence (including which tier actually fired, to whom, when) lives
/// in SupportEscalationEvent — this column is deliberately not a strict re-statement of every
/// diagram box in the spec, just "where is this case stuck right now."
enum EscalationStatus {
  NEW
  MONITORING
  WAITING_FOR_HUMAN
  SECOND_ALERT
  MEMBER_ESCALATED
  ADMIN_ESCALATED
  FOLLOW_UP
  HUMAN_REPLIED
  RESOLVED
  PAUSED
  CANCELLED
}

enum EscalationEventType {
  FIRST_NOTIFICATION
  SECOND_NOTIFICATION
  MEMBER_NOTIFICATION
  ADMIN_NOTIFICATION
  FOLLOW_UP
  HUMAN_REPLIED
  RESOLVED
  PAUSED
  RESUMED
  MANUAL_ESCALATE
  REASSIGNED
  RESET
}

enum EscalationRecipientType {
  GROUP
  MEMBER
  ADMIN
  SYSTEM
}

enum NotificationType {
  TEAMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum WorkerCommandType {
  GET_QR
  RECONNECT
  SEND_LIVE_TEST
  RESYNC_GROUPS
  /// On-demand, single-group participant count lookup (payload: { groupId }) — deliberately NOT
  /// part of the bulk RESYNC_GROUPS path, which only fetches group names for cost reasons.
  GET_GROUP_PARTICIPANT_COUNT
  /// Ends the current WhatsApp session and invalidates its persisted session data so a different
  /// account can scan a fresh QR — distinct from RECONNECT, which reuses the existing session.
  LOGOUT
  /// Dashboard "Run AI analysis now" button (Conversation Learning) — runs
  /// processOneAiAnalysisBatch() immediately instead of waiting for its own long scheduled
  /// interval. No accountId/payload needed; the job scans PatternCandidate rows globally.
  AI_ANALYSIS_BATCH
}

enum WorkerCommandStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum AutomationMode {
  MANUAL_ONLY
  SAFE_AUTO_REPLY
  FULL_RULE_AUTOMATION
}

enum TeamMemberStatus {
  ACTIVE
  INACTIVE
}

enum WhatsAppAccountStatus {
  CONNECTED
  DISCONNECTED
  RECONNECTING
  AUTHENTICATION_REQUIRED
  SESSION_ERROR
  OUTBOUND_PAUSED
  RATE_LIMITED
  ERROR
}

/// Real, currently-existing WhatsApp-sending services that can be routed to a specific account
/// instead of Primary. Deliberately a closed enum, not a free string — a typo can't create a
/// silently-dead route. Extend this (plus a migration) the day a new routable service ships;
/// do not add speculative entries for features that don't exist yet.
enum WhatsAppServiceKey {
  /// The rule engine's NOTIFY_WHATSAPP action (alerts a support group when a rule matches).
  NOTIFY_WHATSAPP
  /// Priority-Based Support Monitoring & Escalation's group alerts + member/admin DMs.
  PRIORITY_SUPPORT
  /// Conversation Learning's Unknown Pattern alerts (patternDetectionJob.ts) — a distinct routing
  /// key so an admin can send these to a different account than ordinary rule-matched alerts.
  CONVERSATION_LEARNING
}

enum WhatsAppFallbackPolicy {
  /// Configured account unavailable -> use Primary instead.
  PRIMARY_FALLBACK
  /// Configured account unavailable -> return a clear error, never silently switch accounts.
  STRICT_NO_FALLBACK
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdRules               AutomationRule[]
  createdBroadcastJobs       GroupBroadcastJob[]
  createdOutboundSends       OutboundMessage[]
  createdParticipantAddJobs  GroupParticipantAddJob[]
  createdKnowledgeItems      AiKnowledgeItem[]
  createdKnowledgeVersions   AiKnowledgeVersion[]
  resolvedEscalationCases    SupportEscalationCase[]
  triggeredEscalationEvents  SupportEscalationEvent[]
  triggeredLearningBatchJobs LearningBatchJob[]
  reviewedPatternCandidates  PatternCandidate[]
  reviewedRuleProposals      RuleProposal[]
}

model WhatsAppAccount {
  id              String                @id @default(cuid())
  label           String
  phoneNumber     String?
  status          WhatsAppAccountStatus @default(DISCONNECTED)
  qrCode          String? // data URL, written by the worker, polled by the dashboard
  qrUpdatedAt     DateTime?
  lastConnectedAt DateTime?
  lastHeartbeatAt DateTime?
  sessionDataPath String?
  /// OpenWA's own session identifier — distinct from `id` because it doubles as part of the
  /// on-disk Chromium profile path (`${sessionDataPath}/_IGNORE_${sessionId}`, see
  /// OpenWAProvider.clearStaleChromiumLock()). The pre-existing account keeps its historical
  /// value (from WHATSAPP_SESSION_NAME) so its already-authenticated session is never orphaned;
  /// new accounts get a fresh one at creation time.
  sessionId       String?
  /// Exactly one account may be true at a time — enforced by a partial unique index added by
  /// hand to this field's migration (`CREATE UNIQUE INDEX ... WHERE "isPrimary" = true`), not
  /// expressible in the Prisma schema DSL directly. See also the transactional service-layer
  /// guard in setPrimaryAccount() (apps/web/src/server/actions/accounts.ts).
  isPrimary       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  groups               WhatsAppGroup[]
  messages             Message[]
  outboundMessages     OutboundMessage[]
  broadcastJobs        GroupBroadcastJob[]
  participantAddJobs   GroupParticipantAddJob[]
  processingCheckpoint ProcessingCheckpoint?
  escalationCases      SupportEscalationCase[]
  workerCommands       WorkerCommand[]
  notifications        Notification[]
  serviceRoutes        WhatsAppServiceRoute[]
  conversationSessions ConversationSession[]
  supportActivities    SupportActivity[]
}

/// One row per WhatsAppServiceKey (seeded lazily, like every other settings model in this app —
/// see resolveWhatsAppAccount() in packages/db/src/whatsappRouting.ts). accountId null means
/// "use Primary" — the default, and the only state that exists until an admin explicitly picks
/// a specific account for a service.
model WhatsAppServiceRoute {
  serviceKey     WhatsAppServiceKey     @id
  accountId      String?
  account        WhatsAppAccount?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fallbackPolicy WhatsAppFallbackPolicy @default(PRIMARY_FALLBACK)
  enabled        Boolean                @default(true)
  updatedAt      DateTime               @updatedAt
}

model WhatsAppGroup {
  id                          String              @id @default(cuid())
  accountId                   String
  account                     WhatsAppAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  whatsappGroupId             String // WhatsApp chat id, e.g. "1234567890-1234567890@g.us"
  name                        String
  isMonitored                 Boolean             @default(false)
  /// False once a resync's getAllGroups() no longer returns this group (account left/removed) —
  /// soft-deactivation only, never deleted, so Message history keeps a valid groupId FK.
  isActive                    Boolean             @default(true)
  /// Best-effort, fetched on demand (never during bulk sync — too expensive across hundreds of
  /// real groups) — null until an admin explicitly requests it for this group.
  participantCount            Int?
  lastSyncedAt                DateTime?
  /// Null = no priority tier assigned — Priority-Based Support Monitoring never triggers for this
  /// group (matches today's exact behavior; the feature is entirely opt-in per group).
  priority                    SupportPriority?
  assignedTeamMemberId        String?
  assignedTeamMember          InternalTeamMember? @relation(fields: [assignedTeamMemberId], references: [id], onDelete: SetNull)
  /// Independent kill switch from `priority` itself — lets an admin keep the priority tier
  /// assigned but temporarily pause escalation for this one group without clearing it.
  escalationMonitoringEnabled Boolean             @default(true)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  messages             Message[]
  broadcastMessages    OutboundMessage[]
  participantAddItems  GroupParticipantAddItem[]
  escalationCases      SupportEscalationCase[]
  conversationSessions ConversationSession[]
  supportActivities    SupportActivity[]
  supportRuleScopes    SupportRuleGroup[]

  @@unique([accountId, whatsappGroupId])
  @@index([accountId, isActive])
  @@index([accountId, isMonitored])
}

model InternalTeamMember {
  id          String           @id @default(cuid())
  name        String
  phoneNumber String           @unique
  role        String
  department  String?
  status      TeamMemberStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assignedGroups            WhatsAppGroup[]
  assignedEscalationCases   SupportEscalationCase[]
  SupportEscalationSettings SupportEscalationSettings[]
  supportActivities         SupportActivity[]
  supportRuleScopes         SupportRuleTeamMember[]
}

model Message {
  id                String           @id @default(cuid())
  accountId         String
  account           WhatsAppAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId           String?
  group             WhatsAppGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  whatsappMessageId String
  chatId            String
  senderPhone       String
  senderName        String?
  isFromTeamMember  Boolean          @default(false)
  direction         MessageDirection
  body              String
  normalizedBody    String
  timestampWa       DateTime
  receivedAt        DateTime         @default(now())
  isDuplicate       Boolean          @default(false)
  processingStatus  ProcessingStatus @default(PENDING)
  createdAt         DateTime         @default(now())

  /// Set by the (separate, off-by-default) Conversation Learning segmentation job — never written
  /// by the message pipeline itself. Null for every message until that job processes it, and for
  /// every message ever if LearningSettings.conversationLearningEnabled stays false.
  conversationSessionId String?
  conversationSession   ConversationSession? @relation(fields: [conversationSessionId], references: [id], onDelete: SetNull)

  /// Resolved from the WhatsApp "quoted message" (swipe-to-reply) reference, only when the quoted
  /// message is itself already tracked in this table — null if the reply quotes a message from
  /// before this account was tracked, or if the message isn't a reply at all. Powers Support
  /// Activity Tracking's REPLY_TO_CUSTOMER trigger type. SetNull (not Cascade) so deleting the
  /// quoted message never deletes the message that quoted it.
  quotedMessageId  String?
  quotedMessage    Message?  @relation("MessageQuote", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotedByMessages Message[] @relation("MessageQuote")
  /// Digits-only phone numbers @-mentioned in this message (from WhatsApp's mentionedJidList).
  /// Powers Support Activity Tracking's MENTION trigger type.
  mentionedPhones  String[]  @default([])

  executions               AutomationExecution[]
  outboundReplies          OutboundMessage[]
  notifications            Notification[]
  triggeredEscalationCases SupportEscalationCase[]    @relation("EscalationTriggerMessage")
  patternCandidateEvidence PatternCandidateEvidence[]
  supportActivity          SupportActivity?

  @@unique([accountId, whatsappMessageId])
  @@index([chatId, timestampWa])
  @@index([groupId, timestampWa])
  @@index([processingStatus])
  @@index([conversationSessionId])
  @@index([quotedMessageId])
  @@index([senderPhone])
}

model AutomationRule {
  id              String     @id @default(cuid())
  name            String
  description     String?
  type            RuleType
  matchType       MatchType
  matchValue      String? // exact/contains/regex pattern; unused for KEYWORDS/ALWAYS
  keywords        String[]   @default([]) // used when matchType = KEYWORDS
  conditions      Json       @default("{}") // RuleConditions (packages/shared)
  actions         Json       @default("[]") // RuleAction[] (packages/shared)
  priority        Int        @default(0)
  status          RuleStatus @default(DRAFT)
  cooldownSeconds Int?
  replyMessage    String?
  replyDelayMinMs Int?
  replyDelayMaxMs Int?
  executionCount  Int        @default(0)
  lastExecutedAt  DateTime?
  createdById     String?
  createdBy       User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  executions       AutomationExecution[]
  outboundMessages OutboundMessage[]
  notifications    Notification[]
  ruleProposal     RuleProposal?

  @@index([status, priority])
}

model AutomationExecution {
  id              String          @id @default(cuid())
  messageId       String
  message         Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  ruleId          String?
  rule            AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  matchedAt       DateTime        @default(now())
  actionsExecuted Json // ActionType[] actually executed (post-idempotency-check)
  decision        String // final pipeline decision, e.g. "IGNORE" | "AUTO_REPLY" | "SUPPORT_REQUIRED" | "NO_MATCH"
  reasonTrace     Json // explainable trace: rules evaluated, matched, skipped, why
  idempotencyKey  String          @unique
  createdAt       DateTime        @default(now())

  @@index([messageId])
  @@index([ruleId])
}

model OutboundMessage {
  id               String                @id @default(cuid())
  accountId        String
  account          WhatsAppAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId           String
  toPhone          String
  body             String
  relatedMessageId String?
  relatedMessage   Message?              @relation(fields: [relatedMessageId], references: [id], onDelete: SetNull)
  ruleId           String?
  rule             AutomationRule?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  actionType       ActionType
  idempotencyKey   String                @unique
  status           OutboundMessageStatus @default(PENDING)
  scheduledAt      DateTime              @default(now())
  attemptCount     Int                   @default(0)
  lastAttemptAt    DateTime?
  sentAt           DateTime?
  failureReason    String?
  delayMs          Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  /// Group Message Sender only (actionType = GROUP_BROADCAST) — every field
  /// below is null for automation-generated rows.
  groupId           String?
  group             WhatsAppGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Group name at send time, independent of the group later being renamed/removed.
  groupNameSnapshot String?
  broadcastJobId    String?
  broadcastJob      GroupBroadcastJob? @relation(fields: [broadcastJobId], references: [id], onDelete: SetNull)
  providerMessageId String?
  createdById       String?
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([toPhone, sentAt])
  @@index([sentAt])
  @@index([broadcastJobId, status])
  @@index([groupId, status])
  @@index([relatedMessageId])
}

/// One row per "send this message to these groups" batch created through the
/// Group Message Sender. Each target group becomes its own OutboundMessage
/// row (actionType = GROUP_BROADCAST) reusing the existing outbound queue —
/// this row is only the batch header: who requested it, the safety
/// configuration it was queued under, and its own stop/kill-switch state.
model GroupBroadcastJob {
  id                  String                  @id @default(cuid())
  accountId           String
  account             WhatsAppAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdById         String?
  createdBy           User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  source              GroupBroadcastSource
  /// Fallback message used for any target group that didn't supply its own
  /// per-row message (e.g. from the Excel "Message" column).
  defaultMessage      String
  status              GroupBroadcastJobStatus @default(QUEUED)
  /// Snapshot of how many groups were queued vs. skipped before sending even
  /// started (unmatched/ambiguous Excel rows, duplicate rows, cooldown
  /// skips) — kept distinct from the OutboundMessage-level SKIPPED status,
  /// which is for a queued row skipped at send time (e.g. failed membership
  /// check).
  totalRequested      Int                     @default(0)
  queuedCount         Int                     @default(0)
  preQueueSkipped     Int                     @default(0)
  /// [{ groupName: string, reason: string }] — rows that never became a
  /// queue item at all, so there is no OutboundMessage row to show why.
  preQueueSkipReasons Json                    @default("[]")
  delayMinMs          Int
  delayMaxMs          Int
  maxPerMinute        Int
  maxPerJob           Int
  retryMaxAttempts    Int
  createdAt           DateTime                @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?

  messages OutboundMessage[]

  @@index([accountId, createdAt])
  @@index([status])
}

/// Singleton row (id is always the literal string "global"), analogous to
/// AutomationSettings but scoped to manual Group Message Sender jobs so
/// tuning bulk-send safety never touches automation's own limits.
model GroupBroadcastSettings {
  id                            String   @id @default("global")
  delayMinMs                    Int      @default(5000)
  delayMaxMs                    Int      @default(15000)
  maxPerMinute                  Int      @default(6)
  maxPerJob                     Int      @default(200)
  retryMaxAttempts              Int      @default(2)
  /// A group that already received a SENT broadcast within this window is
  /// skipped (not re-queued) by a new job — duplicate-send protection beyond
  /// same-job idempotency.
  duplicateGroupCooldownMinutes Int      @default(60)
  updatedAt                     DateTime @updatedAt
}

/// Batch header for the "Add to Groups" module: one phone number, added to
/// N groups (all synchronized groups for the account, or a manual
/// selection). Deliberately its own model rather than reusing
/// GroupBroadcastJob/OutboundMessage — adding a participant is a distinct
/// WhatsApp action with its own (notably stricter) ban-risk profile, so its
/// throttling must be tunable independently (see GroupParticipantAddSettings).
model GroupParticipantAddJob {
  id                  String                       @id @default(cuid())
  accountId           String
  account             WhatsAppAccount              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdById         String?
  createdBy           User?                        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Normalized digits-only phone number (no "+", no leading zeros beyond the country code).
  phoneNumber         String
  status              GroupParticipantAddJobStatus @default(QUEUED)
  /// Snapshot of how many groups were requested vs. skipped before queueing even started
  /// (e.g. "all groups" resolved to zero active groups) — distinct from a per-item FAILED result.
  totalRequested      Int                          @default(0)
  queuedCount         Int                          @default(0)
  preQueueSkipped     Int                          @default(0)
  preQueueSkipReasons Json                         @default("[]")
  delayMinMs          Int
  delayMaxMs          Int
  maxPerMinute        Int
  maxPerJob           Int
  retryMaxAttempts    Int
  createdAt           DateTime                     @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?

  items GroupParticipantAddItem[]

  @@index([accountId, createdAt])
  @@index([status])
}

model GroupParticipantAddItem {
  id                String                        @id @default(cuid())
  jobId             String
  job               GroupParticipantAddJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  groupId           String
  group             WhatsAppGroup                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupNameSnapshot String
  status            GroupParticipantAddItemStatus @default(PENDING)
  attemptCount      Int                           @default(0)
  failureReason     String?
  scheduledAt       DateTime                      @default(now())
  processedAt       DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@unique([jobId, groupId])
  @@index([status, scheduledAt])
}

/// Singleton row (id is always the literal string "global"), analogous to
/// GroupBroadcastSettings but for the Add-to-Groups module. Defaults are
/// deliberately more conservative than GroupBroadcastSettings — WhatsApp
/// treats bulk "add participant" actions as a stronger ban signal than
/// bulk messaging.
model GroupParticipantAddSettings {
  id               String   @id @default("global")
  delayMinMs       Int      @default(10000)
  delayMaxMs       Int      @default(30000)
  maxPerMinute     Int      @default(3)
  maxPerJob        Int      @default(100)
  retryMaxAttempts Int      @default(1)
  updatedAt        DateTime @updatedAt
}

model Notification {
  id                        String             @id @default(cuid())
  type                      NotificationType
  /// Which WhatsApp account this was (or will be) sent through — only meaningful for
  /// type=WHATSAPP; null for TEAMS. Nullable so pre-existing history stays valid, and so a
  /// deleted account's audit trail survives (onDelete: SetNull, not Cascade).
  accountId                 String?
  account                   WhatsAppAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  destination               String
  relatedMessageId          String?
  relatedMessage            Message?           @relation(fields: [relatedMessageId], references: [id], onDelete: SetNull)
  relatedRuleId             String?
  relatedRule               AutomationRule?    @relation(fields: [relatedRuleId], references: [id], onDelete: SetNull)
  /// Set only for Conversation Learning's Unknown Pattern alerts — lets the dashboard list every
  /// alert ever sent for a given PatternCandidate without duplicating pattern data onto this row.
  relatedPatternCandidateId String?
  relatedPatternCandidate   PatternCandidate?  @relation(fields: [relatedPatternCandidateId], references: [id], onDelete: SetNull)
  payload                   Json
  status                    NotificationStatus @default(PENDING)
  attemptCount              Int                @default(0)
  lastAttemptAt             DateTime?
  sentAt                    DateTime?
  failureReason             String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  escalationEvents SupportEscalationEvent[]

  @@index([status])
  @@index([relatedMessageId])
  @@index([relatedPatternCandidateId])
}

model WorkerCommand {
  id          String              @id @default(cuid())
  type        WorkerCommandType
  /// Nullable so pre-multi-account historical rows (created before this column existed) remain
  /// valid, and so account-agnostic command types (AI_ANALYSIS_BATCH) can omit it entirely — every
  /// other, account-scoped command type still always sets this. onDelete: Cascade since a
  /// queued-but-unprocessed command for a deleted account is meaningless.
  accountId   String?
  account     WhatsAppAccount?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payload     Json?
  status      WorkerCommandStatus @default(PENDING)
  result      Json?
  createdAt   DateTime            @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([accountId, status])
}

model ProcessingCheckpoint {
  id                       String          @id @default(cuid())
  accountId                String          @unique
  account                  WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lastProcessedTimestampWa DateTime?
  lastProcessedMessageId   String?
  updatedAt                DateTime        @updatedAt
}

/// Singleton row (id is always the literal string "global").
model AutomationSettings {
  id                           String         @id @default("global")
  mode                         AutomationMode @default(SAFE_AUTO_REPLY)
  automationEnabled            Boolean        @default(true)
  maxRepliesPerClientPerHour   Int            @default(3)
  maxRepliesPerClientPerDay    Int            @default(10)
  globalMaxPerMinute           Int            @default(5)
  globalMaxPerHour             Int            @default(100)
  globalMaxPerDay              Int            @default(500)
  rateLimitingEnabled          Boolean        @default(true)
  defaultReplyDelayMinMs       Int            @default(3000)
  defaultReplyDelayMaxMs       Int            @default(15000)
  retryMaxAttempts             Int            @default(3)
  retryIntervalsMs             Json           @default("[30000,300000,900000]")
  teamsWebhookUrl              String?
  whatsappNotificationGroupIds String[]       @default([])
  updatedAt                    DateTime       @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  level     LogLevel
  scope     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
}

// ---------------------------------------------------------------------------
// AI Learning & Knowledge System — Phase 1 (foundation only: settings,
// provider/model config, and a manually-curated, versioned Knowledge Base).
// Ingestion (software/chat/document learning, embeddings, duplicate
// detection, AI-generated responses) is deliberately NOT built yet — these
// models exist so later phases have somewhere to write to without another
// migration, per the project's own "do not build everything in one step"
// rule. Activity is logged through the existing SystemLog table (scope
// "ai-learning"), not a parallel audit log.
// ---------------------------------------------------------------------------

enum AiProviderKind {
  ANTHROPIC
  OPENAI
  GOOGLE
  CUSTOM
}

enum AiProviderStatus {
  ACTIVE
  INACTIVE
}

/// Which job a model is assigned to — mirrors the spec's "Learning Model /
/// Response Model / Vision Model / Document Model / Embedding Model" split,
/// so a future phase can pick a cheaper/faster model per job without a
/// schema change.
enum AiModelJob {
  LEARNING
  RESPONSE
  VISION
  DOCUMENT
  EMBEDDING
  /// The floating AI Admin Assistant chat widget (read-only tool-calling) — apps/web/src/server/
  /// aiAdmin/. Distinct from RESPONSE (reserved for a future customer-facing auto-response phase)
  /// since these are semantically different consumers that shouldn't share one config slot.
  ADMIN_ASSISTANT
}

enum AiKnowledgeCategory {
  SOFTWARE
  WORKFLOW
  FAQ
  TROUBLESHOOTING
  CUSTOMER_RESPONSE
  SOP
  REQUIREMENT
  FEATURE
  POLICY
  ANNOUNCEMENT
  SCREENSHOT
}

enum AiKnowledgeStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Singleton row (id is always the literal string "global"). Every switch
/// defaults OFF/conservative, matching AutomationSettings/GroupBroadcastSettings —
/// none of these actually gate anything yet since the learning/response
/// pipelines they're meant to control don't exist until a later phase.
model AiSettings {
  id                           String   @id @default("global")
  aiEngineEnabled              Boolean  @default(false)
  learningEnabled              Boolean  @default(false)
  autoResponseEnabled          Boolean  @default(false)
  screenshotResponseEnabled    Boolean  @default(false)
  chatLearningEnabled          Boolean  @default(false)
  softwareLearningEnabled      Boolean  @default(false)
  requirementLearningEnabled   Boolean  @default(false)
  announcementAiEnabled        Boolean  @default(false)
  /// Percentage (0-100). Two pieces of knowledge at/above this similarity are treated as duplicates.
  duplicateSimilarityThreshold Int      @default(95)
  learningConfidenceThreshold  Int      @default(90)
  autoApprovalThreshold        Int      @default(95)
  humanReviewThreshold         Int      @default(70)
  updatedAt                    DateTime @updatedAt
}

/// A configured AI provider account (e.g. one Anthropic API key). apiKeyCiphertext
/// is AES-256-GCM encrypted at rest (see server/aiCrypto.ts) — the plaintext key
/// never touches the database or, past the initial form submit, the browser.
model AiProvider {
  id               String           @id @default(cuid())
  name             String
  kind             AiProviderKind
  apiUrl           String?
  apiKeyCiphertext String
  status           AiProviderStatus @default(ACTIVE)
  priority         Int              @default(0)
  lastTestedAt     DateTime?
  lastTestOk       Boolean?
  lastTestError    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  models            AiModelConfig[]
  learningBatchJobs LearningBatchJob[]
  patternCandidates PatternCandidate[]
}

/// Exactly one active model assignment per job (see @@unique) — the same
/// "singleton per key" pattern as GroupParticipantAddSettings, just keyed by
/// job instead of a fixed "global" id.
model AiModelConfig {
  id         String     @id @default(cuid())
  job        AiModelJob @unique
  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelId    String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

/// The application's permanent knowledge store (spec section 9). In Phase 1
/// every row is human-authored (aiGenerated=false, source=MANUAL) — the
/// aiGenerated/confidence/source fields exist now so later phases (software
/// learning, chat learning, document learning) can populate the same table
/// without a breaking migration. Always reflects the LATEST version; full
/// history lives in AiKnowledgeVersion.
model AiKnowledgeItem {
  id              String              @id @default(cuid())
  title           String
  category        AiKnowledgeCategory
  question        String?
  answer          String
  procedure       String?
  software        String?
  module          String?
  softwareVersion String?
  source          String              @default("MANUAL")
  confidence      Int?
  aiGenerated     Boolean             @default(false)
  humanVerified   Boolean             @default(true)
  status          AiKnowledgeStatus   @default(ACTIVE)
  currentVersion  Int                 @default(1)
  createdById     String?
  createdBy       User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  versions AiKnowledgeVersion[]

  @@index([category])
  @@index([status])
}

/// One immutable snapshot per edit (spec section 10 — "never simply
/// overwrite important knowledge"). Version 1 is written at creation time;
/// every subsequent edit adds a new row rather than mutating history.
model AiKnowledgeVersion {
  id              String              @id @default(cuid())
  itemId          String
  item            AiKnowledgeItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  version         Int
  title           String
  category        AiKnowledgeCategory
  question        String?
  answer          String
  procedure       String?
  software        String?
  module          String?
  softwareVersion String?
  changeSummary   String?
  createdById     String?
  createdBy       User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())

  @@unique([itemId, version])
}

// ---------------------------------------------------------------------------
// Priority-Based Support Monitoring & Escalation
// ---------------------------------------------------------------------------

/// One row per priority tier (seeded lazily, like every other settings singleton in this app —
/// see getSupportPriorityPolicies()). SLA minutes are snapshotted onto each
/// SupportEscalationCase at creation time, so editing a policy never rewrites an in-flight case.
model SupportPriorityPolicy {
  id                      String          @id @default(cuid())
  priority                SupportPriority @unique
  firstAlertMinutes       Int
  secondAlertMinutes      Int
  memberEscalationMinutes Int
  adminEscalationMinutes  Int
  followUpIntervalMinutes Int
  maxEscalations          Int
  updatedAt               DateTime        @updatedAt
}

/// Singleton row (id is always the literal string "global").
model SupportEscalationSettings {
  id                String              @id @default("global")
  enabled           Boolean             @default(true)
  escalationAdminId String?
  escalationAdmin   InternalTeamMember? @relation(fields: [escalationAdminId], references: [id], onDelete: SetNull)
  updatedAt         DateTime            @updatedAt
}

/// One open "ticket" per chat with an unanswered priority customer message. Created the moment
/// a non-team-member message arrives in a priority-tagged group with no case already open for
/// that chat (a second customer message before anyone replies extends the existing case rather
/// than opening a duplicate one — see escalationQueue.ts).
model SupportEscalationCase {
  id          String           @id @default(cuid())
  accountId   String
  account     WhatsAppAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId     String
  group       WhatsAppGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  chatId      String
  clientPhone String
  priority    SupportPriority
  status      EscalationStatus @default(NEW)

  triggerMessageId      String
  triggerMessage        Message  @relation("EscalationTriggerMessage", fields: [triggerMessageId], references: [id], onDelete: Cascade)
  lastCustomerMessageAt DateTime

  escalationLevel      Int                 @default(0)
  assignedTeamMemberId String?
  assignedTeamMember   InternalTeamMember? @relation(fields: [assignedTeamMemberId], references: [id], onDelete: SetNull)

  /// Snapshot of the matching SupportPriorityPolicy at case-creation time (see model doc comment).
  firstAlertMinutes       Int
  secondAlertMinutes      Int
  memberEscalationMinutes Int
  adminEscalationMinutes  Int
  followUpIntervalMinutes Int
  maxEscalations          Int

  /// When the escalation worker should next evaluate this case — avoids scanning every open case
  /// every tick, same "claim only what's due" shape as OutboundMessage.scheduledAt.
  nextCheckAt    DateTime
  humanRepliedAt DateTime?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  pausedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events SupportEscalationEvent[]

  @@index([status, nextCheckAt])
  @@index([groupId])
  @@index([chatId])
}

/// The escalation audit trail AND the duplicate-notification guard in one table: the unique
/// constraint below makes it structurally impossible for a worker retry/restart/concurrent tick
/// to send the same tier to the same recipient twice — see fireEscalationEvent() in
/// escalationQueue.ts, which always tries to INSERT this row (inside the same transaction as the
/// Notification it creates) before ever sending anything, and treats a unique-constraint failure
/// as "already handled, skip."
model SupportEscalationEvent {
  id             String                  @id @default(cuid())
  caseId         String
  case           SupportEscalationCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  level          Int
  eventType      EscalationEventType
  recipientType  EscalationRecipientType
  /// Stable identity of the recipient (a WhatsApp group id, an InternalTeamMember id, or the
  /// literal "ADMIN"/"SYSTEM") — this, not recipientLabel, is what the uniqueness guarantee below
  /// keys on, so a tier that fans out to multiple groups gets one idempotent row per group.
  recipientKey   String
  recipientLabel String
  notificationId String?
  notification   Notification?           @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  triggeredById  String?
  triggeredBy    User?                   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt      DateTime                @default(now())

  @@unique([caseId, level, eventType, recipientKey])
  @@index([caseId])
}

// ---------------------------------------------------------------------------
// Conversation Learning / Pattern Discovery — Phase 1 (data collection only).
// A background layer that runs alongside the rule engine, never inside it:
// it only reads already-persisted Message rows and tags them with a session,
// entirely off by default (LearningSettings.conversationLearningEnabled).
// Deterministic pattern detection (PatternCandidate), human review
// (RuleProposal), and AI-assisted analysis are later, separate migrations —
// this phase adds no path that can affect message delivery or rule
// evaluation. See ARCHITECTURE.md-style note in apps/worker/src/learning/.
// ---------------------------------------------------------------------------

enum ConversationSessionStatus {
  OPEN
  CLOSED
}

enum LearningBatchJobType {
  CONVERSATION_SEGMENTATION
  /// Not implemented until the deterministic pattern-detection migration/phase.
  PATTERN_DETECTION
  /// Not implemented until the AI-assisted analysis migration/phase.
  AI_ANALYSIS
}

enum LearningBatchJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum LearningBatchJobTrigger {
  MANUAL
  SCHEDULED
}

/// Groups existing Message rows by chat + inactivity gap — copies no message content, just tags
/// Message.conversationSessionId. Built by a separate batch job (apps/worker/src/learning/
/// sessionSegmentation.ts), never by the message pipeline itself.
model ConversationSession {
  id                String                    @id @default(cuid())
  accountId         String
  account           WhatsAppAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId            String
  groupId           String?
  group             WhatsAppGroup?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  status            ConversationSessionStatus @default(OPEN)
  firstMessageAt    DateTime
  lastMessageAt     DateTime
  messageCount      Int                       @default(0)
  /// Distinct Message.senderPhone values seen so far in this session.
  participantPhones String[]                  @default([])
  closedAt          DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  messages Message[]
  evidence PatternCandidateEvidence[]

  @@index([accountId, chatId, status])
  /// The segmentation job's own "claim only what's due" query: OPEN sessions idle past the gap window.
  @@index([status, lastMessageAt])
}

/// Singleton row (id is always the literal string "global"), same pattern as AutomationSettings/
/// AiSettings. Thresholds here are meaningful even with AI fully off, so they live here rather
/// than on AiSettings — this is deliberately not an "AI settings" table.
model LearningSettings {
  id                                 String   @id @default("global")
  /// The one kill switch for this entire feature — false means the segmentation/pattern-detection
  /// jobs no-op on every tick, and zero rows are written anywhere under this section.
  conversationLearningEnabled        Boolean  @default(false)
  /// Minutes of inactivity on a chat before its current session is closed.
  sessionGapMinutes                  Int      @default(30)
  /// Below this occurrence count, a would-be pattern is not yet promoted to a PatternCandidate row
  /// (enforced starting in the pattern-detection phase) — kept here now so the settings shape is
  /// stable across phases and editable from one place.
  minOccurrenceForCandidate          Int      @default(3)
  minDistinctGroupsForCandidate      Int      @default(2)
  minDistinctClientsForCandidate     Int      @default(2)
  candidateExpiryDays                Int      @default(30)
  /// Explicit opt-in, default OFF — an approved-but-not-yet-active auto-approval policy must never
  /// be assumed; see the pattern-detection/rule-proposal phases.
  autoApprovalEnabled                Boolean  @default(false)
  autoApprovalMinConfidence          Int      @default(97)
  weightFrequency                    Int      @default(25)
  weightDiversity                    Int      @default(20)
  weightConsistency                  Int      @default(20)
  weightResolution                   Int      @default(15)
  weightRecency                      Int      @default(10)
  weightAiConfidence                 Int      @default(10)
  /// Explicit opt-in, default OFF — Unknown Pattern alerts (patternDetectionJob.ts) reuse
  /// AutomationSettings.whatsappNotificationGroupIds as their destination; this flag alone gates
  /// whether that reuse ever fires, independent of conversationLearningEnabled (accumulation can
  /// run silently for a while before an admin decides to also turn alerting on).
  unknownPatternNotificationsEnabled Boolean  @default(false)
  /// Minimum minutes between two alerts for the same PatternCandidate — prevents one recurring
  /// unhandled question from re-notifying on every 15-minute pattern-detection tick.
  unknownPatternCooldownMinutes      Int      @default(60)
  updatedAt                          DateTime @updatedAt
}

/// One row per batch-job run (segmentation, pattern detection, or AI analysis) — audit trail and,
/// for AI_ANALYSIS specifically, the cost-visibility record referenced from the dashboard hub.
model LearningBatchJob {
  id                   String                  @id @default(cuid())
  jobType              LearningBatchJobType
  trigger              LearningBatchJobTrigger
  status               LearningBatchJobStatus  @default(QUEUED)
  triggeredById        String?
  triggeredBy          User?                   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  /// Only ever set for AI_ANALYSIS runs.
  aiProviderId         String?
  aiProvider           AiProvider?             @relation(fields: [aiProviderId], references: [id], onDelete: SetNull)
  candidatesConsidered Int                     @default(0)
  candidatesUpdated    Int                     @default(0)
  errorMessage         String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())

  @@index([status, jobType])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Conversation Learning / Pattern Discovery — Phase 2 (deterministic pattern
// detection). Entirely AI-free: packages/engine/src/patternDetection.ts's
// pure scorer never calls an AI provider. aiConfidenceScore/aiProviderId/
// aiAnalysisSummary below are included now (nullable, unused) so the AI-
// assisted analysis phase doesn't need a second migration on this table.
// ---------------------------------------------------------------------------

enum PatternCandidateStatus {
  PENDING_ANALYSIS
  /// Only reachable once the (later, optional) AI-assisted analysis phase has scored this candidate.
  ANALYZED
  PENDING_REVIEW
  APPROVED
  REJECTED
  /// Folded into another candidate covering the same intent (human/reviewer action, later phase).
  MERGED
  /// Aged out without enough evidence — see LearningSettings.candidateExpiryDays (later phase).
  EXPIRED
}

/// One row per detected pattern signature — created as soon as the first occurrence is seen, so
/// evidence has somewhere to accumulate against. The hard floor (LearningSettings.
/// minOccurrenceForCandidate/minDistinctGroupsForCandidate/minDistinctClientsForCandidate) does
/// NOT gate row creation — it gates whether a row is ever surfaced to a human or considered a real
/// "candidate" anywhere downstream (the dashboard list only queries rows currently past the
/// floor; see patternDetectionJob.ts's rescoreCandidate(), which also refuses to advance `status`
/// past PENDING_ANALYSIS until the floor is met). A single isolated conversation can create a row
/// here, but it can never become visible or actionable.
model PatternCandidate {
  id                      String    @id @default(cuid())
  /// Deterministic signature (sorted distinctive-keyword set) — the same recurring intent always
  /// hashes to the same key, order-independent. See packages/engine/src/patternDetection.ts.
  patternKey              String    @unique
  suggestedMatchType      MatchType
  suggestedKeywords       String[]  @default([])
  suggestedMatchValue     String?
  /// Most common team-member reply text seen following a matching message — evidence, not binding.
  suggestedReplyMessage   String?
  suggestedActionCategory String?

  occurrenceCount     Int      @default(0)
  distinctGroupCount  Int      @default(0)
  distinctClientCount Int      @default(0)
  /// Of occurrenceCount, how many evidence rows have no respondingRuleId — i.e. no existing
  /// AutomationRule fired for that historical message. This is the Unknown Pattern signal: a
  /// pattern an existing rule already handles well can still accumulate as a PatternCandidate
  /// (unchanged, existing behavior) without ever being treated as "unknown".
  unhandledCount      Int      @default(0)
  firstSeenAt         DateTime
  lastSeenAt          DateTime

  /// Individual signal scores (0-100), each computed independently — see computeConfidenceScore().
  frequencyScore     Int  @default(0)
  diversityScore     Int  @default(0)
  consistencyScore   Int  @default(0)
  resolutionScore    Int  @default(0)
  recencyScore       Int  @default(0)
  /// Null until an AI batch analyzes it (later phase) — the confidence formula falls back to
  /// frequencyScore when this is null, so it never degrades in AI-off mode.
  aiConfidenceScore  Int?
  /// Only ever incremented via an explicit reviewer action (later phase), capped at 100.
  humanVerifiedBoost Int  @default(0)
  /// Final blended score — see computeConfidenceScore() in packages/engine.
  confidenceScore    Int  @default(0)

  status            PatternCandidateStatus @default(PENDING_ANALYSIS)
  aiAnalysisSummary String?
  aiProviderId      String?
  aiProvider        AiProvider?            @relation(fields: [aiProviderId], references: [id], onDelete: SetNull)
  reviewedById      String?
  reviewedBy        User?                  @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewNote        String?
  mergedIntoId      String?
  mergedInto        PatternCandidate?      @relation("PatternMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom        PatternCandidate[]     @relation("PatternMerge")

  /// Last time an Unknown Pattern alert was sent for this candidate — the cooldown clock
  /// LearningSettings.unknownPatternCooldownMinutes counts against. Null means never alerted.
  unknownPatternNotifiedAt DateTime?
  unknownPatternAlerts     Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence PatternCandidateEvidence[]
  proposal RuleProposal?

  @@index([status, confidenceScore])
  @@index([lastSeenAt])
  @@index([unhandledCount, lastSeenAt])
}

/// Audit trail proving a PatternCandidate isn't a fluke — one row per ConversationSession that
/// contributed to it. The unique constraint also makes the detection job's upsert idempotent: a
/// session already linked to this candidate is never counted or linked twice.
model PatternCandidateEvidence {
  id                    String              @id @default(cuid())
  patternCandidateId    String
  patternCandidate      PatternCandidate    @relation(fields: [patternCandidateId], references: [id], onDelete: Cascade)
  conversationSessionId String
  conversationSession   ConversationSession @relation(fields: [conversationSessionId], references: [id], onDelete: Cascade)
  matchedMessageId      String?
  matchedMessage        Message?            @relation(fields: [matchedMessageId], references: [id], onDelete: SetNull)
  /// Heuristic: a team-member reply followed within the same session.
  wasResolved           Boolean             @default(false)
  /// Set if an AutomationExecution in this session already had a non-null ruleId — a historical-
  /// outcome signal, not a foreign key (the rule may since have been deleted/disabled).
  respondingRuleId      String?
  createdAt             DateTime            @default(now())

  @@unique([patternCandidateId, conversationSessionId])
  @@index([patternCandidateId])
}

// ---------------------------------------------------------------------------
// Conversation Learning / Pattern Discovery — Phase 3/4 (human review + real
// rule execution). A RuleProposal is a fully-formed AutomationRule draft, so
// approving it is a pure copy into a real AutomationRule row (status DRAFT,
// never ACTIVE) — see approveRuleProposal() in
// apps/web/src/server/actions/ruleProposals.ts. The rule engine that then
// executes it (once a human separately flips it ACTIVE on the existing Rules
// page) is completely unmodified by any of this.
// ---------------------------------------------------------------------------

enum RuleProposalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  /// Reserved for a later phase (e.g. an approved-but-not-yet-converted state); every proposal
  /// created today reaches APPROVED and a real AutomationRule in the same transaction.
  CONVERTED
}

/// One row per human-facing proposal, at most one per PatternCandidate (see @@unique below) — a
/// candidate that's rejected or withdrawn does not get a second proposal; if the same pattern
/// keeps recurring, that continues to accumulate as fresh evidence on the same candidate.
model RuleProposal {
  id                 String           @id @default(cuid())
  patternCandidateId String           @unique
  patternCandidate   PatternCandidate @relation(fields: [patternCandidateId], references: [id], onDelete: Cascade)

  // Fully-formed AutomationRule draft — same shape as the real row, so approval is a pure copy.
  name            String
  description     String?
  type            RuleType
  matchType       MatchType
  matchValue      String?
  keywords        String[]  @default([])
  conditions      Json      @default("{}")
  actions         Json      @default("[]")
  priority        Int       @default(0)
  cooldownSeconds Int?
  replyMessage    String?
  replyDelayMinMs Int?
  replyDelayMaxMs Int?

  /// Copied from PatternCandidate.confidenceScore at proposal-creation time — a snapshot, not a
  /// live link, so it stays meaningful even if the source candidate's score later changes.
  confidenceScoreSnapshot Int
  status                  RuleProposalStatus @default(PENDING_REVIEW)
  /// Reserved for a later auto-approval phase — every proposal created today is created with this
  /// false and moved to APPROVED only via an explicit human action.
  autoApproved            Boolean            @default(false)
  reviewedById            String?
  reviewedBy              User?              @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt              DateTime?
  reviewNote              String?
  createdRuleId           String?            @unique
  createdRule             AutomationRule?    @relation(fields: [createdRuleId], references: [id], onDelete: SetNull)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([status, confidenceScoreSnapshot])
}

// ---------------------------------------------------------------------------
// Support Activity Tracking — detects configured keyword/rule matches sent by
// configured InternalTeamMembers inside WhatsApp groups, records each as a
// raw SupportActivity event, and lets admins view counts computed from that
// raw history under 3 configurable counting modes + a DAILY counting period.
// Off by default (SupportActivitySettings.enabled = false); when off, the
// detector (apps/worker/src/supportActivity/detector.ts) no-ops and zero
// rows are ever written. Entirely independent of AutomationRule/the rule
// engine's own evaluation — runs alongside it, never gated by its decision.
// ---------------------------------------------------------------------------

enum SupportActivityCountingMode {
  UNIQUE_GROUP
  EVERY_ACTIVITY
  PER_TEAM_MEMBER
}

/// Closed enum (not a free string) so periods stay a pure enum-value + query addition, never a
/// shape rewrite. WEEKLY starts Sunday (regional Fri/Sat weekend convention).
enum SupportActivityCountingPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

/// Closed on purpose (same reasoning as WhatsAppServiceKey's own doc comment). The detector's
/// dispatch (apps/worker/src/supportActivity/detector.ts) is a plain switch on this value, not a
/// plugin system. REACTION is intentionally NOT included yet — WhatsApp reactions arrive via a
/// separate event stream (client.onReaction(), not the onAnyMessage payload these three trigger
/// types read from) and need a dedicated ingestion path + table; add it as its own migration when
/// actually built, not speculatively now.
enum SupportActivityTriggerType {
  KEYWORD_MATCH
  /// Fires when a support team member's message is a WhatsApp "quoted reply" to a message from a
  /// non-team-member (a real customer) — no keyword needed.
  REPLY_TO_CUSTOMER
  /// Fires when a support team member's message @-mentions at least one non-team-member phone
  /// number — no keyword needed.
  MENTION
}

enum SupportKeywordMatchMode {
  CONTAINS
  EXACT
}

/// Singleton row (id is always the literal string "global"), same pattern as AutomationSettings/
/// AiSettings/LearningSettings/SupportEscalationSettings. enabled defaults to false — the whole
/// feature is off until an admin opts in; while off, apps/worker/src/supportActivity/detector.ts
/// no-ops on every message and zero SupportActivity rows are ever written. countingMode/
/// countingPeriod are global, not per-rule, by explicit requirement.
model SupportActivitySettings {
  id             String                        @id @default("global")
  enabled        Boolean                       @default(false)
  countingMode   SupportActivityCountingMode   @default(EVERY_ACTIVITY)
  countingPeriod SupportActivityCountingPeriod @default(DAILY)
  updatedAt      DateTime                      @updatedAt
}

/// Admin-managed keyword/phrase. Referenced by zero or more SupportRules via SupportRuleKeyword —
/// not a free-text array on the rule itself, unlike AutomationRule.keywords, because keywords here
/// are independently CRUD-able (add/edit/delete/enable-disable) and reused across rules.
model SupportKeyword {
  id            String                  @id @default(cuid())
  value         String
  matchMode     SupportKeywordMatchMode @default(CONTAINS)
  /// Default false (case-insensitive) — matches every existing text-matching convention in this
  /// app (see packages/engine/src/normalize.ts's normalizeText()).
  caseSensitive Boolean                 @default(false)
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  rules      SupportRuleKeyword[]
  activities SupportActivity[]
}

/// One admin-configured detection rule. Global (no accountId), same precedent as AutomationRule.
/// Scope to "all X" vs "selected X" is a boolean flag + a join table used only when the flag is
/// false — the minimal shape for this, not a JSON id array (which is harder to index/join safely).
model SupportRule {
  id                      String                     @id @default(cuid())
  name                    String
  description             String?
  triggerType             SupportActivityTriggerType @default(KEYWORD_MATCH)
  /// true = every WhatsAppGroup is in scope; false = only groups explicitly listed in `groups`.
  appliesToAllGroups      Boolean                    @default(true)
  /// true = every InternalTeamMember is in scope; false = only members explicitly listed in
  /// `teamMembers`.
  appliesToAllTeamMembers Boolean                    @default(true)
  isActive                Boolean                    @default(true)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  keywords    SupportRuleKeyword[]
  groups      SupportRuleGroup[]
  teamMembers SupportRuleTeamMember[]
  activities  SupportActivity[]

  /// The detector's primary WHERE-clause shape: "active rules of this trigger type."
  @@index([isActive, triggerType])
}

model SupportRuleKeyword {
  ruleId    String
  rule      SupportRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  keywordId String
  keyword   SupportKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([ruleId, keywordId])
}

model SupportRuleGroup {
  ruleId    String
  rule      SupportRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  groupId   String
  group     WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([ruleId, groupId])
}

model SupportRuleTeamMember {
  ruleId       String
  rule         SupportRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  teamMemberId String
  teamMember   InternalTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@id([ruleId, teamMemberId])
}

/// One row per detected support-activity event — the raw, permanent history. Aggregated counts
/// (UNIQUE_GROUP / EVERY_ACTIVITY / PER_TEAM_MEMBER, over SupportActivitySettings.countingPeriod)
/// are always computed from this table at query time (see apps/web/src/server/
/// supportActivityReports.ts) — this table never stores a final count, so changing countingMode/
/// countingPeriod retroactively reinterprets all existing history correctly.
model SupportActivity {
  id           String              @id @default(cuid())
  accountId    String
  account      WhatsAppAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId      String
  group        WhatsAppGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Nullable + SetNull (not Cascade) so a later-deleted InternalTeamMember never destroys already-
  /// recorded history — only its per-member attribution on that one row degrades to "unassigned."
  teamMemberId String?
  teamMember   InternalTeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  /// Nullable + SetNull, same reasoning: a deleted SupportRule/SupportKeyword must never delete
  /// history (mirrors AutomationExecution.ruleId's exact pattern).
  ruleId       String?
  rule         SupportRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  keywordId    String?
  keyword      SupportKeyword?     @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  /// The idempotency guard: at most one SupportActivity row can ever exist per Message. Enforced
  /// here as a real DB constraint (insert-and-catch-P2002), not an application-level check-then-
  /// insert race — mirrors how Message's own @@unique([accountId, whatsappMessageId]) is the real
  /// dedup guard, and AutomationExecution.idempotencyKey's @unique column.
  messageId    String              @unique
  message      Message             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// = Message.timestampWa (WhatsApp's own send time), not receivedAt/createdAt — this is what
  /// every DAILY (and future WEEKLY/MONTHLY) period boundary buckets against.
  occurredAt   DateTime
  createdAt    DateTime            @default(now())

  @@index([accountId, occurredAt])
  @@index([accountId, groupId, occurredAt])
  @@index([accountId, teamMemberId, occurredAt])
  @@index([ruleId])
}
