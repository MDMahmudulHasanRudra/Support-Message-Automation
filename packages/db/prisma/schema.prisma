  whatsAppGroupRows                    WhatsAppGroup[]
  automationExecutionRows              AutomationExecution[]
  notificationRows                     Notification[]
  workerCommandRows                    WorkerCommand[]
  processingCheckpointRows             ProcessingCheckpoint[]
  collectionGapRows                    CollectionGap[]
  whatsappOperationDismissals          WhatsAppOperationDismissal[]
  messageDropCounterRows               MessageDropCounter[]
  groupBroadcastJobRows                GroupBroadcastJob[]
  groupParticipantAddJobRows           GroupParticipantAddJob[]
  groupParticipantAddItemRows          GroupParticipantAddItem[]
