/// Which projects a user may ENTER — nothing else. What they may do inside a project is decided by
/// the existing permission system (their existing role), unchanged, the same in every project they
/// can access. Deliberately no role or permission column here: project access and module
/// permission are separate questions (MULTI_PROJECT_PLAN.md §7).
model ProjectAccess {
  id        String              @id @default(cuid())
  projectId String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// How much of their EXISTING role this user may use in this project (MAIN_ADMIN_WORKSPACE.md §4).
  /// It only ever takes rights away: READ keeps the role's read keys, WRITE also keeps its day-to-day
  /// write keys, FULL (and null, which every row predating the column has) keeps the whole role.
  /// It never grants a key the role does not hold — `packages/shared/src/projectAccessLevels.ts`.
  level     ProjectAccessLevel?
  createdAt DateTime            @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

/// A project's entitlement to one feature. Absent row = the feature catalogue's default, so adding a
/// feature needs no migration. Read by nothing until Phase 5.
model ProjectFeature {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  key       String
  enabled   Boolean
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
}

model User {
  id           String  @id @default(cuid())
  username     String  @unique
  email        String? @unique // optional: login is by username, not email; every existing
  // display site already does `createdBy?.email ?? "—"`, so a missing email was already a
  // normal, handled case before this field was ever made nullable.
  passwordHash String
  name         String

  isActive            Boolean           @default(true) // inactive users are rejected at login and every
  // already-issued session is rejected too (see UserSession/getSession) — never deleted, so
  // audit history (createdRules etc. below) stays intact. Matches this app's existing
  // soft-delete-over-hard-delete standard.
  permissionModuleId  String?
  permissionModule    PermissionModule? @relation(fields: [permissionModuleId], references: [id], onDelete: Restrict)
  lastLoginAt         DateTime?
  failedLoginAttempts Int               @default(0) // reset to 0 on every successful login
  lastFailedLoginAt   DateTime? // dedicated timestamp for the lockout window check — deliberately
  // separate from updatedAt, which changes for unrelated reasons (e.g. an admin editing the user)
  // and would otherwise make the rolling-window check unreliable
  lockedUntil         DateTime? // set once failedLoginAttempts crosses SecuritySettings'
  // loginLockoutThreshold within loginLockoutWindowMinutes; checked before the password itself

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions UserSession[]

  createdRules                AutomationRule[]
  createdBroadcastJobs        GroupBroadcastJob[]
  createdOutboundSends        OutboundMessage[]
  createdParticipantAddJobs   GroupParticipantAddJob[]
  createdAdminPromotionJobs   GroupAdminPromotionJob[]
  requestedMediaCleanups      MediaCleanupJob[]
  updatedMediaStorageSettings MediaStorageSettings[]
  clearedSupportEpisodes      SupportResponseEpisode[]
  createdKnowledgeItems       AiKnowledgeItem[]
  createdKnowledgeImports     KnowledgeImport[]
  createdKnowledgeVersions    AiKnowledgeVersion[]
  approvedStyleProfiles       CommunicationStyleProfile[]
  editedNotificationTemplates NotificationTemplate[]
  whatsappOperationDismissals WhatsAppOperationDismissal[]
  savedReplies                SavedReply[]
  savedGroupSets              SavedGroupSet[]
  resolvedEscalationCases     SupportEscalationCase[]
  triggeredEscalationEvents   SupportEscalationEvent[]
  triggeredLearningBatchJobs  LearningBatchJob[]
  reviewedPatternCandidates   PatternCandidate[]
  reviewedRuleProposals       RuleProposal[]
  /// Set only when an admin manually closes a SupportSession that never received a completion
  /// keyword (apps/web/src/server/actions/supportSessions.ts) — mirrors resolvedEscalationCases'
  /// existing "which logged-in admin resolved this" pattern above.
  closedSupportSessions       SupportSession[]

  assignedDuties      DutyAssignment[]
  dutyChanges         DutyAssignmentChange[]
  requestedLeave      LeaveRequest[]         @relation("LeaveRequestedBy")
  decidedLeave        LeaveRequest[]         @relation("LeaveDecidedBy")
  attendanceOverrides TeamAttendanceDay[]

  createdReleaseNotes   ReleaseNote[]         @relation("ReleaseNoteCreatedBy")
  publishedReleaseNotes ReleaseNote[]         @relation("ReleaseNotePublishedBy")
  releaseNoteRevisions  ReleaseNoteRevision[]

  createdSandboxSessions SandboxSession[]
  reviewedSandboxTurns   SandboxTurn[]

  createdAnalysisRuns            ConversationAnalysisRun[]
  reviewedConversationCandidates ConversationCandidate[]
  knowledgeVerified              AiKnowledgeItem[]         @relation("AiKnowledgeVerifier")
  systemLogs                     SystemLog[]

  projectAccess ProjectAccess[]
  /// The person this login belongs to, if one has been recorded (Main Admin → Configuration → Employees).
  employee      Employee?
}

// ---------------------------------------------------------------------------
// App User Management + Permission Modules + Session Management.
//
// UserSession replaces the old stateless signed-cookie token with a real, server-side-revocable
// session record: the cookie carries only a random high-entropy secret, never stored raw — only
// its sha256 (secretHash, unique+indexed) is persisted, so a lookup is an O(1) equality match,
// never a scan. expiresAt is baked in at creation time from SecuritySettings.sessionLifetimeHours
// and is never recalculated — changing the setting later only affects sessions created afterward.
//
// PermissionModule is a reusable, admin-manageable permission profile (Administrator/Support
// Manager/Support Agent/Read Only by default, plus custom ones); Permission is a real table (not
// a Prisma enum, and not a String[] on PermissionModule) seeded from the single source of truth at
// packages/shared/src/permissions.ts, so a permission key typo fails closed against a real FK
// rather than trusting an unchecked string. One PermissionModule per User (source of truth for
// this phase — no per-user permission overrides, see CLAUDE.md/plan for why).
// ---------------------------------------------------------------------------

model PermissionModule {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // true only for the 4 seeded defaults — the delete/rename
  // action blocks on this; permissions assigned to it remain editable
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions PermissionModulePermission[]
  users       User[]
}

/// Canonical permission catalogue — one row per key in packages/shared/src/permissions.ts,
/// seeded/synced by packages/db/prisma/seed.ts. Never created ad hoc from the UI: the key set is
/// code-defined: the UI only lets an admin toggle which keys belong to which PermissionModule.
model Permission {
  id       String @id @default(cuid())
  key      String @unique // e.g. "automation_rules.delete" — matches packages/shared/src/permissions.ts
  label    String
  category String // e.g. "Automation Rules" — for grouped UI display only, not a FK

  modules PermissionModulePermission[]
}

model PermissionModulePermission {
  permissionModuleId String
  permissionModule   PermissionModule @relation(fields: [permissionModuleId], references: [id], onDelete: Cascade)
  permissionId       String
  permission         Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([permissionModuleId, permissionId])
}

model UserSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretHash    String    @unique // sha256(raw secret); the raw secret only ever lives in the cookie
  createdAt     DateTime  @default(now())
  expiresAt     DateTime // absolute: createdAt + SecuritySettings.sessionLifetimeHours at creation
  // time — see banner comment above for why this is never recalculated
  lastUsedAt    DateTime  @default(now())
  ipAddress     String?
  userAgent     String?
  revokedAt     DateTime?
  revokedReason String? // "USER_LOGOUT" | "ADMIN_REVOKED" | "ADMIN_REVOKED_ALL" |
  // "PASSWORD_CHANGED" — plain string, internal bookkeeping only, never a user-facing status enum

  @@index([userId])
  @@index([expiresAt])
}

/// Singleton settings row, same pattern as AutomationSettings (id: "global", upsert-only).
model SecuritySettings {
  id                          String   @id @default("global")
  sessionLifetimeHours        Int      @default(24) // app-layer clamps to [1, 720] (30 days) in
  // the server action — this schema has no numeric CHECK constraints anywhere else, so validation
  // stays entirely in code, consistent with every other settings model
  loginLockoutThreshold       Int      @default(5)
  loginLockoutWindowMinutes   Int      @default(15)
  loginLockoutDurationMinutes Int      @default(15)
  updatedAt                   DateTime @updatedAt
}

model WhatsAppAccount {
  id              String                @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId       String                @default(dbgenerated("project_id_required()"))
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  label           String
  phoneNumber     String?
  status          WhatsAppAccountStatus @default(DISCONNECTED)
  /// Where the current connection attempt has got to, one of `OPENWA_CONNECTION_STATES`
  /// (apps/worker/src/provider/openwa/connectionState.ts). Reported to the operator, never
  /// branched on — `status` above is the coarse column every loop, queue and health check reads,
  /// and it stays the single source of truth for whether this session can carry a message.
  ///
  /// It exists because that coarse column collapses six lifecycle states into RECONNECTING, which
  /// leaves the one moment a person is actually watching — the seconds between scanning a code and
  /// the session being usable — reported with the same word as the minute before they scanned.
  /// Null when no attempt has been recorded; cleared at boot with the QR, since a stage describes
  /// an attempt that died with the previous process.
  connectionStage String?
  /// Whatever the current pairing attempt produced, written by the worker and polled by the
  /// dashboard. Its SHAPE depends on `pairingMethod`: a `data:image/png` URL for a QR code, or a
  /// nine-character link code ("ABCD-EFGH") for phone pairing. One column for both because the
  /// library emits them on one event — see `pairingMethod` for why that is not an accident.
  qrCode          String?
  qrUpdatedAt     DateTime?
  /// When the current linking attempt stops waiting for a scan — the deadline the linking dialog
  /// counts down to. Written by the worker as the attempt begins, from its own connect watchdog, so
  /// the dashboard never needs a copy of that length. Cleared once the scan is accepted (the
  /// countdown stops mattering), on connect, and on any end to the attempt. Null means nothing is
  /// waiting on a person.
  linkExpiresAt   DateTime?

  /// How this account asks WhatsApp to link it: by showing a QR code, or by asking for a code the
  /// operator types into the phone. Both are official WhatsApp Web flows and
  /// `@open-wa/wa-automate` supports both — `ConfigObject.linkCode` selects the second.
  ///
  /// Stored per account rather than passed with a command, because `connect()` is also reached
  /// from boot, from automatic recovery and from the registry sync, none of which carry an
  /// operator's choice. A preference that only survived one button press would silently revert to
  /// QR the first time the worker restarted mid-pairing.
  pairingMethod      WhatsAppPairingMethod @default(QR_CODE)
  /// The number to request a link code FOR, digits only. Deliberately not `phoneNumber` above:
  /// that one is the number WhatsApp reports once a session is live, and overwriting it with an
  /// unverified operator-typed value would make a claim about the session that nothing has
  /// confirmed. Null under QR_CODE, and required before PHONE_CODE can be used.
  pairingPhoneNumber String?

  /// Per-account proxy, read at connect time by OpenWAProvider and handed to the library as
  /// `proxyServerCredentials`. Address is `host:port`; protocol/username/password are optional —
  /// the library can infer the protocol from the address, and most proxies need no credentials.
  /// Null means no proxy, which is what every existing account already does.
  proxyAddress            String?
  proxyProtocol           String?
  proxyUsername           String?
  /// Encrypted at rest with the same `encryptSecret`/`decryptSecret` this schema already uses for
  /// the Teams OAuth tokens and AI provider keys — no second encryption mechanism for one more
  /// credential. Null whenever the proxy needs no password, which most do not.
  proxyPasswordCiphertext String?

  lastConnectedAt DateTime?
  lastHeartbeatAt DateTime?

  /// The group list's last sync for THIS account (GROUP_SYNC.md) — each account has its own, so
  /// two numbers syncing never share or overwrite one state. Null status = never synced.
  groupSyncStatus      GroupSyncStatus?
  /// What the sync is doing right now, in words, while RUNNING (e.g. still receiving chats from
  /// a newly linked phone). Null otherwise.
  groupSyncStage       String?
  groupSyncStartedAt   DateTime?
  groupSyncCompletedAt DateTime?
  /// Groups WhatsApp listed on the last pass, and what that pass changed.
  groupSyncDiscovered  Int?
  groupSyncNew         Int?
  groupSyncUpdated     Int?
  groupSyncDeactivated Int?
  /// Groups that could not be saved on the last pass (they are retried by the next one).
  groupSyncFailed      Int?
  groupSyncDurationMs  Int?
  groupSyncError       String?
  sessionDataPath      String?
  /// OpenWA's own session identifier — distinct from `id` because it doubles as part of the
  /// on-disk Chromium profile path (`${sessionDataPath}/_IGNORE_${sessionId}`, see
  /// OpenWAProvider.clearStaleChromiumLock()). The pre-existing account keeps its historical
  /// value (from WHATSAPP_SESSION_NAME) so its already-authenticated session is never orphaned;
  /// new accounts get a fresh one at creation time.
  sessionId            String?
  /// Exactly one account may be true at a time — enforced by a partial unique index added by
  /// hand to this field's migration (`CREATE UNIQUE INDEX ... WHERE "isPrimary" = true`), not
  /// expressible in the Prisma schema DSL directly. See also the transactional service-layer
  /// guard in setPrimaryAccount() (apps/web/src/server/actions/accounts.ts).
  isPrimary            Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  groups               WhatsAppGroup[]
  messages             Message[]
  outboundMessages     OutboundMessage[]
  broadcastJobs        GroupBroadcastJob[]
  participantAddJobs   GroupParticipantAddJob[]
  adminPromotionJobs   GroupAdminPromotionJob[]
  media                MessageMedia[]
  supportEpisodes      SupportResponseEpisode[]
  moodEvents           CustomerMoodEvent[]
  moodAlerts           MoodAlert[]
  processingCheckpoint ProcessingCheckpoint?
  collectionGaps       CollectionGap[]
  escalationCases      SupportEscalationCase[]
  workerCommands       WorkerCommand[]
  notifications        Notification[]
  serviceRoutes        WhatsAppServiceRoute[]
  conversationSessions ConversationSession[]
  supportActivities    SupportActivity[]
  supportSessions      SupportSession[]
  aiFallbackDecisions  AiFallbackDecision[]
  attendanceEvidence   TeamAttendanceGroup[]
  droppedMessages      MessageDropCounter[]
  scopedKnowledge      AiKnowledgeItem[]        @relation("AiKnowledgeScopeAccount")
}

/// One row per WhatsAppServiceKey (seeded lazily, like every other settings model in this app —
/// see resolveWhatsAppAccount() in packages/db/src/whatsappRouting.ts). accountId null means
/// "use Primary" — the default, and the only state that exists until an admin explicitly picks
/// a specific account for a service.
model WhatsAppServiceRoute {
  serviceKey     WhatsAppServiceKey
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId      String                 @default(dbgenerated("project_id_required()"))
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId      String?
  account        WhatsAppAccount?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fallbackPolicy WhatsAppFallbackPolicy @default(PRIMARY_FALLBACK)
  enabled        Boolean                @default(true)
  updatedAt      DateTime               @updatedAt

  @@id([projectId, serviceKey])
}

/// A folder in the chat inbox — "Billing", "VIP clients", "Escalated", whatever the team needs.
///
/// Shared rather than per-user, deliberately. A support team looks at one inbox together, and
/// per-operator folders would mean every person curating 1,848 groups from scratch and nobody
/// able to say "it's in Billing" and be understood. The cost is that one person's reorganisation
/// is everyone's, which is the same trade the Groups page already makes.
/// A reply an operator sends often enough to be worth keeping — "payment confirmed", "checking
/// with the team", the four sentences everybody retypes twenty times a day.
///
/// Deliberately NOT the knowledge base. AiKnowledgeItem is what the assistant answers customers
/// from and carries a human-verification gate for exactly that reason; this is shorthand a person
/// picks and sends themselves. Feeding one into the other would put unreviewed operator shorthand
/// into the assistant's mouth, and put a customer-facing claim into a list people edit casually.
/// A saved selection of groups — "All Premium Clients", "Night Shift", the hundred you pick every
/// time there is maintenance.
///
/// A SNAPSHOT of ids, not a live rule, and the distinction matters because both are useful and
/// this app now has each. A ChatCategory is the living version: put a group in "Premium" and it is
/// in every future Premium send automatically. A saved set is the frozen version: exactly the
/// groups you chose that day, which is what you want when the selection was a judgement rather
/// than a property — "the ones affected by the Dhaka outage" is not a category anybody maintains.
///
/// The cost of a snapshot is that it goes stale, so loading one reports what no longer resolves
/// rather than silently sending to fewer groups than the name implies.
model SavedGroupSet {
  id        String  @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String  @default(dbgenerated("project_id_required()"))
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name      String

  /// WhatsAppGroup ids. Not a relation: a set survives a group being deleted or resynced away,
  /// and reports the gap at load time instead of quietly shrinking through a cascade.
  groupIds String[]

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, name])
}

model SavedReply {
  id        String  @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String  @default(dbgenerated("project_id_required()"))
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// What it is called in the picker — short, since it is scanned rather than read.
  title     String

  /// The text inserted into the composer. Never sent on its own: it lands in the box for the
  /// operator to adjust and send, because a saved reply is a starting point and the last word on
  /// whether it fits this customer belongs to the person looking at the conversation.
  body String

  /// Sort order in the picker, lowest first.
  position Int @default(0)

  /// How many times it has been inserted. Sorting by this beats alphabetical after a week — the
  /// four everybody uses rise to the top on their own rather than needing to be dragged there.
  usageCount Int @default(0)

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position])
}

model ChatCategory {
  id        String  @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String  @default(dbgenerated("project_id_required()"))
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// Unique so two people cannot create "Billing" twice and split the same groups across both.
  name      String

  /// One of a fixed palette (see packages/shared/src/chatCategories.ts). A colour rather than an
  /// icon because the list is scanned down the left edge, where a 10px dot reads and a glyph does not.
  color String @default("gray")

  /// Sidebar order, lowest first. Explicit rather than alphabetical: the categories a team uses
  /// hourly should sit above the ones they use monthly, and alphabetical cannot express that.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups WhatsAppGroup[]

  @@unique([projectId, name])
  @@index([position])
}

model WhatsAppGroup {
  id                          String              @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId                   String              @default(dbgenerated("project_id_required()"))
  project                     Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId                   String
  account                     WhatsAppAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  whatsappGroupId             String // WhatsApp chat id, e.g. "1234567890-1234567890@g.us"
  name                        String
  isMonitored                 Boolean             @default(false)
  /// False once a resync's getAllGroups() no longer returns this group (account left/removed) —
  /// soft-deactivation only, never deleted, so Message history keeps a valid groupId FK.
  isActive                    Boolean             @default(true)
  /// Best-effort, fetched on demand (never during bulk sync — too expensive across hundreds of
  /// real groups) — null until an admin explicitly requests it for this group.
  participantCount            Int?
  lastSyncedAt                DateTime?
  /// Null = no priority tier assigned — Priority-Based Support Monitoring never triggers for this
  /// group (matches today's exact behavior; the feature is entirely opt-in per group).
  priority                    SupportPriority?
  assignedTeamMemberId        String?
  assignedTeamMember          InternalTeamMember? @relation(fields: [assignedTeamMemberId], references: [id], onDelete: SetNull)
  /// Independent kill switch from `priority` itself — lets an admin keep the priority tier
  /// assigned but temporarily pause escalation for this one group without clearing it.
  escalationMonitoringEnabled Boolean             @default(true)
  /// Opt-in for the Hybrid AI Automation fallback layer — mirrors escalationMonitoringEnabled's
  /// per-group-toggle shape. Default false: under AiAutomationScope.PER_GROUP a group must be
  /// explicitly enabled in addition to being isMonitored and the global AiSettings gates being
  /// on, before AI ever fires for it. Ignored under ALL_MONITORED_GROUPS — use
  /// aiAutomationExcluded to hold a group back in that mode.
  aiAutomationEnabled         Boolean             @default(false)

  /// Testing mode: exempt this group from the anti-spam THROTTLES so every kind of message and
  /// rule can be exercised back-to-back without waiting out a cooldown or a per-hour cap.
  ///
  /// It relaxes exactly four things: rule/AI cooldowns, per-client limits, global rate limits, and
  /// the randomised human-like reply delay. It also lets rule types that SAFE_AUTO_REPLY would
  /// hold back run here, since otherwise most rule types can never be exercised at all.
  ///
  /// It deliberately does NOT bypass anything on this project's own "must stay active during
  /// test-group testing" list: the kill switch, MANUAL_ONLY, the monitored-group requirement,
  /// group membership verification, the outbound queue, idempotency, account isolation or loop
  /// prevention. Nor the AI's business-question guard, which is not configurable by design.
  ///
  /// Meant only for the approved test groups. Rate limits are what keep the WhatsApp number from
  /// being banned, and the number serving these test groups also serves every real customer.
  testModeEnabled         Boolean   @default(false)
  /// A hard "never let AI answer here", honoured under every scope. For the groups where a
  /// wrong answer costs more than a slow one — a key account, a billing dispute, anywhere a
  /// human must always speak. Beats every other AI gate.
  aiAutomationExcluded    Boolean   @default(false)
  /// Hybrid AI Automation (Slice 3) human-takeover: set to now + AiSettings.
  /// humanTakeoverCooldownMinutes whenever a team member sends a message in this group (see
  /// processIncomingMessage.ts); the AI fallback layer treats a future value here as a silent
  /// ineligibility gate (apps/worker/src/aiFallback/eligibility.ts) — "AI must not immediately
  /// interfere" once a human is actively handling the conversation. Null means not suppressed.
  aiSuppressedUntil       DateTime?
  /// Knowledge builder: when this group's conversation was last distilled into knowledge
  /// entries, and the timestamp of the newest message that run covered. The pair is the
  /// incremental watermark — a later run only reads what arrived after it, so re-running
  /// is cheap and never re-reads the same conversation twice.
  knowledgeBuiltAt        DateTime?
  knowledgeBuiltThroughAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  /// Chat-inbox organisation. All three are about what an operator SEES; none of them changes what
  /// automation does. That separation is the whole point: `isMonitored` and `aiAutomationEnabled`
  /// decide whether the robot works here, and somebody tidying their inbox must never be able to
  /// silently switch the robot off in a customer's group.
  chatCategoryId String?
  chatCategory   ChatCategory? @relation(fields: [chatCategoryId], references: [id], onDelete: SetNull)

  /// Pinned to the top of the chat inbox. A timestamp rather than a boolean so the pin order is
  /// stable and expressible — most recently pinned first, rather than whatever the name sort gives.
  chatPinnedAt DateTime?

  /// Hidden from the chat inbox. Explicitly NOT unmonitoring: a group can be archived out of
  /// somebody's view while AI keeps answering in it, which is exactly what an operator means by
  /// "I don't need to watch this one". Conflating the two would stop automation in a live
  /// customer conversation as a side effect of tidying up.
  chatArchivedAt DateTime?

  /// When somebody last opened this conversation in the chat inbox. Drives the "waiting" filter:
  /// a customer message newer than this is still waiting, one older than it has been looked at.
  ///
  /// A timestamp rather than a boolean, and that is the whole design. "Reviewed" cannot be a flag
  /// somebody clears by hand, because the next customer message has to put the conversation back
  /// in front of the team automatically — otherwise one glance would bury a conversation forever
  /// and this becomes a way to lose customers rather than a way to find them.
  ///
  /// Shared, like the category and the pin, not per-user: a support team works one inbox together,
  /// and "somebody has already looked at this" is precisely what the second person needs to know.
  ///
  /// Deliberately NOT read by getGroupsAwaitingReply() in the Support Activity reports. That
  /// number answers "which customers has nobody answered", and reading this there would let a lead
  /// clear the backlog by scrolling through it.
  chatReviewedAt DateTime?

  messages               Message[]
  knowledgeItems         AiKnowledgeItem[]
  broadcastMessages      OutboundMessage[]
  participantAddItems    GroupParticipantAddItem[]
  adminPromotionItems    GroupAdminPromotionItem[]
  media                  MessageMedia[]
  supportEpisodes        SupportResponseEpisode[]
  moodEvents             CustomerMoodEvent[]
  moodAlerts             MoodAlert[]
  escalationCases        SupportEscalationCase[]
  conversationSessions   ConversationSession[]
  supportActivities      SupportActivity[]
  supportSessions        SupportSession[]
  supportRuleScopes      SupportRuleGroup[]
  aiFallbackDecisions    AiFallbackDecision[]
  attendanceEvidence     TeamAttendanceGroup[]
  sandboxSessions        SandboxSession[]
  conversationCandidates ConversationCandidate[]

  @@unique([accountId, whatsappGroupId])
  @@index([chatCategoryId])
  @@index([accountId, isActive])
  @@index([accountId, isMonitored])
  /// "Every monitored, active group", with no account filter — what the rewritten awaiting-reply
  /// query drives its LATERAL from, and what the Overview and Team Performance both read. Both
  /// indexes above lead with accountId and cannot answer it.
  @@index([isMonitored, isActive])
}

model InternalTeamMember {
  id              String           @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId       String           @default(dbgenerated("project_id_required()"))
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name            String
  phoneNumber     String
  /// The opaque identifier WhatsApp actually puts on this person's messages.
  ///
  /// WhatsApp migrated group participants to "LID" (linked id) — a 14-15 digit number that is
  /// deliberately NOT the phone number, so a member's real number never appears on their messages
  /// in a group. Matching on phone number alone therefore stopped working entirely: every
  /// colleague was processed as a customer again, which is the same class of outage the JID fix
  /// addressed, from a different cause.
  ///
  /// Nullable and additive: a member added by phone number still matches by phone number, and one
  /// picked out of message history matches by this. Editing the phone number to the person's real
  /// one never breaks matching, because this keeps working.
  whatsappId      String?
  /// The person's designation / job title (Support Executive, CTO, ...). Free text, shown as
  /// "Designation" in the UI; the column keeps its original name so nothing reading it changes.
  role            String
  department      String?
  status          TeamMemberStatus @default(ACTIVE)
  /// The Team this person belongs to NOW — a convenience copy of their open `TeamMembership`, kept
  /// in the same transaction. Reports never read it for history; they read the memberships.
  teamId          String?
  team            Team?            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  teamMemberships TeamMembership[]
  /// Maps this team member to their Microsoft Teams sender identity (Graph API messages carry an
  /// email/UPN, not a phone number) — nullable/additive since most team members won't have a
  /// Teams account, or won't be mapped yet. Used only for Issue "handled by" attribution
  /// (apps/worker/src/teams/resolutionEngine.ts); never required for the integration to function.
  microsoftEmail  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  assignedGroups            WhatsAppGroup[]
  assignedEscalationCases   SupportEscalationCase[]
  SupportEscalationSettings SupportEscalationSettings[]
  supportActivities         SupportActivity[]
  startedSupportSessions    SupportSession[]                   @relation("SupportSessionStarted")
  completedSupportSessions  SupportSession[]                   @relation("SupportSessionCompleted")
  supportRuleScopes         SupportRuleTeamMember[]
  notificationPreferences   TeamMemberNotificationPreference[]
  answeredSupportEpisodes   SupportResponseEpisode[]

  /// The shift this person normally works, used to pre-fill a weekly pattern and nothing else.
  ///
  /// Deliberately NOT authoritative for any date: `DutyAssignment` is. Changing somebody's default
  /// must never reach back and rewrite what they already worked, which is why history is
  /// snapshotted onto the assignment rather than read back through this.
  ///
  /// One nullable column here rather than a separate profile table — a second table keyed on the
  /// same person, holding one field, would be a second identity concept for no benefit.
  defaultShiftTemplateId String?
  defaultShiftTemplate   ShiftTemplate? @relation(fields: [defaultShiftTemplateId], references: [id], onDelete: SetNull)

  weeklySchedule        WeeklyScheduleEntry[]
  dutyAssignments       DutyAssignment[]
  dutyAssignmentChanges DutyAssignmentChange[]
  leaveRequests         LeaveRequest[]
  attendanceDays        TeamAttendanceDay[]

  @@unique([projectId, phoneNumber])
  @@unique([projectId, whatsappId])
  @@unique([projectId, microsoftEmail])
  @@index([teamId])
}

/// An organisational Team (Support, Billing, Commercial...). Nothing hardcodes a Team's name: they
/// are rows an admin creates on the Teams page, and the Team Report filters on them.
///
/// A Team is never deleted while any membership — current or past — points at it: that history is
/// what lets last month's report still say who was in Support last month. Disable it instead.
model Team {
  id          String     @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId   String     @default(dbgenerated("project_id_required()"))
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name        String
  code        String?
  description String?
  status      TeamStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  members         InternalTeamMember[]
  memberships     TeamMembership[]
  supportEpisodes SupportResponseEpisode[]

  @@unique([projectId, name])
  @@unique([projectId, code])
}

/// One stretch of a person belonging to a Team. Changing someone's Team closes their open row
/// (`endedAt`) and opens a new one, so a report for a past period attributes their work to the Team
/// they were in at the time rather than the one they are in today.
///
/// `startedAt` null means "since before Teams were recorded": somebody's FIRST Team counts back over
/// their whole history, so assigning Teams today makes past reports filterable immediately instead
/// of empty. Only a later change is dated.
///
/// Rows rather than a column so multi-team membership can be added later without a migration;
/// today the app keeps at most one open row per person.
model TeamMembership {
  id           String             @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId    String             @default(dbgenerated("project_id_required()"))
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  teamMemberId String
  teamMember   InternalTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime           @default(now())

  @@index([teamMemberId])
  @@index([teamId])
}

model Message {
  id                String           @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId         String           @default(dbgenerated("project_id_required()"))
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId         String
  account           WhatsAppAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId           String?
  group             WhatsAppGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  whatsappMessageId String
  chatId            String
  senderPhone       String
  senderName        String?
  isFromTeamMember  Boolean          @default(false)
  direction         MessageDirection
  body              String
  normalizedBody    String
  timestampWa       DateTime
  receivedAt        DateTime         @default(now())
  isDuplicate       Boolean          @default(false)
  processingStatus  ProcessingStatus @default(PENDING)
  createdAt         DateTime         @default(now())

  /// Set by the (separate, off-by-default) Conversation Learning segmentation job — never written
  /// by the message pipeline itself. Null for every message until that job processes it, and for
  /// every message ever if LearningSettings.conversationLearningEnabled stays false.
  conversationSessionId String?
  conversationSession   ConversationSession? @relation(fields: [conversationSessionId], references: [id], onDelete: SetNull)

  /// Resolved from the WhatsApp "quoted message" (swipe-to-reply) reference, only when the quoted
  /// message is itself already tracked in this table — null if the reply quotes a message from
  /// before this account was tracked, or if the message isn't a reply at all. Powers Support
  /// Activity Tracking's REPLY_TO_CUSTOMER trigger type. SetNull (not Cascade) so deleting the
  /// quoted message never deletes the message that quoted it.
  quotedMessageId  String?
  quotedMessage    Message?  @relation("MessageQuote", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotedByMessages Message[] @relation("MessageQuote")
  /// Digits-only phone numbers @-mentioned in this message (from WhatsApp's mentionedJidList).
  /// Powers Support Activity Tracking's MENTION trigger type.
  mentionedPhones  String[]  @default([])

  executions               AutomationExecution[]
  outboundReplies          OutboundMessage[]
  notifications            Notification[]
  triggeredEscalationCases SupportEscalationCase[]    @relation("EscalationTriggerMessage")
  patternCandidateEvidence PatternCandidateEvidence[]
  supportActivity          SupportActivity?
  aiFallbackDecision       AiFallbackDecision?
  /// The attachment this message carried, when it carried one (MEDIA_STORAGE.md). Text is the
  /// message row itself and is always stored; only the file is optional.
  media                    MessageMedia?
  moodEvent                CustomerMoodEvent?
  /// Support-response episodes this message started, last extended, or answered (SUPPORT_RESPONSE.md).
  episodesStarted          SupportResponseEpisode[]   @relation("SupportResponseFirstIncoming")
  episodesExtended         SupportResponseEpisode[]   @relation("SupportResponseLatestIncoming")
  episodesAnswered         SupportResponseEpisode[]   @relation("SupportResponseReply")

  @@unique([accountId, whatsappMessageId])
  @@index([chatId, timestampWa])
  @@index([groupId, timestampWa])
  @@index([processingStatus])
  /// Pattern detection reads a session's messages in send order; the bare conversationSessionId
  /// index left Postgres sorting every time. This compound covers both shapes.
  @@index([conversationSessionId, timestampWa])
  @@index([quotedMessageId])
  @@index([senderPhone])
  /// The All Messages page orders by timestampWa with no other filter, and the Overview's
  /// "recent messages" panel does the same — both were full scan + top-N sort without this.
  @@index([timestampWa])
  /// Dashboard message-volume counts filter direction + a createdAt window.
  @@index([direction, createdAt])
  /// Team Management recomputes one member's attendance for one local day on every group message
  /// they send: "this sender, between these two instants". The bare [senderPhone] index made that
  /// walk every message that sender has ever sent and filter by date afterwards, which grows
  /// without limit; this stops at the day.
  @@index([senderPhone, timestampWa])
  /// "The newest message this account stored", which is the collection watchdog's own question and
  /// the one the Overview's collection-health entry asks per account.
  ///
  /// Without it that read is a backward walk of the global [timestampWa] index discarding every
  /// row belonging to another account — pathologically slow exactly when an account has been
  /// silent for a long time, which is the only condition it exists to detect. The check meant to
  /// find an outage got slower the worse the outage was.
  @@index([accountId, timestampWa])
}

model AutomationRule {
  id              String     @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId       String     @default(dbgenerated("project_id_required()"))
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name            String
  description     String?
  type            RuleType
  matchType       MatchType
  matchValue      String? // exact/contains/regex pattern; unused for KEYWORDS/ALWAYS
  keywords        String[]   @default([]) // used when matchType = KEYWORDS
  conditions      Json       @default("{}") // RuleConditions (packages/shared)
  actions         Json       @default("[]") // RuleAction[] (packages/shared)
  priority        Int        @default(0)
  status          RuleStatus @default(DRAFT)
  cooldownSeconds Int?
  replyMessage    String?
  replyDelayMinMs Int?
  replyDelayMaxMs Int?
  executionCount  Int        @default(0)
  lastExecutedAt  DateTime?
  createdById     String?
  createdBy       User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  executions       AutomationExecution[]
  outboundMessages OutboundMessage[]
  notifications    Notification[]
  ruleProposal     RuleProposal?

  @@index([status, priority])
}

model AutomationExecution {
  id              String          @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId       String          @default(dbgenerated("project_id_required()"))
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  messageId       String
  message         Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  ruleId          String?
  rule            AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  matchedAt       DateTime        @default(now())
  actionsExecuted Json // ActionType[] actually executed (post-idempotency-check)
  decision        String // final pipeline decision, e.g. "IGNORE" | "AUTO_REPLY" | "SUPPORT_REQUIRED" | "NO_MATCH"
  reasonTrace     Json // explainable trace: rules evaluated, matched, skipped, why
  idempotencyKey  String          @unique
  createdAt       DateTime        @default(now())

  @@index([messageId])
  @@index([ruleId])
}

model OutboundMessage {
  id               String                @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId        String                @default(dbgenerated("project_id_required()"))
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId        String
  account          WhatsAppAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId           String
  toPhone          String
  body             String
  relatedMessageId String?
  relatedMessage   Message?              @relation(fields: [relatedMessageId], references: [id], onDelete: SetNull)
  ruleId           String?
  rule             AutomationRule?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  /// Contact ids to @mention when this is sent. Empty for almost everything — set only by the AI
  /// handover mention, which tags a team member inside the customer's own group so a human is
  /// pulled into the conversation rather than told about it somewhere else.
  mentions         String[]              @default([])
  actionType       ActionType
  idempotencyKey   String                @unique
  status           OutboundMessageStatus @default(PENDING)
  scheduledAt      DateTime              @default(now())
  attemptCount     Int                   @default(0)
  lastAttemptAt    DateTime?
  sentAt           DateTime?
  failureReason    String?
  delayMs          Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  /// Set by the two paths that target a group directly: GROUP_BROADCAST (Group Message Sender) and
  /// MANUAL_REPLY (the chat inbox, which needs it to show a queued bubble in the right thread).
  /// Null for automation-generated rows, which are addressed by chatId/toPhone instead.
  /// Note this is the SEND QUEUE's group link — distinct from Message.groupId, which is set on both
  /// Message write paths (the incoming message, and WhatsApp's echo of our own send).
  groupId           String?
  group             WhatsAppGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Group name at send time, independent of the group later being renamed/removed.
  groupNameSnapshot String?
  broadcastJobId    String?
  broadcastJob      GroupBroadcastJob? @relation(fields: [broadcastJobId], references: [id], onDelete: SetNull)
  providerMessageId String?
  createdById       String?
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  aiFallbackDecision AiFallbackDecision?

  @@index([status, scheduledAt])
  @@index([toPhone, sentAt])
  @@index([sentAt])
  @@index([broadcastJobId, status])
  @@index([groupId, status])
  @@index([relatedMessageId])
  /// The global rate-limit check's exact WHERE shape (accountId + status SENT + sentAt window),
  /// run several times per outbound send.
  @@index([accountId, status, sentAt])
  /// The chat inbox polls every four seconds and asks two questions per poll that both start
  /// "the newest outbound rows for these chats": which conversations have a queued reply (so an
  /// answered one stops showing as waiting) and which queued bubbles to render. `chatId` had no
  /// index at all, so each of those was a sequential scan of a table that only ever grows.
  @@index([chatId, createdAt])
  /// Support Intelligence joins an outgoing Message to the send it echoes (actor attribution).
  @@index([providerMessageId])
  /// WhatsApp Chat User Activity: one project's manual sends over a period.
  @@index([projectId, actionType, createdAt])
}

/// One row per "send this message to these groups" batch created through the
/// Group Message Sender. Each target group becomes its own OutboundMessage
/// row (actionType = GROUP_BROADCAST) reusing the existing outbound queue —
/// this row is only the batch header: who requested it, the safety
/// configuration it was queued under, and its own stop/kill-switch state.
model GroupBroadcastJob {
  id                  String                  @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId           String                  @default(dbgenerated("project_id_required()"))
  project             Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId           String
  account             WhatsAppAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdById         String?
  createdBy           User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  source              GroupBroadcastSource
  /// Fallback message used for any target group that didn't supply its own
  /// per-row message (e.g. from the Excel "Message" column).
  defaultMessage      String
  status              GroupBroadcastJobStatus @default(QUEUED)
  /// Snapshot of how many groups were queued vs. skipped before sending even
  /// started (unmatched/ambiguous Excel rows, duplicate rows, cooldown
  /// skips) — kept distinct from the OutboundMessage-level SKIPPED status,
  /// which is for a queued row skipped at send time (e.g. failed membership
  /// check).
  totalRequested      Int                     @default(0)
  queuedCount         Int                     @default(0)
  preQueueSkipped     Int                     @default(0)
  /// [{ groupName: string, reason: string }] — rows that never became a
  /// queue item at all, so there is no OutboundMessage row to show why.
  preQueueSkipReasons Json                    @default("[]")
  delayMinMs          Int
  delayMaxMs          Int
  maxPerMinute        Int
  maxPerJob           Int
  retryMaxAttempts    Int
  createdAt           DateTime                @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?

  messages OutboundMessage[]

  @@index([accountId, createdAt])
  @@index([status])
}

/// Singleton row (id is always the literal string "global"), analogous to
/// AutomationSettings but scoped to manual Group Message Sender jobs so
/// tuning bulk-send safety never touches automation's own limits.
model GroupBroadcastSettings {
  id                            String   @id @default("global")
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId                     String   @unique @default(dbgenerated("project_id_required()"))
  project                       Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  delayMinMs                    Int      @default(5000)
  delayMaxMs                    Int      @default(15000)
  maxPerMinute                  Int      @default(6)
  maxPerJob                     Int      @default(200)
  retryMaxAttempts              Int      @default(2)
  /// A group that already received a SENT broadcast within this window is
  /// skipped (not re-queued) by a new job — duplicate-send protection beyond
  /// same-job idempotency.
  duplicateGroupCooldownMinutes Int      @default(60)
  updatedAt                     DateTime @updatedAt
}

/// Batch header for the "Add to Groups" module: one phone number, added to
/// N groups (all synchronized groups for the account, or a manual
/// selection). Deliberately its own model rather than reusing
/// GroupBroadcastJob/OutboundMessage — adding a participant is a distinct
/// WhatsApp action with its own (notably stricter) ban-risk profile, so its
/// throttling must be tunable independently (see GroupParticipantAddSettings).
model GroupParticipantAddJob {
  id                  String                       @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId           String                       @default(dbgenerated("project_id_required()"))
  project             Project                      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId           String
  account             WhatsAppAccount              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdById         String?
  createdBy           User?                        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Normalized digits-only phone numbers (no "+", no leading zeros beyond the country code).
  /// One job adds several people across several groups: the work is (every number x every group),
  /// one GroupParticipantAddItem each. Was a single `phoneNumber` — adding a support roster to a
  /// set of groups meant one job per person, and the per-job rate limit made those safe only if
  /// you also remembered to run them one at a time.
  phoneNumbers        String[]                     @default([])
  status              GroupParticipantAddJobStatus @default(QUEUED)
  /// Snapshot of how many groups were requested vs. skipped before queueing even started
  /// (e.g. "all groups" resolved to zero active groups) — distinct from a per-item FAILED result.
  totalRequested      Int                          @default(0)
  queuedCount         Int                          @default(0)
  preQueueSkipped     Int                          @default(0)
  preQueueSkipReasons Json                         @default("[]")
  delayMinMs          Int
  delayMaxMs          Int
  maxPerMinute        Int
  maxPerJob           Int
  retryMaxAttempts    Int
  createdAt           DateTime                     @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?

  items GroupParticipantAddItem[]

  @@index([accountId, createdAt])
  @@index([status])
}

model GroupParticipantAddItem {
  id                String                        @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId         String                        @default(dbgenerated("project_id_required()"))
  project           Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  jobId             String
  job               GroupParticipantAddJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  groupId           String
  group             WhatsAppGroup                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupNameSnapshot String
  /// Which number this row adds. On the item rather than only the job, because one job now covers
  /// several people and each (person, group) pair succeeds or fails on its own.
  phoneNumber       String
  status            GroupParticipantAddItemStatus @default(PENDING)
  attemptCount      Int                           @default(0)
  failureReason     String?
  /// WhatsApp's own code for what happened, kept beside the prose rather than buried inside it.
  /// `failureReason` is written for a person and has always been the only record, so "how many
  /// adds did privacy settings block this week" was not a question the data could answer. The
  /// numeric codes come from AddParticipantError (409 already in group, 403 privacy settings, 408
  /// recently left, 500 group full); the string ones are WhatsApp's own
  /// (INSUFFICIENT_PERMISSIONS, NOT_A_CONTACT, GROUP_DOES_NOT_EXIST, NOT_A_GROUP_CHAT).
  failureCode       String?
  /// The participant id this number resolved to, when the check could establish one. Stored
  /// because a roster may identify people by LID — an opaque id that is deliberately not a phone
  /// number — and without keeping what we actually matched on, a later reader cannot tell a
  /// verified absence from an unverifiable one.
  whatsappId        String?
  /// When the membership check last ran for this pair. A retry re-checks rather than re-attempts,
  /// so this is what says whether the answer being acted on is fresh.
  checkedAt         DateTime?
  scheduledAt       DateTime                      @default(now())
  processedAt       DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@unique([jobId, groupId, phoneNumber])
  @@index([status, scheduledAt])
  /// The check loop claims by job so one job's roster reads stay together — reading a group's
  /// roster once serves every number in that job, and scattering the claims would re-read it.
  @@index([jobId, status])
}

/// WhatsApp Groups Admin Maker job lifecycle (GROUP_ADMIN_MAKER.md).
enum GroupAdminPromotionJobStatus {
  /// Asking WhatsApp which groups this account administers. Nothing is changed in this phase.
  CHECKING
  /// Working through the groups this account administers, one at a time, paced.
  RUNNING
  /// The account was not connected when the next group came up. Nothing is lost: the groups not
  /// yet processed stay PENDING, and Resume carries on from there once the account is back.
  PAUSED_DISCONNECTED
  /// The automation kill switch was off when the next group came up — the same stop the Add Number
  /// to Groups module honours. Resume carries on once it is back on.
  STOPPED_KILL_SWITCH
  COMPLETED
  /// The job could not run at all — e.g. WhatsApp would not say which groups this account
  /// administers, and promoting without knowing that is exactly what this feature must never do.
  FAILED
  CANCELLED
}

/// The result for one group. Every row of a finished job carries exactly one of these.
enum GroupAdminPromotionItemStatus {
  /// Not decided yet.
  PENDING
  /// The target was a member and is now an admin, confirmed by reading the admin list back.
  PROMOTED
  /// The target was already an admin; nothing was attempted.
  ALREADY_ADMIN
  /// The target is not a member of this group. Never added — this feature only promotes.
  NOT_MEMBER
  /// This account is not an admin of the group, so nothing may be attempted there.
  NOT_ACCOUNT_ADMIN
  /// The member list identifies some people by an internal WhatsApp id (LID) rather than a phone
  /// number, so whether the target is a member could not be confirmed. Nothing was attempted:
  /// promoting by phone number cannot reach a member WhatsApp only lists by LID.
  CANNOT_VERIFY
  /// The group is no longer active for this account, or WhatsApp says it does not exist.
  GROUP_UNAVAILABLE
  /// The read or the promotion failed; `reason` holds WhatsApp's answer.
  FAILED
}

/// One run of the WhatsApp Groups Admin Maker: make ONE existing member an admin in every group
/// where this account is an admin. It never adds anybody to a group.
model GroupAdminPromotionJob {
  id           String                       @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId    String                       @default(dbgenerated("project_id_required()"))
  project      Project                      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId    String
  account      WhatsAppAccount              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?                        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// The member to promote, digits only with country code ("8801…").
  phoneNumber  String
  status       GroupAdminPromotionJobStatus @default(CHECKING)
  /// Every active group of the account when the job was created.
  totalGroups  Int                          @default(0)
  /// Groups this account administers, known once CHECKING finishes.
  adminGroups  Int?
  /// Why the job stopped, paused or failed, in words an operator can act on.
  statusReason String?
  createdAt    DateTime                     @default(now())
  startedAt    DateTime?
  pausedAt     DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  updatedAt    DateTime                     @updatedAt

  items GroupAdminPromotionItem[]

  @@index([accountId, phoneNumber, status])
  @@index([status])
}

model GroupAdminPromotionItem {
  id                String                        @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId         String                        @default(dbgenerated("project_id_required()"))
  project           Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  jobId             String
  job               GroupAdminPromotionJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  groupId           String
  group             WhatsAppGroup                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupNameSnapshot String
  status            GroupAdminPromotionItemStatus @default(PENDING)
  /// Plain-language reason for the result; WhatsApp's own answer for a failure.
  reason            String?
  /// WhatsApp's status code when it gave one (INSUFFICIENT_PERMISSIONS, NOT_A_PARTICIPANT, ...).
  failureCode       String?
  /// Promotion attempts made. Non-zero is what lets a re-run after a crash tell "we promoted them"
  /// from "they were already an admin".
  attemptCount      Int                           @default(0)
  /// Times this group was put back after a failure that may pass (a read that failed, a dropped
  /// page). Separate from attemptCount, which counts promotions only.
  retryCount        Int                           @default(0)
  /// When the last promotion was attempted — the pacing between promotions on one account is read
  /// from this, so it survives a worker restart.
  lastAttemptAt     DateTime?
  scheduledAt       DateTime                      @default(now())
  processedAt       DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@unique([jobId, groupId])
  @@index([jobId, status])
  @@index([status, scheduledAt])
}

/// What kind of file a WhatsApp message carried (MEDIA_STORAGE.md). Derived from WhatsApp's own
/// message type: a GIF is WhatsApp's looping video, a voice note is AUDIO (`waType` keeps "ptt").
/// Locations and contact cards are not files and never get a row.
enum MessageMediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  GIF
  OTHER
}

/// Where one attachment's file stands. A message never depends on it: the row is written after the
/// message, and nothing here can fail the message.
enum MessageMediaStatus {
  /// Waiting for the worker to fetch it.
  PENDING
  /// The worker is fetching it now.
  DOWNLOADING
  /// The original file is in media storage.
  STORED
  /// Deliberately not fetched — the type was switched off, it was over the size limit, or WhatsApp
  /// gave nothing to fetch it with. `statusReason` says which.
  NOT_STORED
  /// Fetching failed for good (WhatsApp no longer has it, or every retry failed).
  FAILED
  /// Was stored, and removed by retention or a manual cleanup. The message text stays.
  DELETED
}

/// One WhatsApp attachment: its metadata in Postgres, its bytes in media storage (never here).
model MessageMedia {
  id                String             @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId         String             @default(dbgenerated("project_id_required()"))
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// One attachment per WhatsApp message (an album arrives as separate messages), so a redelivered
  /// event can never create a second row.
  messageId         String             @unique
  message           Message            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  accountId         String
  account           WhatsAppAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId           String?
  group             WhatsAppGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  mediaType         MessageMediaType
  /// WhatsApp's own type ("image", "ptt", "document", …), kept as it came.
  waType            String
  mimeType          String?
  /// The sender's file name, for display and downloads only. Never part of a storage path.
  fileName          String?
  /// The size WhatsApp announced, before anything was fetched.
  declaredSizeBytes BigInt?
  /// The size actually stored.
  sizeBytes         BigInt?
  /// SHA-256 of the stored file, hex.
  sha256            String?
  width             Int?
  height            Int?
  /// WhatsApp reports whole seconds.
  durationSeconds   Int?
  isAnimated        Boolean            @default(false)
  /// Internal key in media storage. Built from ids only — never a phone number or a file name.
  storageKey        String?            @unique
  /// WhatsApp's own small preview (a JPEG it sends with images and videos), stored beside the
  /// original, never instead of it.
  thumbnailKey      String?            @unique
  status            MessageMediaStatus @default(PENDING)
  /// A short code for NOT_STORED / FAILED / DELETED (SETTING_OFF, TOO_LARGE, EXPIRED, …).
  statusReason      String?
  /// The last error, in words, for an operator.
  lastError         String?
  attemptCount      Int                @default(0)
  /// When the worker may next try. Set from the app's clock on every write that schedules work.
  nextAttemptAt     DateTime           @default(now())
  downloadStartedAt DateTime?
  /// What WhatsApp gave to fetch the file with (its media key, hashes, URL, preview). Cleared once the
  /// row is settled — the stored file needs none of it.
  download          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  storedAt          DateTime?
  deletedAt         DateTime?

  /// The download queue: oldest due PENDING first.
  @@index([status, nextAttemptAt])
  /// Retention and cleanup preview: one project's stored files older than a date, in order.
  @@index([projectId, status, createdAt])
  /// Storage usage: one project's stored files by type.
  @@index([projectId, status, mediaType])
}

/// What media this project stores, and for how long (one row per project). Text is not here: it is
/// always stored.
model MediaStorageSettings {
  id        String  @id @default("global")
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String  @unique @default(dbgenerated("project_id_required()"))
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  /// Each switch decides only whether media arriving FROM NOW ON is fetched. Turning one off
  /// deletes nothing; turning one on recovers nothing.
  storeImages    Boolean @default(true)
  storeVideos    Boolean @default(true)
  storeAudio     Boolean @default(true)
  storeDocuments Boolean @default(true)
  storeStickers  Boolean @default(true)
  storeGifs      Boolean @default(true)
  storeOther     Boolean @default(true)

  /// Stored files older than this many days are removed in the background. Null keeps everything.
  retentionDays Int?

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

enum MediaCleanupTrigger {
  /// An admin asked for it on Settings.
  MANUAL
  /// The project's retention setting.
  RETENTION
}

enum MediaCleanupStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// A background removal of stored media files older than a date, done in batches by the worker.
/// Message rows are never touched: only files, and their media rows marked DELETED.
model MediaCleanupJob {
  id              String              @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId       String              @default(dbgenerated("project_id_required()"))
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  trigger         MediaCleanupTrigger
  status          MediaCleanupStatus  @default(SCHEDULED)
  /// Files whose media row was created before this are removed.
  olderThan       DateTime
  /// RETENTION only: the setting this job was made for. A change to the setting cancels it.
  retentionDays   Int?
  /// Stored files older than `olderThan` when the job started.
  totalCandidates Int?
  processedCount  Int                 @default(0)
  deletedCount    Int                 @default(0)
  failedCount     Int                 @default(0)
  freedBytes      BigInt              @default(0)
  /// Keyset position, so a restart carries on rather than starting over.
  cursorCreatedAt DateTime?
  cursorId        String?
  lastError       String?
  requestedById   String?
  requestedBy     User?               @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([projectId, createdAt])
}

/// Where one group's support-response episode stands (SUPPORT_RESPONSE.md).
enum SupportResponseEpisodeStatus {
  /// A customer has written and no Support Team member has replied since.
  UNANSWERED
  /// A Support Team member replied; the response time is recorded.
  ANSWERED
  /// Dismissed on Messages → Unanswered Groups. Nothing about the conversation was changed.
  CLEARED
}

/// One support-response episode in one group (SUPPORT_RESPONSE.md): from the first customer message
/// after the previous Support Team reply, to the next Support Team reply.
///
/// Built from `Message` rows as they arrive and pointing back at them — no message text is copied.
/// "Support Team" is the Teams named in `SupportActivitySettings.responseTrackingTeamIds`, as they
/// were at the moment of each message (`TeamMembership`). Replies from other Teams, from the business
/// number, from rules and from AI never answer an episode.
///
/// At most one UNANSWERED episode per group row: a partial unique index in the migration enforces
/// it, and the worker decides under a per-group advisory lock.
model SupportResponseEpisode {
  id        String                       @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String                       @default(dbgenerated("project_id_required()"))
  project   Project                      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId String
  account   WhatsAppAccount              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// The account's own row for the group — identity is account + group, never a group name.
  groupId   String
  group     WhatsAppGroup                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status    SupportResponseEpisodeStatus @default(UNANSWERED)

  /// The first customer message of the episode: when the wait started.
  firstIncomingMessageId  String?
  firstIncomingMessage    Message? @relation("SupportResponseFirstIncoming", fields: [firstIncomingMessageId], references: [id], onDelete: SetNull)
  firstIncomingAt         DateTime
  latestIncomingMessageId String?
  latestIncomingMessage   Message? @relation("SupportResponseLatestIncoming", fields: [latestIncomingMessageId], references: [id], onDelete: SetNull)
  latestIncomingAt        DateTime
  /// Customer messages in the episode — one wait, however many lines it took.
  incomingMessageCount    Int      @default(1)

  /// The first Support Team reply after the episode began. Kept as recorded when it happened: a
  /// later Team change, or the member leaving, never rewrites a historical response.
  supportReplyMessageId String?
  supportReplyMessage   Message?            @relation("SupportResponseReply", fields: [supportReplyMessageId], references: [id], onDelete: SetNull)
  supportRepliedAt      DateTime?
  supportMemberId       String?
  supportMember         InternalTeamMember? @relation(fields: [supportMemberId], references: [id], onDelete: SetNull)
  /// The Support Team the member was in when they replied.
  supportTeamId         String?
  supportTeam           Team?               @relation(fields: [supportTeamId], references: [id], onDelete: SetNull)
  /// supportRepliedAt − firstIncomingAt, in whole seconds. Both timestamps are kept, so it can be
  /// recalculated and audited.
  responseSeconds       Int?

  clearedAt       DateTime?
  clearedByUserId String?
  clearedBy       User?     @relation(fields: [clearedByUserId], references: [id], onDelete: SetNull)
  clearReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Unanswered Groups: one project's open episodes, longest waiting first.
  @@index([projectId, status, firstIncomingAt])
  /// Response Time: one project's answered episodes, newest reply first.
  @@index([projectId, status, supportRepliedAt])
  /// The tracker's "this group's open episode" and "its last answer".
  @@index([groupId, status])
  @@index([supportMemberId, supportRepliedAt])
  @@index([accountId])
}

/// Singleton row (id is always the literal string "global"), analogous to
/// GroupBroadcastSettings but for the Add-to-Groups module. Defaults are
/// deliberately more conservative than GroupBroadcastSettings — WhatsApp
/// treats bulk "add participant" actions as a stronger ban signal than
/// bulk messaging.
model GroupParticipantAddSettings {
  id               String   @id @default("global")
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId        String   @unique @default(dbgenerated("project_id_required()"))
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  delayMinMs       Int      @default(10000)
  delayMaxMs       Int      @default(30000)
  /// Adds per minute across EVERY running job, not per job. It was per job, which meant the
  /// per-job size cap actively created the danger it looked like it was preventing: an operator
  /// with 2,000 groups had to split them into twenty jobs, and twenty jobs running at once ran at
  /// twenty times this rate on the single operation WhatsApp punishes hardest.
  maxPerMinute     Int      @default(3)
  /// Ceiling on (numbers x groups) queued by one job. Now that the rate limit is global, this
  /// bounds a single mistake rather than the sending rate — a large job simply takes longer.
  maxPerJob        Int      @default(2000)
  retryMaxAttempts Int      @default(1)
  updatedAt        DateTime @updatedAt
}

model Notification {
  /// Why this was sent. Nullable because rows written before the Notification Center existed have
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId                 String             @default(dbgenerated("project_id_required()"))
  project                   Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// no event to attribute, and guessing one from the payload would be a fabrication.
  event                     NotificationEvent?
  id                        String             @id @default(cuid())
  type                      NotificationType
  /// Which WhatsApp account this was (or will be) sent through — only meaningful for
  /// type=WHATSAPP; null for TEAMS. Nullable so pre-existing history stays valid, and so a
  /// deleted account's audit trail survives (onDelete: SetNull, not Cascade).
  accountId                 String?
  account                   WhatsAppAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  destination               String
  relatedMessageId          String?
  relatedMessage            Message?           @relation(fields: [relatedMessageId], references: [id], onDelete: SetNull)
  relatedRuleId             String?
  relatedRule               AutomationRule?    @relation(fields: [relatedRuleId], references: [id], onDelete: SetNull)
  /// Set only for Conversation Learning's Unknown Pattern alerts — lets the dashboard list every
  /// alert ever sent for a given PatternCandidate without duplicating pattern data onto this row.
  relatedPatternCandidateId String?
  relatedPatternCandidate   PatternCandidate?  @relation(fields: [relatedPatternCandidateId], references: [id], onDelete: SetNull)
  payload                   Json
  status                    NotificationStatus @default(PENDING)
  attemptCount              Int                @default(0)
  lastAttemptAt             DateTime?
  sentAt                    DateTime?
  failureReason             String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  escalationEvents   SupportEscalationEvent[]
  aiFallbackDecision AiFallbackDecision?

  @@index([status])
  @@index([relatedMessageId])
  @@index([relatedPatternCandidateId])
  @@index([event, createdAt])
}

model WorkerCommand {
  id          String              @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId   String              @default(dbgenerated("project_id_required()"))
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  type        WorkerCommandType
  /// Nullable so pre-multi-account historical rows (created before this column existed) remain
  /// valid, and so account-agnostic command types (AI_ANALYSIS_BATCH) can omit it entirely — every
  /// other, account-scoped command type still always sets this. onDelete: Cascade since a
  /// queued-but-unprocessed command for a deleted account is meaningless.
  accountId   String?
  account     WhatsAppAccount?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payload     Json?
  status      WorkerCommandStatus @default(PENDING)
  result      Json?
  createdAt   DateTime            @default(now())
  /// When this command was claimed — set by `claimNextCommand`, null until then.
  ///
  /// Exists so stuck-command recovery can tell a command that has been running for eleven minutes
  /// from one that died. Recovery used to have no age cutoff at all, justified by "this runs once
  /// at boot" — which stopped being true when it started running every five minutes, at which
  /// point it began marking commands FAILED WHILE THEY WERE STILL RUNNING. A RECONNECT waiting up
  /// to ten minutes for a QR scan, or an eight-minute RESYNC_GROUPS, was reported to the operator
  /// as "the worker restarted while this was running, run it again" — and they did, on top of the
  /// one still going.
  ///
  /// `startedAt` rather than an `updatedAt`: any later write would touch the latter, so it would
  /// answer "when was this row last modified" rather than "how long has this been running", and
  /// only the second question bounds a timeout.
  startedAt   DateTime?
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([accountId, status])
}

/// What every one of the worker's polling loops was last seen doing — the one singleton row
/// (id is always the literal string "global").
///
/// The heartbeat proves that ONE `setInterval` fires. It shares nothing with the other twenty
/// loops, so "the worker is alive" has always meant exactly "the heartbeat's own timer is still
/// scheduled" — which stays true while the outbound queue, the command processor or the registry
/// sync sits wedged on a call into a browser that never answers. Each of those is an
/// overlap-guarded loop whose guard, once stuck, silently turns every later tick into a no-op.
///
/// The worker holds this in memory (health/loopLiveness.ts); this row exists only because the
/// dashboard cannot ask it. There is no HTTP between the two by design, so Postgres is the
/// channel, exactly as it is for account status and WorkerCommand.
///
/// Written once per heartbeat rather than once per tick, deliberately: the command processor runs
/// every 1.5 seconds, and a write per tick would be tens of thousands of rows a day to report that
/// nothing was wrong.
model WorkerHealthSnapshot {
  id        String   @id @default("global")
  /// One entry per loop: name, intervalMs, lastTickAt, ticks. A JSON column because the set of
  /// loops is a property of the code rather than of the data, and a table with one row per loop
  /// would need a migration every time a loop was added or renamed.
  loops     Json     @default("[]")
  /// The worker process this describes, so a snapshot left behind by a previous one is legible as
  /// such rather than read as the current process's silence.
  startedAt DateTime
  updatedAt DateTime @updatedAt
}

model ProcessingCheckpoint {
  id                       String          @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId                String          @default(dbgenerated("project_id_required()"))
  project                  Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId                String          @unique
  account                  WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lastProcessedTimestampWa DateTime?
  lastProcessedMessageId   String?
  updatedAt                DateTime        @updatedAt
}

/// What the catch-up sweep managed for a collection gap.
enum CollectionGapRecovery {
  /// The sweep read the whole gap and stored what WhatsApp still held.
  RECOVERED
  /// The sweep ran but cannot have covered the whole gap: it started after the gap began (the
  /// 12-hour look-back), or it hit its message cap.
  PARTIAL
  /// The sweep could not read the session, or threw. Nothing from the gap is known to be stored.
  FAILED
  /// No sweep was possible — the account had never processed a message, so there was no position
  /// to recover from.
  NOT_ATTEMPTED
}

/// A period one WhatsApp account was not collecting messages (SUPPORT_INTELLIGENCE_IMPLEMENTATION_AUDIT.md
/// §H). Written by the worker: opened when collection stops — the session leaves CONNECTED, the
/// worker restarts, or the watchdog proves the listener deaf — and closed when it resumes, with what
/// the catch-up sweep recovered. Reports read it to say "reporting data may be incomplete between
/// 14:20 and 15:05" instead of calling a quiet group inactive. Recorded from the day this table
/// exists; nothing before it can be reconstructed, which is why reporting has a verified-from date.
model CollectionGap {
  id                  String                 @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId           String                 @default(dbgenerated("project_id_required()"))
  project             Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId           String
  account             WhatsAppAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Why collection stopped: DISCONNECTED, WORKER_RESTART, NOT_COLLECTING, UNREADABLE, or the
  /// connection state that ended the session (AUTHENTICATION_REQUIRED, ...). Text, not an enum:
  /// the set follows the provider's states.
  cause               String
  /// When collection stopped. For a worker restart, the account's last heartbeat; for a deaf
  /// listener, the newest message stored before the silence.
  startedAt           DateTime
  /// When collection resumed. Null while the gap is still open.
  endedAt             DateTime?
  recoveryStatus      CollectionGapRecovery?
  recoveryAttemptedAt DateTime?
  /// The start of the window the sweep read. Later than startedAt means part of the gap was beyond
  /// the sweep's reach.
  recoveredFrom       DateTime?
  recoveredCount      Int                    @default(0)
  recoveryNote        String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([projectId, startedAt])
  @@index([accountId, endedAt])
}

/// Why a message the provider handed over produced no row at all.
enum MessageDropReason {
  /// Nothing to store: a sticker, an image with no caption, a system event, an unsupported type.
  /// Ordinary and constant at a low rate — it is a CHANGE in the rate that means something.
  EMPTY_BODY
  /// The pipeline threw before or during the write, so the message exists nowhere.
  PIPELINE_ERROR
}

/// How many messages this account received and did not store, per reason, per Dhaka day.
///
/// The 18 Sep 2026 outage could not answer its own first question: did messages arrive and get
/// discarded, or never arrive at all? A message that is dropped leaves no row anywhere, and the
/// in-memory `received` counter resets on the restart that is always the first thing tried — so
/// both halves of the question were unanswerable at exactly the moment they mattered.
///
/// A COUNTER, deliberately, not a row per dropped message. The failure worth catching is a change
/// in shape — a WhatsApp update that starts delivering ordinary text in a form this code reads as
/// empty — and that shows up as a spike in a daily number. Storing each one individually would be
/// a second, unbounded message table recording the messages this system understood least.
///
/// It also makes "received" derivable rather than in-memory: received = stored + dropped.
model MessageDropCounter {
  accountId String
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String            @default(dbgenerated("project_id_required()"))
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  account   WhatsAppAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// The Dhaka calendar day, matching every other daily figure in this product.
  day       DateTime          @db.Date
  reason    MessageDropReason
  count     Int               @default(0)
  updatedAt DateTime          @updatedAt

  @@id([accountId, day, reason])
  @@index([day])
}

/// Singleton row (id is always the literal string "global").
model AutomationSettings {
  id                           String         @id @default("global")
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId                    String         @unique @default(dbgenerated("project_id_required()"))
  project                      Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  mode                         AutomationMode @default(SAFE_AUTO_REPLY)
  automationEnabled            Boolean        @default(true)
  /// Per-conversation ceilings. Every message this system sends automatically is a REPLY to an
  /// incoming customer message — it never initiates contact, and loop prevention stops it
  /// answering its own or a colleague's messages. So this number is not "how much can we spam one
  /// person"; it is "how many of this customer's own questions will we answer before going
  /// silent". At the original 3/hour, a customer asking a fourth question got nothing back.
  ///
  /// It still exists to bound a runaway rule or a reply loop, which would fire far faster than a
  /// person can type.
  maxRepliesPerClientPerHour   Int            @default(60)
  maxRepliesPerClientPerDay    Int            @default(500)
  /// Account-wide burst protection across ALL conversations — this is the one that genuinely
  /// guards the WhatsApp number. A ceiling, not a target: real volume is driven by how much
  /// customers message in.
  globalMaxPerMinute           Int            @default(20)
  globalMaxPerHour             Int            @default(600)
  globalMaxPerDay              Int            @default(5000)
  rateLimitingEnabled          Boolean        @default(true)
  defaultReplyDelayMinMs       Int            @default(3000)
  defaultReplyDelayMaxMs       Int            @default(15000)
  retryMaxAttempts             Int            @default(3)
  retryIntervalsMs             Json           @default("[30000,300000,900000]")
  teamsWebhookUrl              String?
  whatsappNotificationGroupIds String[]       @default([])
  updatedAt                    DateTime       @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  /// Set for a project's operational events; null for platform events (worker boot, a login).
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  level     LogLevel
  scope     String
  message   String
  metadata  Json?

  /// WHO did it, TO WHAT, and as part of which request.
  ///
  /// Without these this table records that something happened and nothing about who caused it — so
  /// "who verified this knowledge entry, and when" was unanswerable even though the whole
  /// customer-facing safety gate rests on that approval. Null for the worker's own background
  /// events, which have no actor by definition.
  actorUserId   String?
  actorUser     User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Free strings rather than enums: the set of auditable things grows with the product, and an
  /// enum would mean a migration to record a new kind of action.
  targetType    String?
  targetId      String?
  /// The pipeline's own trace id, so every line belonging to one incoming message groups together.
  correlationId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@index([targetType, targetId])
  @@index([correlationId])
  @@index([actorUserId, createdAt])
}

// ---------------------------------------------------------------------------
// AI Learning & Knowledge System — Phase 1 (foundation only: settings,
// provider/model config, and a manually-curated, versioned Knowledge Base).
// Ingestion (software/chat/document learning, embeddings, duplicate
// detection, AI-generated responses) is deliberately NOT built yet — these
// models exist so later phases have somewhere to write to without another
// migration, per the project's own "do not build everything in one step"
// rule. Activity is logged through the existing SystemLog table (scope
// "ai-learning"), not a parallel audit log.
// ---------------------------------------------------------------------------

enum AiProviderKind {
  ANTHROPIC
  OPENAI
  /// OpenRouter — one key, hundreds of models behind the standard OpenAI
  /// chat-completions protocol. Its own kind rather than OPENAI-with-a-URL so the
  /// provider form can prefill the endpoint and the docs can name it.
  OPENROUTER
  /// A local Ollama (or any other keyless OpenAI-compatible runtime). The only kind
  /// that legitimately has no API key — see AiProvider.apiKeyCiphertext.
  OLLAMA
  GOOGLE
  CUSTOM
}

/// How widely the Hybrid AI Automation fallback is allowed to answer. Both values keep
/// AI strictly reply-triggered and only on a genuine NO_MATCH — the scope decides which
/// groups are eligible, never whether AI outranks a rule that already matched.
/// What the AI is permitted to answer from.
///
/// The distinction this encodes is the important one: a model *knowing* an answer is not the
/// same as this software having the *authority* to give it. A model can describe how billing
/// software generally works; it cannot know how THIS company's billing works, and a fluent guess
/// about a refund window or support hours is worse than no answer at all.
/// Which sources the AI may draw on when answering.
///
/// There are exactly three at answer time, and the modes are their meaningful combinations:
///
///   1. The verified knowledge base. Always available, in every mode. Everything the system
///      learns — from conversations, manual imports, and the scheduled Forge sync — lands here,
///      which is why "conversation learning" is not a mode of its own: it is already in all of
///      them.
///   2. Live research against the product's own source through Forge, at the moment of asking.
///   3. The model's general knowledge, for questions that are not about this company at all.
///
/// The business-question guard sits outside all of this and is not configurable: anything about
/// this company's behaviour, pricing, policies or a customer's account is answered only from
/// verified knowledge, whatever the mode.
enum AiResponseMode {
  /// Nothing verified covers it, nothing gets answered. The safe default.
  STRICT_KNOWLEDGE_ONLY
  /// Verified knowledge, plus reading the product's own source when nothing covers the question.
  /// What it learns is saved, so the same question is answered instantly next time.
  KNOWLEDGE_PLUS_FORGE
  /// General questions ("what is PPPoE?") may be answered from the model's own knowledge, while
  /// anything about this company — its product behaviour, policies, pricing, accounts — still
  /// requires verified knowledge. That second half is not configurable; see AiSettings.
  KNOWLEDGE_PLUS_GENERAL
  /// Everything: verified knowledge, live research against the product source, and general
  /// knowledge for questions that are not about this company.
  KNOWLEDGE_FORGE_GENERAL
}

enum AiAutomationScope {
  /// Today's behaviour: a group must have WhatsAppGroup.aiAutomationEnabled set.
  PER_GROUP
  /// Every monitored group is eligible without per-group opt-in. Groups flagged
  /// WhatsAppGroup.aiAutomationExcluded are still held back.
  ALL_MONITORED_GROUPS
}

enum AiProviderStatus {
  ACTIVE
  INACTIVE
}

/// Which job a model is assigned to — mirrors the spec's "Learning Model /
/// Response Model / Vision Model / Document Model / Embedding Model" split,
/// so a future phase can pick a cheaper/faster model per job without a
/// schema change.
enum AiModelJob {
  LEARNING
  RESPONSE
  VISION
  DOCUMENT
  EMBEDDING
  /// The floating AI Admin Assistant chat widget (read-only tool-calling) — apps/web/src/server/
  /// aiAdmin/. Distinct from RESPONSE (reserved for a future customer-facing auto-response phase)
  /// since these are semantically different consumers that shouldn't share one config slot.
  ADMIN_ASSISTANT
}

enum AiKnowledgeCategory {
  SOFTWARE
  WORKFLOW
  FAQ
  TROUBLESHOOTING
  CUSTOMER_RESPONSE
  SOP
  REQUIREMENT
  FEATURE
  POLICY
  ANNOUNCEMENT
  SCREENSHOT
}

/// How a batch of pasted text or an uploaded document is turned into knowledge entries.
/// Modelled as a job rather than done inline because a manual can be far larger than one
/// model call: it is chunked, each chunk costs an API round trip, and the whole thing has to
/// survive a worker restart and report progress while it runs.
enum KnowledgeImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  /// Some chunks produced entries before a later one failed — whatever was extracted is kept.
  PARTIAL
  FAILED
}

/// Where an import's text came from. Every value converges on the same KnowledgeImport row and
/// the same chunk-and-review pipeline — only the extraction step in front differs, so adding a
/// source is a new extractor plus a value here, never a second pipeline.
enum KnowledgeImportSourceType {
  PASTED_TEXT
  DOCUMENT
  /// A fetched web page (sourceUrl holds the address; re-import is manual, never crawled).
  URL
  PDF
  DOCX
  /// A .csv/.xlsx of question/answer rows, parsed into entries directly with no AI call.
  SPREADSHEET
  /// A file read out of the ISPDIGITAL repository through Softify Forge — either a hand-written
  /// user guide or the source files behind one product module. See apps/worker/src/forge/.
  FORGE_REPO
}

model KnowledgeImport {
  id             String                    @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId      String                    @default(dbgenerated("project_id_required()"))
  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// What this came from, in the operator's words — a file name, or a title they typed.
  /// Copied onto every entry it produces so a reviewer can see the origin without a join.
  label          String
  sourceType     KnowledgeImportSourceType @default(PASTED_TEXT)
  /// The extracted plain text. Kept after processing so a failed or disappointing import can be
  /// re-run against a better prompt without asking anyone to find the original file again.
  rawText        String
  /// Optional module hint applied to every entry produced, e.g. "MikroTik Integration".
  module         String?
  /// For a URL import: the page this text was fetched from. Retained so an operator can re-run
  /// the import when they know the page changed — deliberately manual, there is no crawler.
  sourceUrl      String?
  /// Original upload file name, kept for provenance once rawText has replaced the bytes.
  fileName       String?
  status         KnowledgeImportStatus     @default(PENDING)
  chunksTotal    Int                       @default(0)
  chunksDone     Int                       @default(0)
  entriesCreated Int                       @default(0)
  /// Operator-facing failure text; never a stack trace.
  error          String?
  createdById    String?
  createdBy      User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  items AiKnowledgeItem[]

  @@index([status, createdAt])
}

enum AiKnowledgeStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Singleton row (id is always the literal string "global"). Every switch
/// defaults OFF/conservative, matching AutomationSettings/GroupBroadcastSettings —
/// none of these actually gate anything yet since the learning/response
/// pipelines they're meant to control don't exist until a later phase.
model AiSettings {
  id                              String            @id @default("global")
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId                       String            @unique @default(dbgenerated("project_id_required()"))
  project                         Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  aiEngineEnabled                 Boolean           @default(false)
  learningEnabled                 Boolean           @default(false)
  autoResponseEnabled             Boolean           @default(false)
  /// The Hybrid AI Automation fallback layer's own confidence gate (spec default 90%) — deliberately
  /// separate from learningConfidenceThreshold/autoApprovalThreshold above, which are reserved for
  /// the not-yet-built AI Learning/Knowledge phases and would be an ambiguous field to overload here.
  autoResponseConfidenceThreshold Int               @default(90)
  /// Hybrid AI Automation (Slice 3): reuses the same cooldown mechanism as per-rule AUTO_REPLY
  /// cooldowns (apps/worker/src/queue/cooldown.ts's isCooldownActive(), generalized to accept a
  /// null ruleId) — prevents AI from replying to the same client again too soon. 0 disables it.
  aiReplyCooldownSeconds          Int               @default(300)
  /// Hybrid AI Automation (Slice 3): how long a team-member message suppresses the AI fallback
  /// layer for that group (see WhatsAppGroup.aiSuppressedUntil) — "AI must not immediately
  /// interfere" once a human is actively handling a conversation.
  humanTakeoverCooldownMinutes    Int               @default(30)
  /// Which groups the AI fallback may answer in. Default PER_GROUP preserves the exact
  /// behaviour that shipped before this field existed.
  aiAutomationScope               AiAutomationScope @default(PER_GROUP)
  /// After AI answers a message, draft a reusable AutomationRule from it so the same
  /// question is handled deterministically (and for free) next time. The draft always
  /// lands as a PENDING_REVIEW RuleProposal — never an active rule.
  aiRuleGenerationEnabled         Boolean           @default(false)
  /// Minimum AI confidence before a reply is worth turning into a rule draft. Above the
  /// reply threshold on purpose: answering once at 90% is fine, but codifying that answer
  /// into a standing rule deserves a higher bar.
  aiRuleGenerationMinConfidence   Int               @default(95)

  /// When AI hands a conversation to a person, also post in the customer's own group tagging a
  /// team member, so the request for help appears where the conversation is rather than only in a
  /// separate alerts group. Off by default — it puts an extra message in front of the customer.
  mentionTeamOnHandover           Boolean        @default(false)
  /// When AI hands a customer's message to a person because it had no reliable answer (an image
  /// it cannot see, nothing verified to go on, low confidence, it declined), send the customer a
  /// holding reply saying the support team will follow up. Never for a handover the SYSTEM caused
  /// (rate limits, cooldowns, provider errors) — see packages/shared/src/unableToUnderstand.ts.
  /// Off by default: it puts a message in front of the customer.
  unableToUnderstandReplyEnabled  Boolean        @default(false)
  /// The admin's wording. Null = the built-in default, so Reset forgets the edit rather than
  /// freezing today's default into the row.
  unableToUnderstandReplyText     String?
  /// No second holding reply in the same conversation within this many minutes: somebody sending
  /// five unclear messages in a row hears it once, not five times. 0 = every message.
  unableToUnderstandRepeatMinutes Int            @default(30)
  /// WhatsApp group ids that receive "AI could not handle this, a human is needed" alerts.
  /// Empty falls back to AutomationSettings.whatsappNotificationGroupIds, so existing
  /// deployments keep alerting exactly where they already did.
  takeoverNotifyGroupIds          String[]       @default([])
  /// Read whole group conversations and distil them into knowledge base entries.
  knowledgeFromChatEnabled        Boolean        @default(false)
  /// A group with fewer stored messages than this is skipped by the knowledge builder —
  /// there is not enough conversation there to draw a reliable conclusion from.
  knowledgeMinMessagesPerGroup    Int            @default(25)
  /// What the AI may answer from. STRICT_KNOWLEDGE_ONLY is the default and the safe choice.
  ///
  /// Note what is deliberately NOT configurable: under either mode, a question about this
  /// company's own product, policies or accounts is answered only from verified knowledge, and
  /// otherwise goes to a person. Relaxing the mode widens what counts as answerable *general*
  /// conversation; it never lets the model invent this business's behaviour.
  aiResponseMode                  AiResponseMode @default(STRICT_KNOWLEDGE_ONLY)
  /// The bar for an answer given from the model's own knowledge with nothing verified behind it.
  /// Deliberately separate from, and normally higher than, autoResponseConfidenceThreshold:
  /// an ungrounded answer carries more risk than one backed by the team's own material.
  generalAnswerMinConfidence      Int            @default(90)

  /// The language the AI answers in unless the customer clearly wrote in another one.
  ///
  /// Without a stated default the model infers a language from whatever it was sent, and a
  /// one-word message carries almost no signal: "Hello" was answered in Portuguese and a short
  /// question in transliterated Hindi, to Bengali-speaking customers. A default plus an explicit
  /// "do not switch on weak evidence" rule is what stops that.
  defaultReplyLanguage String @default("Bengali (Bangla)")

  /// Learn HOW the support team writes — tone, greetings, how a problem is acknowledged — from
  /// the replies executives actually send, and apply that to AI answers.
  ///
  /// Distinct from knowledgeFromChatEnabled, which learns WHAT the team knows. This learns manner,
  /// not fact, and produces no knowledge entries at all. Off by default, and even when on the
  /// learned guidance does nothing until a person approves it — see CommunicationStyleProfile.
  communicationStyleLearningEnabled Boolean  @default(false)
  screenshotResponseEnabled         Boolean  @default(false)
  chatLearningEnabled               Boolean  @default(false)
  softwareLearningEnabled           Boolean  @default(false)
  requirementLearningEnabled        Boolean  @default(false)
  announcementAiEnabled             Boolean  @default(false)
  /// Percentage (0-100). Two pieces of knowledge at/above this similarity are treated as duplicates.
  duplicateSimilarityThreshold      Int      @default(95)
  learningConfidenceThreshold       Int      @default(90)
  autoApprovalThreshold             Int      @default(95)
  humanReviewThreshold              Int      @default(70)
  updatedAt                         DateTime @updatedAt
}

/// A configured AI provider account (e.g. one Anthropic API key). apiKeyCiphertext
/// is AES-256-GCM encrypted at rest (see server/aiCrypto.ts) — the plaintext key
/// never touches the database or, past the initial form submit, the browser.
model AiProvider {
  id               String           @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId        String           @default(dbgenerated("project_id_required()"))
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name             String
  kind             AiProviderKind
  apiUrl           String?
  /// Null only for a keyless local runtime (kind OLLAMA). Every hosted provider still
  /// requires one, enforced in apps/web/src/server/actions/aiProviders.ts rather than by
  /// the column, so the single genuinely-keyless case does not need a sentinel value.
  apiKeyCiphertext String?
  status           AiProviderStatus @default(ACTIVE)
  priority         Int              @default(0)
  lastTestedAt     DateTime?
  lastTestOk       Boolean?
  lastTestError    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  models              AiModelConfig[]
  learningBatchJobs   LearningBatchJob[]
  patternCandidates   PatternCandidate[]
  aiFallbackDecisions AiFallbackDecision[]
}

/// Exactly one active model assignment per job (see @@unique) — the same
/// "singleton per key" pattern as GroupParticipantAddSettings, just keyed by
/// job instead of a fixed "global" id.
model AiModelConfig {
  id         String     @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId  String     @default(dbgenerated("project_id_required()"))
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  job        AiModelJob
  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelId    String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([projectId, job])
}

/// The application's permanent knowledge store (spec section 9). In Phase 1
/// every row is human-authored (aiGenerated=false, source=MANUAL) — the
/// aiGenerated/confidence/source fields exist now so later phases (software
/// learning, chat learning, document learning) can populate the same table
/// without a breaking migration. Always reflects the LATEST version; full
/// history lives in AiKnowledgeVersion.
/// WHO a knowledge item is true for — the data-isolation boundary.
///
/// Retrieval filters on this, so it is not a label: it decides whether one group's information can
/// ground an answer in another group's conversation. Before it existed, `findRelevantKnowledge`
/// selected on `humanVerified` + `ACTIVE` and nothing else, so an entry distilled from Group A's
/// conversation — or researched live for Group A by the deep-answer path, which stores
/// `humanVerified: true` — was immediately retrievable in every other group. `sourceGroupId`
/// recorded where it came from and was used only as a ranking tiebreak.
enum AiKnowledgeScope {
  /// True for the product itself, so usable everywhere: "how a package upgrade is done".
  GLOBAL
  /// True for one group only: a particular customer's configuration, a one-off arrangement. Never
  /// retrievable outside `sourceGroupId`.
  GROUP
  /// True for one WhatsApp account's customers. Present so a second ISP on this backend is a
  /// setting rather than a migration; enforced in retrieval exactly as GROUP is.
  ACCOUNT
}

model AiKnowledgeItem {
  id              String              @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId       String              @default(dbgenerated("project_id_required()"))
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title           String
  category        AiKnowledgeCategory
  question        String?
  answer          String
  procedure       String?
  software        String?
  module          String?
  softwareVersion String?
  source          String              @default("MANUAL")
  /// Set when this entry was distilled from a WhatsApp group conversation by the knowledge
  /// builder — the audit trail back to where the claim came from. SetNull, not Cascade:
  /// deleting a group must not erase what was learned from it.
  sourceGroupId   String?
  sourceGroup     WhatsAppGroup?      @relation(fields: [sourceGroupId], references: [id], onDelete: SetNull)
  /// Set when this entry came from a pasted-text or document import. SetNull for the same
  /// reason as sourceGroupId: deleting the import record must not erase what was learned.
  importId        String?
  import          KnowledgeImport?    @relation(fields: [importId], references: [id], onDelete: SetNull)
  /// Free-text origin shown in the review queue — a file name, a group name, or "Manual entry".
  /// Denormalised on purpose so the queue can show provenance without joining two optional
  /// relations for every row.
  sourceLabel     String?
  /// For an entry distilled from a fetched web page: the page it came from, so a reviewer can
  /// check the claim against its source and an operator can tell which entries a changed page
  /// affects. Null for every other origin.
  sourceUrl       String?
  confidence      Int?
  aiGenerated     Boolean             @default(false)
  /// Whether a person has confirmed this is true and may be said to a customer. It is the ONLY
  /// gate on retrieval (`knowledgeContext.ts` selects `humanVerified: true` + `ACTIVE`), so it is
  /// the single line between the knowledge base and what a customer is told.
  ///
  /// Defaults to FALSE, and the direction is the whole point. It used to default to true, which
  /// meant the one safety invariant of this system was opt-out: every machine writer had to
  /// remember to set it, and the tenth one to be added would have been customer-facing on its
  /// first write, silently. All current writers set it explicitly — the two that legitimately
  /// write `true` (the manual form, where a person is typing the entry themselves, and an
  /// approved conversation candidate) still do — so this flip changes no behaviour today. It
  /// changes what happens when somebody forgets.
  humanVerified   Boolean             @default(false)
  status          AiKnowledgeStatus   @default(ACTIVE)
  currentVersion  Int                 @default(1)

  /// Who this is true for. GLOBAL is the default so a manually written entry, a document import
  /// and the Forge repository sync — none of which belong to a group — behave exactly as they
  /// always have. Anything carrying a `sourceGroupId` is written as GROUP by the code that creates
  /// it, and a person promotes it to GLOBAL deliberately.
  scope          AiKnowledgeScope @default(GLOBAL)
  /// Only meaningful for `scope = ACCOUNT`. Null otherwise.
  scopeAccountId String?
  scopeAccount   WhatsAppAccount? @relation("AiKnowledgeScopeAccount", fields: [scopeAccountId], references: [id], onDelete: SetNull)

  /// SHA-256 over the canonicalised factual content (title, question, answer, procedure, module).
  /// For detecting an unchanged re-import and an unexpected modification — NOT for confidentiality,
  /// and never a merge trigger on its own. Deliberately excludes timestamps and status, so the
  /// hash describes the content rather than the row.
  contentHash String?

  /// Who actually approved this, and when. `humanVerified` is the gate every customer-facing
  /// answer passes through, and it recorded only THAT somebody approved — never who or when, which
  /// leaves the safety chain unauditable at exactly the point it matters most.
  verifiedById String?
  verifiedBy   User?     @relation("AiKnowledgeVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions     AiKnowledgeVersion[]
  evidenceUses AiEvidenceItem[]

  @@index([category])
  @@index([status])
  @@index([sourceGroupId])
  @@index([importId])
  /// The review queue's own query shape: "everything still waiting to be checked, newest first."
  @@index([humanVerified, createdAt])
  /// Browsing/filtering the knowledge base by module, which the list page now supports.
  @@index([module])
  /// The exact predicate retrieval narrows on, now that scope is part of it.
  @@index([humanVerified, status, scope])
  /// Duplicate-import detection. Deliberately NOT unique: two entries may legitimately share
  /// content while differing in scope or provenance, and refusing the second outright would
  /// destroy a distinct procedure rather than merely flagging it for a person to look at.
  @@index([contentHash])
}

/// One immutable snapshot per edit (spec section 10 — "never simply
/// overwrite important knowledge"). Version 1 is written at creation time;
/// every subsequent edit adds a new row rather than mutating history.
model AiKnowledgeVersion {
  id              String              @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId       String              @default(dbgenerated("project_id_required()"))
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  itemId          String
  item            AiKnowledgeItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  version         Int
  title           String
  category        AiKnowledgeCategory
  question        String?
  answer          String
  procedure       String?
  software        String?
  module          String?
  softwareVersion String?
  changeSummary   String?
  createdById     String?
  createdBy       User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())

  @@unique([itemId, version])
}

// ---------------------------------------------------------------------------
// Hybrid AI Automation — fallback layer (apps/worker/src/aiFallback/). Fires only when the
// deterministic rule engine (packages/engine's evaluate()) genuinely misses on a real customer
// message (finalDecision === "NO_MATCH") and the message's group has opted in. Reuses the existing
// AiModelJob.RESPONSE model slot, the existing OutboundMessage queue, and the existing Notification
// system unchanged — this table is purely the audit trail of what the AI decided, never a second
// send path. At most one row per Message.
// ---------------------------------------------------------------------------

enum AiFallbackOutcome {
  AI_REPLIED
  HUMAN_FALLBACK
}

/// Distinguishes how a PatternCandidateEvidence row was resolved, for Conversation Learning's
/// benefit — populated by patternDetectionJob.ts's evidence-linking query (a later, additive
/// change; the column exists now so that migration doesn't need a second one).
enum EvidenceResponseSource {
  EXISTING_RULE
  HUMAN
  AI
  UNRESOLVED
}

/// Audit trail for the Hybrid AI Automation fallback layer — at most one row per genuine NO_MATCH
/// message that reached the eligibility gate (kill switch, mode, group opt-in, AI Settings all
/// passed). A message that never reached the gate (ineligible) gets no row at all, by design — see
/// apps/worker/src/aiFallback/eligibility.ts's doc comment.
model AiFallbackDecision {
  id        String          @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String          @default(dbgenerated("project_id_required()"))
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  messageId String          @unique
  message   Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  accountId String
  account   WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId   String?
  group     WhatsAppGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  /// Snapshot of which provider/model actually answered — not a live link, since AiModelConfig can
  /// be reassigned later without invalidating past audit rows.
  aiProviderId String?
  aiProvider   AiProvider? @relation(fields: [aiProviderId], references: [id], onDelete: SetNull)
  modelId      String?

  intent          String?
  confidenceScore Int?
  responseText    String?
  outcome         AiFallbackOutcome
  /// Short diagnostic code (e.g. "LOW_CONFIDENCE", "AI_UNAVAILABLE", "SAFETY_BLOCKED: ...") — free
  /// text, same convention as SystemLog's own message field, not branched on anywhere in code.
  reason          String?

  outboundMessageId             String?          @unique
  outboundMessage               OutboundMessage? @relation(fields: [outboundMessageId], references: [id], onDelete: SetNull)
  notificationId                String?          @unique
  notification                  Notification?    @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  /// The "we could not understand, the team will follow up" reply sent to the customer on this
  /// handover, if one was (AiSettings.unableToUnderstandReplyEnabled). Plain id, like the queue row
  /// it points at, so the AI Activity log can say the customer was told.
  holdingReplyOutboundMessageId String?

  tokensUsed Int?

  /// What it cost and how it ended, in the provider's own terms. `finishReason` is the raw string
  /// ("stop", "length", "max_tokens") rather than an enum, because it belongs to whichever provider
  /// answered and a new one must not need a migration to be recorded.
  latencyMs    Int?
  finishReason String?

  /// WHICH VERSION OF THIS SYSTEM produced the answer. Without these, comparing two models over the
  /// same question proves nothing — a difference could be the model, or a prompt edit, or a
  /// retrieval change shipped in between.
  promptVersion    String?
  retrievalVersion String?

  /// The fingerprint of the evidence this answer was built on, denormalised from the snapshot so
  /// "did these two replies see the same evidence?" is answerable without a join.
  evidenceFingerprint String?

  /// Ties every log line, retrieval, generation and send for one incoming message together. Reuses
  /// the pipeline's existing trace id (`<accountId>:<whatsappMessageId>`) rather than minting a
  /// second identifier for the same thing.
  correlationId String?

  createdAt DateTime @default(now())

  /// Set when this decision's unanswered question was queued for research against the ISPDIGITAL
  /// repository — see ForgeResearchTask.
  forgeResearchTask ForgeResearchTask?
  evidenceSnapshot  AiEvidenceSnapshot?

  @@index([accountId, createdAt])
  @@index([outcome, createdAt])
  @@index([correlationId])
  /// Model comparison: every generation built on one evidence set, whatever produced it.
  @@index([evidenceFingerprint])
}

/// WHAT THE AI WAS LOOKING AT when it answered — the persisted form of the runtime EvidenceBundle.
///
/// The two are deliberately different things. The bundle is assembled per request and handed to the
/// model; this is the record of it, kept so a reply can still be explained after the knowledge
/// behind it has been edited. Six months on, "which version of entry #31 did the AI read?" has an
/// answer, because the snapshot stores the version NUMBER and `AiKnowledgeVersion` stores what that
/// version said.
///
/// It stores references, never copies: the question is reachable through `decision.message`, and the
/// evidence text through `AiKnowledgeVersion`. Only a title is denormalised, so a snapshot whose
/// knowledge item was later deleted still says what it was.
///
/// Explicitly NOT stored: any reasoning, any prompt text, anything resembling chain-of-thought.
/// Only the operational structure that makes an answer traceable.
model AiEvidenceSnapshot {
  id         String             @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId  String             @default(dbgenerated("project_id_required()"))
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  decisionId String             @unique
  decision   AiFallbackDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  /// SHA-256 over the canonicalised bundle — the ordered (item, version) pairs plus the plan's
  /// structural conclusions. Deterministic for the same evidence, so two runs that saw the same
  /// thing are provably comparable and one that did not is provably different.
  fingerprint String

  /// The answer plan's conclusions, which are derived from the evidence rather than from a model.
  /// Kept here rather than in a table of their own: it is one row's worth of structure, and a
  /// second table would be a join for four columns.
  questionShape    String
  intent           String?
  knowledgeCount   Int     @default(0)
  workflowCount    Int     @default(0)
  missingProcedure Boolean @default(false)
  /// Reserved for the conflict-detection stage, which is deliberately not built yet. Always 0
  /// today, and honest about it: nothing writes a conflict, so nothing may claim one was checked.
  conflictCount    Int     @default(0)

  items     AiEvidenceItem[]
  createdAt DateTime         @default(now())

  @@index([fingerprint])
}

/// One piece of evidence, as it was at the moment it was used.
model AiEvidenceItem {
  snapshotId String
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId  String             @default(dbgenerated("project_id_required()"))
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  snapshot   AiEvidenceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  /// SetNull rather than Cascade: deleting a knowledge item must not erase the record that it once
  /// grounded an answer, which is the whole purpose of this table.
  knowledgeItemId  String?
  knowledgeItem    AiKnowledgeItem? @relation(fields: [knowledgeItemId], references: [id], onDelete: SetNull)
  /// The version that was live WHEN THE ANSWER WAS GENERATED — join to AiKnowledgeVersion for the
  /// exact text. This is what survives a later edit.
  knowledgeVersion Int

  /// Position in the bundle, and the primary key's second half, so ordering is stable and one
  /// snapshot cannot record the same rank twice.
  rank Int

  /// Denormalised so a snapshot whose item was later deleted is still readable. The title only —
  /// copying the answer would duplicate content `AiKnowledgeVersion` already holds exactly.
  title         String
  scope         AiKnowledgeScope
  hadProcedure  Boolean          @default(false)
  fromSameGroup Boolean          @default(false)

  @@id([snapshotId, rank])
  @@index([knowledgeItemId])
}

// ---------------------------------------------------------------------------
// Priority-Based Support Monitoring & Escalation
// ---------------------------------------------------------------------------

/// One row per priority tier (seeded lazily, like every other settings singleton in this app —
/// see getSupportPriorityPolicies()). SLA minutes are snapshotted onto each
/// SupportEscalationCase at creation time, so editing a policy never rewrites an in-flight case.
model SupportPriorityPolicy {
  id                      String          @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId               String          @default(dbgenerated("project_id_required()"))
  project                 Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  priority                SupportPriority
  firstAlertMinutes       Int
  secondAlertMinutes      Int
  memberEscalationMinutes Int
  adminEscalationMinutes  Int
  followUpIntervalMinutes Int
  maxEscalations          Int
  updatedAt               DateTime        @updatedAt

  @@unique([projectId, priority])
}

/// Singleton row (id is always the literal string "global").
model SupportEscalationSettings {
  id                String              @id @default("global")
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId         String              @unique @default(dbgenerated("project_id_required()"))
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  enabled           Boolean             @default(true)
  escalationAdminId String?
  escalationAdmin   InternalTeamMember? @relation(fields: [escalationAdminId], references: [id], onDelete: SetNull)
  updatedAt         DateTime            @updatedAt
}

/// One open "ticket" per chat with an unanswered priority customer message. Created the moment
/// a non-team-member message arrives in a priority-tagged group with no case already open for
/// that chat (a second customer message before anyone replies extends the existing case rather
/// than opening a duplicate one — see escalationQueue.ts).
model SupportEscalationCase {
  id          String           @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId   String           @default(dbgenerated("project_id_required()"))
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId   String
  account     WhatsAppAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId     String
  group       WhatsAppGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  chatId      String
  clientPhone String
  priority    SupportPriority
  status      EscalationStatus @default(NEW)

  triggerMessageId      String
  triggerMessage        Message  @relation("EscalationTriggerMessage", fields: [triggerMessageId], references: [id], onDelete: Cascade)
  lastCustomerMessageAt DateTime

  escalationLevel      Int                 @default(0)
  assignedTeamMemberId String?
  assignedTeamMember   InternalTeamMember? @relation(fields: [assignedTeamMemberId], references: [id], onDelete: SetNull)

  /// Snapshot of the matching SupportPriorityPolicy at case-creation time (see model doc comment).
  firstAlertMinutes       Int
  secondAlertMinutes      Int
  memberEscalationMinutes Int
  adminEscalationMinutes  Int
  followUpIntervalMinutes Int
  maxEscalations          Int

  /// When the escalation worker should next evaluate this case — avoids scanning every open case
  /// every tick, same "claim only what's due" shape as OutboundMessage.scheduledAt.
  nextCheckAt    DateTime
  humanRepliedAt DateTime?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  pausedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events SupportEscalationEvent[]

  @@index([status, nextCheckAt])
  @@index([groupId])
  @@index([chatId])
}

/// The escalation audit trail AND the duplicate-notification guard in one table: the unique
/// constraint below makes it structurally impossible for a worker retry/restart/concurrent tick
/// to send the same tier to the same recipient twice — see fireEscalationEvent() in
/// escalationQueue.ts, which always tries to INSERT this row (inside the same transaction as the
/// Notification it creates) before ever sending anything, and treats a unique-constraint failure
/// as "already handled, skip."
model SupportEscalationEvent {
  id             String                  @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId      String                  @default(dbgenerated("project_id_required()"))
  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  caseId         String
  case           SupportEscalationCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  level          Int
  eventType      EscalationEventType
  recipientType  EscalationRecipientType
  /// Stable identity of the recipient (a WhatsApp group id, an InternalTeamMember id, or the
  /// literal "ADMIN"/"SYSTEM") — this, not recipientLabel, is what the uniqueness guarantee below
  /// keys on, so a tier that fans out to multiple groups gets one idempotent row per group.
  recipientKey   String
  recipientLabel String
  notificationId String?
  notification   Notification?           @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  triggeredById  String?
  triggeredBy    User?                   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt      DateTime                @default(now())

  @@unique([caseId, level, eventType, recipientKey])
  @@index([caseId])
}

// ---------------------------------------------------------------------------
// Conversation Learning / Pattern Discovery — Phase 1 (data collection only).
// A background layer that runs alongside the rule engine, never inside it:
// it only reads already-persisted Message rows and tags them with a session,
// entirely off by default (LearningSettings.conversationLearningEnabled).
// Deterministic pattern detection (PatternCandidate), human review
// (RuleProposal), and AI-assisted analysis are later, separate migrations —
// this phase adds no path that can affect message delivery or rule
// evaluation. See ARCHITECTURE.md-style note in apps/worker/src/learning/.
// ---------------------------------------------------------------------------

enum ConversationSessionStatus {
  OPEN
  CLOSED
}

enum LearningBatchJobType {
  CONVERSATION_SEGMENTATION
  /// Not implemented until the deterministic pattern-detection migration/phase.
  PATTERN_DETECTION
  /// Not implemented until the AI-assisted analysis migration/phase.
  AI_ANALYSIS
}

enum LearningBatchJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum LearningBatchJobTrigger {
  MANUAL
  SCHEDULED
}

/// Groups existing Message rows by chat + inactivity gap — copies no message content, just tags
/// Message.conversationSessionId. Built by a separate batch job (apps/worker/src/learning/
/// sessionSegmentation.ts), never by the message pipeline itself.
model ConversationSession {
  id                String                    @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId         String                    @default(dbgenerated("project_id_required()"))
  project           Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId         String
  account           WhatsAppAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId            String
  groupId           String?
  group             WhatsAppGroup?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  status            ConversationSessionStatus @default(OPEN)
  firstMessageAt    DateTime
  lastMessageAt     DateTime
  messageCount      Int                       @default(0)
  /// Distinct Message.senderPhone values seen so far in this session.
  participantPhones String[]                  @default([])
  closedAt          DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  messages Message[]
  evidence PatternCandidateEvidence[]

  @@index([accountId, chatId, status])
  /// The segmentation job's own "claim only what's due" query: OPEN sessions idle past the gap window.
  @@index([status, lastMessageAt])
}

/// Singleton row (id is always the literal string "global"), same pattern as AutomationSettings/
/// AiSettings. Thresholds here are meaningful even with AI fully off, so they live here rather
/// than on AiSettings — this is deliberately not an "AI settings" table.
model LearningSettings {
  id                                 String   @id @default("global")
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId                          String   @unique @default(dbgenerated("project_id_required()"))
  project                            Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// The one kill switch for this entire feature — false means the segmentation/pattern-detection
  /// jobs no-op on every tick, and zero rows are written anywhere under this section.
  conversationLearningEnabled        Boolean  @default(false)
  /// Minutes of inactivity on a chat before its current session is closed.
  sessionGapMinutes                  Int      @default(30)
  /// Below this occurrence count, a would-be pattern is not yet promoted to a PatternCandidate row
  /// (enforced starting in the pattern-detection phase) — kept here now so the settings shape is
  /// stable across phases and editable from one place.
  minOccurrenceForCandidate          Int      @default(3)
  minDistinctGroupsForCandidate      Int      @default(2)
  minDistinctClientsForCandidate     Int      @default(2)
  candidateExpiryDays                Int      @default(30)
  /// Explicit opt-in, default OFF — an approved-but-not-yet-active auto-approval policy must never
  /// be assumed; see the pattern-detection/rule-proposal phases.
  autoApprovalEnabled                Boolean  @default(false)
  autoApprovalMinConfidence          Int      @default(97)
  weightFrequency                    Int      @default(25)
  weightDiversity                    Int      @default(20)
  weightConsistency                  Int      @default(20)
  weightResolution                   Int      @default(15)
  weightRecency                      Int      @default(10)
  weightAiConfidence                 Int      @default(10)
  /// Explicit opt-in, default OFF — Unknown Pattern alerts (patternDetectionJob.ts) reuse
  /// AutomationSettings.whatsappNotificationGroupIds as their destination; this flag alone gates
  /// whether that reuse ever fires, independent of conversationLearningEnabled (accumulation can
  /// run silently for a while before an admin decides to also turn alerting on).
  unknownPatternNotificationsEnabled Boolean  @default(false)
  /// Minimum minutes between two alerts for the same PatternCandidate — prevents one recurring
  /// unhandled question from re-notifying on every 15-minute pattern-detection tick.
  unknownPatternCooldownMinutes      Int      @default(60)
  updatedAt                          DateTime @updatedAt
}

/// One row per batch-job run (segmentation, pattern detection, or AI analysis) — audit trail and,
/// for AI_ANALYSIS specifically, the cost-visibility record referenced from the dashboard hub.
model LearningBatchJob {
  id                   String                  @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId            String                  @default(dbgenerated("project_id_required()"))
  project              Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  jobType              LearningBatchJobType
  trigger              LearningBatchJobTrigger
  status               LearningBatchJobStatus  @default(QUEUED)
  triggeredById        String?
  triggeredBy          User?                   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  /// Only ever set for AI_ANALYSIS runs.
  aiProviderId         String?
  aiProvider           AiProvider?             @relation(fields: [aiProviderId], references: [id], onDelete: SetNull)
  candidatesConsidered Int                     @default(0)
  candidatesUpdated    Int                     @default(0)
  errorMessage         String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())

  @@index([status, jobType])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Conversation Learning / Pattern Discovery — Phase 2 (deterministic pattern
// detection). Entirely AI-free: packages/engine/src/patternDetection.ts's
// pure scorer never calls an AI provider. aiConfidenceScore/aiProviderId/
// aiAnalysisSummary below are included now (nullable, unused) so the AI-
// assisted analysis phase doesn't need a second migration on this table.
// ---------------------------------------------------------------------------

enum PatternCandidateStatus {
  PENDING_ANALYSIS
  /// Only reachable once the (later, optional) AI-assisted analysis phase has scored this candidate.
  ANALYZED
  PENDING_REVIEW
  APPROVED
  REJECTED
  /// Folded into another candidate covering the same intent (human/reviewer action, later phase).
  MERGED
  /// Aged out without enough evidence — see LearningSettings.candidateExpiryDays (later phase).
  EXPIRED
}

/// One row per detected pattern signature — created as soon as the first occurrence is seen, so
/// evidence has somewhere to accumulate against. The hard floor (LearningSettings.
/// minOccurrenceForCandidate/minDistinctGroupsForCandidate/minDistinctClientsForCandidate) does
/// NOT gate row creation — it gates whether a row is ever surfaced to a human or considered a real
/// "candidate" anywhere downstream (the dashboard list only queries rows currently past the
/// floor; see patternDetectionJob.ts's rescoreCandidate(), which also refuses to advance `status`
/// past PENDING_ANALYSIS until the floor is met). A single isolated conversation can create a row
/// here, but it can never become visible or actionable.
model PatternCandidate {
  id                      String    @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId               String    @default(dbgenerated("project_id_required()"))
  project                 Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// Deterministic signature (sorted distinctive-keyword set) — the same recurring intent always
  /// hashes to the same key, order-independent. See packages/engine/src/patternDetection.ts.
  patternKey              String
  suggestedMatchType      MatchType
  suggestedKeywords       String[]  @default([])
  suggestedMatchValue     String?
  /// Most common team-member reply text seen following a matching message — evidence, not binding.
  suggestedReplyMessage   String?
  suggestedActionCategory String?

  occurrenceCount     Int      @default(0)
  distinctGroupCount  Int      @default(0)
  distinctClientCount Int      @default(0)
  /// Of occurrenceCount, how many evidence rows have no respondingRuleId — i.e. no existing
  /// AutomationRule fired for that historical message. This is the Unknown Pattern signal: a
  /// pattern an existing rule already handles well can still accumulate as a PatternCandidate
  /// (unchanged, existing behavior) without ever being treated as "unknown".
  unhandledCount      Int      @default(0)
  firstSeenAt         DateTime
  lastSeenAt          DateTime

  /// Individual signal scores (0-100), each computed independently — see computeConfidenceScore().
  frequencyScore     Int  @default(0)
  diversityScore     Int  @default(0)
  consistencyScore   Int  @default(0)
  resolutionScore    Int  @default(0)
  recencyScore       Int  @default(0)
  /// Null until an AI batch analyzes it (later phase) — the confidence formula falls back to
  /// frequencyScore when this is null, so it never degrades in AI-off mode.
  aiConfidenceScore  Int?
  /// Only ever incremented via an explicit reviewer action (later phase), capped at 100.
  humanVerifiedBoost Int  @default(0)
  /// Final blended score — see computeConfidenceScore() in packages/engine.
  confidenceScore    Int  @default(0)

  status            PatternCandidateStatus @default(PENDING_ANALYSIS)
  aiAnalysisSummary String?
  aiProviderId      String?
  aiProvider        AiProvider?            @relation(fields: [aiProviderId], references: [id], onDelete: SetNull)
  reviewedById      String?
  reviewedBy        User?                  @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewNote        String?
  mergedIntoId      String?
  mergedInto        PatternCandidate?      @relation("PatternMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom        PatternCandidate[]     @relation("PatternMerge")

  /// Last time an Unknown Pattern alert was sent for this candidate — the cooldown clock
  /// LearningSettings.unknownPatternCooldownMinutes counts against. Null means never alerted.
  unknownPatternNotifiedAt DateTime?
  unknownPatternAlerts     Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence PatternCandidateEvidence[]
  proposal RuleProposal?

  @@unique([projectId, patternKey])
  @@index([status, confidenceScore])
  @@index([lastSeenAt])
  @@index([unhandledCount, lastSeenAt])
}

/// Audit trail proving a PatternCandidate isn't a fluke — one row per ConversationSession that
/// contributed to it. The unique constraint also makes the detection job's upsert idempotent: a
/// session already linked to this candidate is never counted or linked twice.
model PatternCandidateEvidence {
  id                    String                 @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId             String                 @default(dbgenerated("project_id_required()"))
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  patternCandidateId    String
  patternCandidate      PatternCandidate       @relation(fields: [patternCandidateId], references: [id], onDelete: Cascade)
  conversationSessionId String
  conversationSession   ConversationSession    @relation(fields: [conversationSessionId], references: [id], onDelete: Cascade)
  matchedMessageId      String?
  matchedMessage        Message?               @relation(fields: [matchedMessageId], references: [id], onDelete: SetNull)
  /// Heuristic: a team-member reply followed within the same session.
  wasResolved           Boolean                @default(false)
  /// Set if an AutomationExecution in this session already had a non-null ruleId — a historical-
  /// outcome signal, not a foreign key (the rule may since have been deleted/disabled).
  respondingRuleId      String?
  /// Populated by patternDetectionJob.ts's evidence-linking query (a later, additive change) by
  /// checking for an AiFallbackDecision on the matched message — column added now so that future
  /// change is a single migration-free code change, not a second schema migration.
  responseSource        EvidenceResponseSource @default(UNRESOLVED)
  createdAt             DateTime               @default(now())

  @@unique([patternCandidateId, conversationSessionId])
  /// The Unknown Patterns page picks the newest evidence row per candidate with a DISTINCT ON;
  /// ordering by createdAt inside each candidate is what makes that an index walk instead of a sort.
  @@index([patternCandidateId, createdAt])
  /// linkClosedSessionsToCandidates asks "which of these sessions has no evidence row yet", which
  /// is an anti-join on conversationSessionId. The compound unique above leads with
  /// patternCandidateId and cannot serve it, so that ran as a scan every fifteen minutes.
  @@index([conversationSessionId])
}

// ---------------------------------------------------------------------------
// Conversation Learning / Pattern Discovery — Phase 3/4 (human review + real
// rule execution). A RuleProposal is a fully-formed AutomationRule draft, so
// approving it is a pure copy into a real AutomationRule row (status DRAFT,
// never ACTIVE) — see approveRuleProposal() in
// apps/web/src/server/actions/ruleProposals.ts. The rule engine that then
// executes it (once a human separately flips it ACTIVE on the existing Rules
// page) is completely unmodified by any of this.
// ---------------------------------------------------------------------------

enum RuleProposalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  /// Reserved for a later phase (e.g. an approved-but-not-yet-converted state); every proposal
  /// created today reaches APPROVED and a real AutomationRule in the same transaction.
  CONVERTED
}

/// One row per human-facing proposal, at most one per PatternCandidate (see @@unique below) — a
/// candidate that's rejected or withdrawn does not get a second proposal; if the same pattern
/// keeps recurring, that continues to accumulate as fresh evidence on the same candidate.
/// Where a RuleProposal came from. Both land in the same review queue and approve through
/// the same code path; only the evidence behind them differs.
enum RuleProposalSource {
  /// Conversation Learning's deterministic recurring-pattern detector.
  CONVERSATION_LEARNING
  /// A single message the AI fallback answered well enough to be worth codifying.
  AI_REPLY
}

model RuleProposal {
  id                 String            @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId          String            @default(dbgenerated("project_id_required()"))
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// Null for an AI_REPLY proposal, which has no recurring pattern behind it. Postgres
  /// permits many NULLs under a unique index, so one-candidate-one-proposal still holds.
  patternCandidateId String?           @unique
  patternCandidate   PatternCandidate? @relation(fields: [patternCandidateId], references: [id], onDelete: Cascade)

  source          RuleProposalSource @default(CONVERSATION_LEARNING)
  /// The message that prompted an AI_REPLY proposal, kept for review context.
  sourceMessageId String?            @db.Text
  /// Deterministic keyword signature of the message this was drafted from
  /// (packages/engine's derivePatternSignature). Unique, so a question the AI answers
  /// fifty times produces one draft rather than fifty identical ones.
  sourceSignature String?

  // Fully-formed AutomationRule draft — same shape as the real row, so approval is a pure copy.
  name            String
  description     String?
  type            RuleType
  matchType       MatchType
  matchValue      String?
  keywords        String[]  @default([])
  conditions      Json      @default("{}")
  actions         Json      @default("[]")
  priority        Int       @default(0)
  cooldownSeconds Int?
  replyMessage    String?
  replyDelayMinMs Int?
  replyDelayMaxMs Int?

  /// Copied from PatternCandidate.confidenceScore at proposal-creation time — a snapshot, not a
  /// live link, so it stays meaningful even if the source candidate's score later changes.
  confidenceScoreSnapshot Int
  status                  RuleProposalStatus @default(PENDING_REVIEW)
  /// Reserved for a later auto-approval phase — every proposal created today is created with this
  /// false and moved to APPROVED only via an explicit human action.
  autoApproved            Boolean            @default(false)
  reviewedById            String?
  reviewedBy              User?              @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt              DateTime?
  reviewNote              String?
  createdRuleId           String?            @unique
  createdRule             AutomationRule?    @relation(fields: [createdRuleId], references: [id], onDelete: SetNull)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@unique([projectId, sourceSignature])
  @@index([status, confidenceScoreSnapshot])
}

// ---------------------------------------------------------------------------
// Support Activity Tracking — detects configured keyword/rule matches sent by
// configured InternalTeamMembers inside WhatsApp groups, records each as a
// raw SupportActivity event, and lets admins view counts computed from that
// raw history under 3 configurable counting modes + a DAILY counting period.
// Off by default (SupportActivitySettings.enabled = false); when off, the
// detector (apps/worker/src/supportActivity/detector.ts) no-ops and zero
// rows are ever written. Entirely independent of AutomationRule/the rule
// engine's own evaluation — runs alongside it, never gated by its decision.
// ---------------------------------------------------------------------------

/// Closed enum (not a free string) so periods stay a pure enum-value + query addition, never a
/// shape rewrite. WEEKLY starts Sunday (regional Fri/Sat weekend convention).
enum SupportActivityCountingPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

/// Closed on purpose (same reasoning as WhatsAppServiceKey's own doc comment). The detector's
/// dispatch (apps/worker/src/supportActivity/detector.ts) is a plain switch on this value, not a
/// plugin system. REACTION is intentionally NOT included yet — WhatsApp reactions arrive via a
/// separate event stream (client.onReaction(), not the onAnyMessage payload these three trigger
/// types read from) and need a dedicated ingestion path + table; add it as its own migration when
/// actually built, not speculatively now.
/// Who delivered a recorded piece of support. Split out so AI-handled conversations can be
/// counted as real support without being silently folded into a person's own numbers — a
/// team member's tally must never include work they did not do.
enum SupportActivityActor {
  TEAM_MEMBER
  /// The Hybrid AI Automation fallback answered a customer and no human was needed. Carries a
  /// null teamMemberId, and deliberately never opens or closes a SupportSession: a session
  /// represents a person handling a conversation over time, which is not what happened here.
  AI
}

enum SupportActivityTriggerType {
  KEYWORD_MATCH
  /// Fires when a support team member's message is a WhatsApp "quoted reply" to a message from a
  /// non-team-member (a real customer) — no keyword needed.
  REPLY_TO_CUSTOMER
  /// Fires when a support team member's message @-mentions at least one non-team-member phone
  /// number — no keyword needed.
  MENTION
  /// Fires on ANY message a support team member sends in an in-scope group — no keyword, no
  /// reply, no mention needed. The simplest possible definition of "this person worked in this
  /// group today", for teams whose support conversations do not follow a keyword convention.
  /// Evaluated after every other trigger so a keyword rule (which can mark a session complete)
  /// still wins when both would match.
  ANY_MESSAGE
}

enum SupportKeywordMatchMode {
  CONTAINS
  EXACT
}

/// Lifecycle of a SupportSession. Deliberately just these two values — a "stale" (OPEN for a long
/// time) session is still, technically, OPEN; staleness is a derived/display-only concept computed
/// at query time (apps/web/src/server/supportActivityReports.ts) from `startedAt`, never a stored
/// status, so it never needs a migration to retune the threshold.
enum SupportSessionStatus {
  OPEN
  COMPLETED
}

/// Singleton row (id is always the literal string "global"), same pattern as AutomationSettings/
/// AiSettings/LearningSettings/SupportEscalationSettings. enabled defaults to false — the whole
/// feature is off until an admin opts in; while off, apps/worker/src/supportActivity/detector.ts
/// countingPeriod are global, not per-rule, by explicit requirement.
model SupportActivitySettings {
  id                      String                        @id @default("global")
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId               String                        @unique @default(dbgenerated("project_id_required()"))
  project                 Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  enabled                 Boolean                       @default(false)
  countingPeriod          SupportActivityCountingPeriod @default(DAILY)
  updatedAt               DateTime                      @updatedAt
  /// How long an executive can go without messaging any group before they count as offline, and
  /// the gap that splits one stretch of work from the next.
  ///
  /// One number for both on purpose. "Is she online now?" and "how long was she working?" are the
  /// same question asked about different moments, and answering them with different thresholds —
  /// which is what happened when availability used a hardcoded 30 minutes while work time was
  /// measured per group per day — produces a page where somebody shows as offline inside a stretch
  /// of work the same page is counting.
  offlineAfterMinutes     Int                           @default(120)
  /// Team Report: a customer wait answered later than this — or not at all, once older than this —
  /// counts as Missed (and as Recall if it was answered in the end). Groups with a support priority
  /// use their escalation policy's first-alert time instead; this covers every other group, since
  /// no rule for them existed. See packages/shared/src/teamReport.ts.
  missedReplyAfterMinutes Int                           @default(30)
  /// The Teams that are the Support Team for Messages → Unanswered Groups / Response Time
  /// (SUPPORT_RESPONSE.md). Only a reply from a member of one of these Teams — at the moment they
  /// replied — answers an episode. Empty = response tracking is not set up, and nothing is tracked.
  responseTrackingTeamIds String[]                      @default([])
  /// Reporting is verified from this moment (SUPPORT_INTELLIGENCE_IMPLEMENTATION_AUDIT.md). Before
  /// it every report labels its figures historical / unverified; after it a period is verified
  /// unless a CollectionGap overlaps it. Null = nothing is verified yet — the honest default, since
  /// collection health was not recorded before CollectionGap existed. Set by an admin.
  reportingVerifiedFrom   DateTime?
}

/// Admin-managed keyword/phrase. Referenced by zero or more SupportRules via SupportRuleKeyword —
/// not a free-text array on the rule itself, unlike AutomationRule.keywords, because keywords here
/// are independently CRUD-able (add/edit/delete/enable-disable) and reused across rules.
model SupportKeyword {
  id              String                  @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId       String                  @default(dbgenerated("project_id_required()"))
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  value           String
  matchMode       SupportKeywordMatchMode @default(CONTAINS)
  /// Default false (case-insensitive) — matches every existing text-matching convention in this
  /// app (see packages/engine/src/normalize.ts's normalizeText()).
  caseSensitive   Boolean                 @default(false)
  isActive        Boolean                 @default(true)
  /// Flags this keyword as a support-session completion signal (apps/worker/src/supportActivity/
  /// sessionTracker.ts). Still completely inert on its own — it must be attached to an active
  /// KEYWORD_MATCH SupportRule scoped to the relevant group/members to ever actually fire, exactly
  /// like every other SupportKeyword. Read off the already-matched keyword returned by detector.ts;
  /// never a second, parallel matching pass.
  marksCompletion Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  rules      SupportRuleKeyword[]
  activities SupportActivity[]
}

/// One admin-configured detection rule. Global (no accountId), same precedent as AutomationRule.
/// Scope to "all X" vs "selected X" is a boolean flag + a join table used only when the flag is
/// false — the minimal shape for this, not a JSON id array (which is harder to index/join safely).
model SupportRule {
  id                      String                     @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId               String                     @default(dbgenerated("project_id_required()"))
  project                 Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name                    String
  description             String?
  triggerType             SupportActivityTriggerType @default(KEYWORD_MATCH)
  /// true = every WhatsAppGroup is in scope; false = only groups explicitly listed in `groups`.
  appliesToAllGroups      Boolean                    @default(true)
  /// true = every InternalTeamMember is in scope; false = only members explicitly listed in
  /// `teamMembers`.
  appliesToAllTeamMembers Boolean                    @default(true)
  isActive                Boolean                    @default(true)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  keywords    SupportRuleKeyword[]
  groups      SupportRuleGroup[]
  teamMembers SupportRuleTeamMember[]
  activities  SupportActivity[]

  /// The detector's primary WHERE-clause shape: "active rules of this trigger type."
  @@index([isActive, triggerType])
}

model SupportRuleKeyword {
  ruleId    String
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String         @default(dbgenerated("project_id_required()"))
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  rule      SupportRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  keywordId String
  keyword   SupportKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([ruleId, keywordId])
}

model SupportRuleGroup {
  ruleId    String
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String        @default(dbgenerated("project_id_required()"))
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  rule      SupportRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  groupId   String
  group     WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([ruleId, groupId])
}

model SupportRuleTeamMember {
  ruleId       String
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId    String             @default(dbgenerated("project_id_required()"))
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  rule         SupportRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  teamMemberId String
  teamMember   InternalTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@id([ruleId, teamMemberId])
}

/// One row per detected support-activity event — the raw, permanent history. Aggregated counts
/// (UNIQUE_GROUP / EVERY_ACTIVITY / PER_TEAM_MEMBER, over SupportActivitySettings.countingPeriod)
/// are always computed from this table at query time (see apps/web/src/server/
/// countingPeriod retroactively reinterprets all existing history correctly.
model SupportActivity {
  id           String               @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId    String               @default(dbgenerated("project_id_required()"))
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId    String
  account      WhatsAppAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId      String
  group        WhatsAppGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Nullable + SetNull (not Cascade) so a later-deleted InternalTeamMember never destroys already-
  /// recorded history — only its per-member attribution on that one row degrades to "unassigned."
  teamMemberId String?
  teamMember   InternalTeamMember?  @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  /// Who delivered this support. TEAM_MEMBER rows always carry a teamMemberId; AI rows never do.
  /// Defaulted so every row written before this column existed keeps its original meaning.
  actor        SupportActivityActor @default(TEAM_MEMBER)
  /// Nullable + SetNull, same reasoning: a deleted SupportRule/SupportKeyword must never delete
  /// history (mirrors AutomationExecution.ruleId's exact pattern).
  ruleId       String?
  rule         SupportRule?         @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  keywordId    String?
  keyword      SupportKeyword?      @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  /// The idempotency guard: at most one SupportActivity row can ever exist per Message. Enforced
  /// here as a real DB constraint (insert-and-catch-P2002), not an application-level check-then-
  /// insert race — mirrors how Message's own @@unique([accountId, whatsappMessageId]) is the real
  /// dedup guard, and AutomationExecution.idempotencyKey's @unique column.
  messageId    String               @unique
  message      Message              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// = Message.timestampWa (WhatsApp's own send time), not receivedAt/createdAt — this is what
  /// every DAILY (and future WEEKLY/MONTHLY) period boundary buckets against.
  occurredAt   DateTime
  createdAt    DateTime             @default(now())

  /// Back-relations for SupportSession's two possible references to this exact activity row (the
  /// session it opened, and/or — on a different row — the session it closed via a completion
  /// keyword). A single activity can be at most one of these, never both.
  startedSession   SupportSession? @relation("SupportSessionFirstActivity")
  completedSession SupportSession? @relation("SupportSessionCompletionActivity")

  @@index([accountId, occurredAt])
  @@index([accountId, groupId, occurredAt])
  @@index([accountId, teamMemberId, occurredAt])
  @@index([accountId, actor, occurredAt])
  @@index([ruleId])
  /// Every index above leads with accountId, and no dashboard caller filters on it — the reports
  /// are deployment-wide, not per-number. So the whole Support Activity module fell back to
  /// sequential scans on its own table. These two are the shapes those reports actually use.
  @@index([occurredAt])
  @@index([actor, occurredAt])
}

/// One open-or-completed support session per WhatsAppGroup lifecycle — group-level scope by
/// explicit requirement, NOT per team member: many groups can each have their own OPEN session at
/// the same time, but a single group can never have more than one. Opens on the first tracked
/// team-member SupportActivity in a group with no currently-open session; any other team member's
/// activity in that same group while it's OPEN just accumulates against it (no new session, no
/// attribution change). Closes either (a) automatically, when any team member's message matches a
/// SupportKeyword.marksCompletion keyword via the exact same SupportRule/detector.ts pipeline that
/// already runs for every other trigger type, or (b) manually, via an admin's explicit "Close
/// Session" action (apps/web/src/server/actions/supportSessions.ts) when no completion keyword was
/// ever sent. There is deliberately NO automatic timeout/inactivity-based closure of any kind — an
/// OPEN session stays OPEN forever until one of those two explicit events happens; a long-open
/// session is surfaced to admins as "stale" purely as a derived, query-time UI state (see
/// getGroupSessionHistory in apps/web/src/server/supportActivityReports.ts), never a stored status.
model SupportSession {
  id        String               @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String               @default(dbgenerated("project_id_required()"))
  project   Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId String
  account   WhatsAppAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId   String
  group     WhatsAppGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status    SupportSessionStatus @default(OPEN)

  /// Mirrors `groupId` while status=OPEN; set to null the instant the session completes (either
  /// path). Exists solely so an ordinary (non-partial) `@@unique` can enforce "at most one OPEN
  /// session per group" as a real DB constraint — Prisma's schema DSL has no partial/filtered-index
  /// syntax, and Postgres unique constraints already treat multiple NULLs as non-conflicting, so
  /// this sparse-column trick gets a real constraint without hand-edited migration SQL that a later
  /// `prisma migrate dev` diff could propose dropping (since schema.prisma can't represent it).
  openGroupId String? @unique

  startedAt             DateTime
  /// Whoever's activity opened the session. Never overwritten by later contributors to the same
  /// still-open session — only the first activity sets this.
  startedByTeamMemberId String?
  startedByTeamMember   InternalTeamMember? @relation("SupportSessionStarted", fields: [startedByTeamMemberId], references: [id], onDelete: SetNull)
  /// Nullable + SetNull, same "already-recorded history must outlive a later-deleted row" reasoning
  /// as SupportActivity.ruleId/keywordId — a purged SupportActivity row must never destroy this
  /// session's own startedAt/duration facts.
  firstActivityId       String?             @unique
  firstActivity         SupportActivity?    @relation("SupportSessionFirstActivity", fields: [firstActivityId], references: [id], onDelete: SetNull)

  completedAt             DateTime?
  /// Whoever's completion-keyword activity closed the session (automatic path only). Left null for
  /// a manual admin close, since InternalTeamMember and the admin's own User login are two
  /// unrelated identities in this schema with no reliable mapping between them — see
  /// completedByUserId below for that case instead of guessing/inventing a fake team member.
  completedByTeamMemberId String?
  completedByTeamMember   InternalTeamMember? @relation("SupportSessionCompleted", fields: [completedByTeamMemberId], references: [id], onDelete: SetNull)
  /// Set only for the automatic (completion-keyword) close path; null for a manual admin close,
  /// which has no backing SupportActivity row at all.
  completionActivityId    String?             @unique
  completionActivity      SupportActivity?    @relation("SupportSessionCompletionActivity", fields: [completionActivityId], references: [id], onDelete: SetNull)
  /// Set only for the manual admin-close path (apps/web/src/server/actions/supportSessions.ts),
  /// mirroring SupportEscalationCase.resolvedById's existing "which logged-in admin resolved this"
  /// pattern — reusing that convention rather than inventing a new audit mechanism. Mutually
  /// exclusive with completedByTeamMemberId in practice (automatic close never sets this; manual
  /// close never sets completedByTeamMemberId).
  completedByUserId       String?
  completedByUser         User?               @relation(fields: [completedByUserId], references: [id], onDelete: SetNull)

  /// Computed once at completion time (completedAt - startedAt, in whole seconds) and persisted —
  /// an immutable historical fact once closed, same "snapshot at terminal state" convention
  /// SupportEscalationCase uses for its own SLA-minute fields. Always null while OPEN; an
  /// in-progress session's "duration so far" is computed at render time from startedAt only, never
  /// stored/ticked.
  durationSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, groupId, status])
  @@index([status, startedAt])
  @@index([completedByTeamMemberId, completedAt])
}

// ---------------------------------------------------------------------------
// Softify Forge — product knowledge sourced from the ISPDIGITAL repository
// ---------------------------------------------------------------------------

/// Singleton row (id is always the literal string "global"), matching AutomationSettings and
/// friends. Everything defaults off: an install with no Forge credentials must behave exactly as
/// it did before this integration existed.
model ForgeSettings {
  id        String  @id @default("global")
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String  @unique @default(dbgenerated("project_id_required()"))
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  /// Master switch. Off means every Forge job is a no-op regardless of credentials.
  enabled Boolean @default(false)

  /// The Forge project whose repository this deployment learns from. Discovered via
  /// `GET /projects` and chosen by an admin — never guessed, because a key can be in scope for
  /// several projects and learning from the wrong one is silent and wrong.
  forgeProjectId   String?
  forgeProjectName String?

  /// Tier 1: hand-written, customer-facing documents (docs/user-guides/**, product overviews).
  /// Authoritative by definition — a guide the team wrote FOR customers.
  syncUserGuides Boolean @default(true)

  /// Tier 2: for each Forge module, read the source files behind it and write a user-facing
  /// explanation. This is the tier that lets the assistant answer about modules nobody has
  /// hand-documented yet, and the reason the disclosure gate exists.
  syncModuleGuides Boolean @default(true)

  /// Tier 3: when a customer question cannot be answered from verified knowledge, research it
  /// against the code and file the answer for review. Off by default — it spends AI budget in
  /// response to customer traffic, which an operator should opt into knowingly.
  researchUnanswered Boolean @default(false)

  /// Entries from tier 1 are published without review when true (an admin decision recorded here
  /// rather than hard-coded, so it can be tightened without a deploy). Tiers 2 and 3 are NEVER
  /// auto-verified: a model's reading of source code is evidence, not fact.
  autoVerifyUserGuides Boolean @default(true)

  lastSyncStartedAt   DateTime?
  lastSyncCompletedAt DateTime?
  /// Operator-facing text only — never a stack trace.
  lastSyncError       String?

  updatedAt DateTime @updatedAt
}

/// One question a customer asked that verified knowledge could not answer, queued for research
/// against the repository.
///
/// This is the "if the docs do not have the answer, go to the code" path. It deliberately runs
/// AFTER the customer has already been handed to a human rather than in front of them: reading
/// source code takes several API calls and many seconds, and — the real reason — it would put
/// raw source into the same prompt that drafts a customer reply. The answer it produces goes to
/// the review queue, so the NEXT customer to ask gets it instantly and safely.
model ForgeResearchTask {
  id        String  @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String  @default(dbgenerated("project_id_required()"))
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  /// The customer's question, verbatim, as the thing to research.
  question String

  /// The AI fallback decision that exposed the gap. SetNull rather than Cascade: pruning old
  /// decisions must not discard research that has not been done yet.
  fallbackDecisionId String?             @unique
  fallbackDecision   AiFallbackDecision? @relation(fields: [fallbackDecisionId], references: [id], onDelete: SetNull)

  /// Normalised keyword signature of the question (packages/engine's derivePatternSignature), so
  /// the same question asked fifty times queues one research task rather than fifty.
  signature String

  /// How many times this question has now been asked — the priority signal for which gap to
  /// close first.
  askedCount Int @default(1)

  status ForgeResearchStatus @default(PENDING)

  /// Which Forge module the router picked, if any — recorded so a reviewer can see what the
  /// research actually looked at.
  moduleSlug String?

  /// Operator-facing failure text; never a stack trace.
  error String?

  /// Set when research produced an entry, so the queue can link to what it created.
  producedItemId String?

  attemptCount Int       @default(0)
  scheduledAt  DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([projectId, signature])
  @@index([status, scheduledAt])
  @@index([askedCount])
}

enum ForgeResearchStatus {
  PENDING
  PROCESSING
  /// Research produced a knowledge entry, now awaiting human review like any other AI output.
  ANSWERED
  /// The code did not contain a customer-answerable answer, or every candidate entry was
  /// blocked by the disclosure gate. Kept, not deleted — it is the record of a real gap.
  NO_ANSWER
  FAILED
}

/// Singleton row (id is always the literal string "global").
///
/// How this support team talks, distilled from the replies its executives actually wrote, and
/// injected into the AI's reply prompt so its answers sound like the team rather than like a
/// model. It holds manner only — greetings, formality, sentence length, how a delay or a
/// complaint is acknowledged — and never a product fact: facts come from the knowledge base,
/// which has its own verification.
///
/// `humanApproved` is the trust boundary, and it is stricter than the knowledge base's. A wrong
/// knowledge entry produces one wrong answer; wrong style guidance shapes EVERY answer, so
/// guidance is applied to nothing until a person has read it. Rebuilding always clears it.
model CommunicationStyleProfile {
  id        String  @id @default("global")
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String  @unique @default(dbgenerated("project_id_required()"))
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  /// The distilled guidance, in prose, as it will be given to the model. Null until first built.
  guidance String?

  /// How many real support replies the current guidance was drawn from — the reviewer's main
  /// signal for whether it rests on enough evidence to trust.
  messagesAnalyzed Int @default(0)

  /// Newest reply covered, so a rebuild reads only what is new rather than everything again.
  builtThroughAt DateTime?
  lastBuiltAt    DateTime?
  /// Operator-facing text only — never a stack trace.
  lastError      String?

  /// Nothing reaches a customer until this is true. Cleared by every rebuild.
  humanApproved Boolean   @default(false)
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?     @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Team Management / Workforce Operations
// ---------------------------------------------------------------------------
//
// Three records, never one boolean. `DutyAssignment` is what was PLANNED, `TeamAttendanceDay` is
// what actually HAPPENED, and `LeaveRequest` is what was APPROVED. Off-day duty, no-activity and
// the leave-plus-activity conflict are all DERIVED by joining those three at read time. There is
// deliberately no fourth "actual status" column anywhere: a stored derivation drifts away from its
// own inputs the first time one of them is corrected, and then two screens disagree about the same
// day with no way to tell which is right.

enum DutyStatus {
  /// Scheduled to work.
  DUTY
  /// Scheduled day off.
  OFF
  /// Covered by approved leave.
  LEAVE
  /// An organisation holiday.
  HOLIDAY
  /// Filling in for somebody else. Counted separately so the same person is not volunteered twice.
  COVERAGE
  /// Working beyond their normal schedule at the manager's request.
  EXTRA_DUTY
  /// Nobody has decided yet. Deliberately distinct from OFF — "not decided" and "decided to be
  /// off" look identical on a rota and mean opposite things to whoever has to fill the gap.
  UNASSIGNED
}

enum DutyAssignmentSource {
  /// Materialised from the member's recurring weekly pattern.
  WEEKLY_SCHEDULE
  /// A manager set this date directly.
  MANUAL
  /// Created to fill a vacancy somebody else left.
  COVERAGE
  /// Written when leave was approved.
  LEAVE
  /// Written when a holiday was declared.
  HOLIDAY
  /// The other half of a shift change.
  SHIFT_CHANGE
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceSource {
  /// Derived from real group messages. The default, and the only automatic source.
  WHATSAPP_ACTIVITY
  /// A manager recorded this by hand.
  MANUAL
}

/// A manager's explicit verdict, which is the ONLY way a day becomes ABSENT.
///
/// Silence is never evidence of absence — somebody on the phone all day, or working in a group
/// this account cannot see, produces no messages and has still worked. The system reports
/// "no activity" and stops there; a person decides what that meant.
enum AttendanceOverride {
  /// Worked, despite no message evidence — field duty, phone support, a call-heavy day.
  WORKED
  /// Did not work. Only ever set by a human.
  ABSENT
  /// Away with the manager's knowledge, outside the leave workflow.
  EXCUSED
}

/// A named shift somebody can be put on.
///
/// Times are minutes from LOCAL midnight rather than a timestamp or a "13:00" string: that makes
/// them timezone-free, sortable, comparable for overlap, and able to cross midnight without a
/// second column saying so — `endMinute <= startMinute` means the shift ends the following day.
///
/// The three shifts this ships with are SEED DATA, not business rules. Nothing anywhere may branch
/// on the name "Morning" or on 10:00-19:00; the entire point is that an operator can add a night
/// shift, a weekend shift or a 09:00-18:00 from the UI without a code change.
model ShiftTemplate {
  id          String  @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId   String  @default(dbgenerated("project_id_required()"))
  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name        String
  /// Minutes from local midnight, 0-1439.
  startMinute Int
  /// Minutes from local midnight. Less than or equal to `startMinute` means it ends the next day.
  endMinute   Int

  /// How many people this shift needs before it counts as covered. A floor, never a cap — a
  /// manager may always assign more, and the gap report only ever complains about fewer.
  ///
  /// Measured against EFFECTIVE availability, never against a raw count of `DutyAssignment` rows.
  /// Two people assigned to Morning with one of them on approved leave is one person available,
  /// not two, and reporting it as covered is how a shift silently runs a man short. The assignment
  /// row is deliberately preserved when leave is approved (it is the historical plan), so the
  /// subtraction happens in the coverage query:
  ///
  ///   effectiveCoverage = assignments - unavailable (approved leave, and any other explicit
  ///                                                  unavailable state)
  ///   coverageGap       = max(0, requiredHeadcount - effectiveCoverage)
  requiredHeadcount Int @default(1)

  /// A `--chart-N` palette slot (1-6) so a shift is recognisable at a glance on the calendar
  /// without reading its name. Identity, not state: status colours stay reserved for status.
  colourSlot  Int?
  description String?
  isActive    Boolean @default(true)
  /// Display order in the roster grid; ties broken by name.
  position    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultForMembers InternalTeamMember[]
  weeklyEntries     WeeklyScheduleEntry[]
  dutyAssignments   DutyAssignment[]

  @@unique([projectId, name])
  @@index([isActive, position])
}

/// One member's recurring pattern for one weekday.
///
/// The ABSENCE of a row means "nobody has decided yet"; a row whose `shiftTemplateId` is null means
/// "decided: this person is off that day". Collapsing those two would make an unfilled rota look
/// like a fully-scheduled one, which is the single most dangerous thing a rota can do.
///
/// Weekday is 0=Sunday..6=Saturday, matching `getDhakaWeekRange`'s Sunday start — the regional
/// Fri/Sat weekend convention already encoded in `SupportActivityCountingPeriod`.
///
/// This is a template for FUTURE dates only. It never rewrites a `DutyAssignment` that already
/// exists; see that model's own comment.
model WeeklyScheduleEntry {
  id           String             @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId    String             @default(dbgenerated("project_id_required()"))
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  teamMemberId String
  teamMember   InternalTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  /// 0 = Sunday .. 6 = Saturday.
  weekday      Int

  /// Null means an explicit day off.
  shiftTemplateId String?
  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamMemberId, weekday])
  @@index([shiftTemplateId])
}

/// What one person is actually doing on one specific date. THE AUTHORITY for that date.
///
/// A default shift is not an actual daily shift. The weekly pattern and the member's default are
/// both only starting points; once a row exists here it wins, and changing either of those later
/// must never reach back and alter it.
///
/// That is why the shift's NAME and TIMES are snapshotted onto this row alongside the template FK.
/// Editing "Late" from 13:00-22:00 to 14:00-23:00 changes what Late means from now on; it must not
/// silently rewrite what somebody worked last Tuesday. The FK stays for grouping and coverage
/// counting; the snapshot is what is displayed and reasoned about. Same reasoning as
/// `SupportPriorityPolicy` snapshotting SLA minutes onto each case at creation.
///
/// One row per member per date, enforced by the unique constraint — which is also how "the same
/// person must not hold two overlapping shifts" is prevented at the database, rather than by an
/// application check somebody can forget to call.
///
/// That constraint is load-bearing for the coverage flow, not incidental. A replacement candidate
/// who already holds that date cannot be given a second row, so the workflow has to surface the
/// clash and let the manager choose — never silently write over the candidate's existing shift,
/// and never silently move a third person to make room. An upsert here would do exactly that, so
/// the coverage path creates rather than upserts and lets the unique violation be the guard.
model DutyAssignment {
  id           String             @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId    String             @default(dbgenerated("project_id_required()"))
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  teamMemberId String
  teamMember   InternalTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  /// The Dhaka calendar day. A cross-midnight shift belongs to the day it STARTS.
  dutyDate     DateTime           @db.Date
  status       DutyStatus         @default(UNASSIGNED)

  shiftTemplateId  String?
  shiftTemplate    ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id], onDelete: Restrict)
  /// Snapshotted at assignment time so history survives a template edit. Null when off or on leave.
  shiftName        String?
  shiftStartMinute Int?
  shiftEndMinute   Int?

  source DutyAssignmentSource @default(MANUAL)
  /// Why, in the manager's own words — "covering Bipul's leave", "operational requirement".
  reason String?

  assignedByUserId String?
  assignedBy       User?   @relation(fields: [assignedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamMemberId, dutyDate])
  /// "Who is on today", the most-run query in the module.
  @@index([dutyDate, status])
  /// Counting assigned headcount per shift per date, for the coverage-gap check.
  @@index([shiftTemplateId, dutyDate])
}

/// Every meaningful roster change, kept forever.
///
/// An immutable record rather than an edit in place, so "Rakib moved from Late to Morning on the
/// 12th, by Rudra, because of a staff shortage" survives every later change to that date. Modelled
/// on `AiKnowledgeVersion`, this schema's only other true history table.
///
/// `changeGroupId` is what makes a shift change readable afterwards: moving Rakib and putting Bipul
/// on the shift he vacated is ONE manager decision, and two unrelated rows would not say so.
model DutyAssignmentChange {
  id           String             @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId    String             @default(dbgenerated("project_id_required()"))
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  teamMemberId String
  teamMember   InternalTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  dutyDate     DateTime           @db.Date

  previousStatus    DutyStatus?
  previousShiftName String?
  newStatus         DutyStatus
  newShiftName      String?

  reason        String?
  /// Ties the halves of one operation together.
  changeGroupId String?

  changedByUserId String?
  changedBy       User?   @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([teamMemberId, dutyDate])
  @@index([createdAt])
  @@index([changeGroupId])
}

/// A kind of leave the organisation offers.
///
/// Entirely configurable. This schema states no legal policy of its own, because entitlement is a
/// decision for the business and differs by country — inventing one here would be a claim the
/// software is not entitled to make.
model LeaveType {
  id                  String  @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId           String  @default(dbgenerated("project_id_required()"))
  project             Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name                String
  /// Null means no allowance is tracked for this type, which is different from an allowance of 0.
  annualAllowanceDays Int?
  isPaid              Boolean @default(true)
  isActive            Boolean @default(true)
  position            Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests LeaveRequest[]

  @@unique([projectId, name])
  @@index([isActive, position])
}

/// One leave request, from asking to decided.
///
/// `requestedByUserId` exists from the first migration even though employees cannot submit one
/// yet. The manager-entered path and a future self-service path are the same record; adding the
/// column later would leave every existing row silently claiming the wrong person asked.
model LeaveRequest {
  id           String             @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId    String             @default(dbgenerated("project_id_required()"))
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  teamMemberId String
  teamMember   InternalTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  /// Inclusive Dhaka calendar dates.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  /// Counted once when the request is created, so a holiday declared later cannot retroactively
  /// change the size of an already-approved request.
  dayCount  Int

  reason String?
  status LeaveStatus @default(REQUESTED)

  requestedByUserId String?
  requestedBy       User?   @relation("LeaveRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  decidedByUserId String?
  decidedBy       User?     @relation("LeaveDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  managerNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamMemberId, startDate])
  @@index([status, startDate])
}

/// An organisation holiday. Never hardcoded — no national or religious calendar is assumed.
model Holiday {
  id          String   @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId   String   @default(dbgenerated("project_id_required()"))
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name        String
  date        DateTime @db.Date
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, date])
}

/// How much lateness this organisation is willing to call on time.
///
/// Duty History compares each day's snapshotted shift times against the first and last message
/// actually stored from that person. That comparison is arithmetic and needs no setting; deciding
/// how far past the shift start counts as LATE is a policy, and this module's design rule is that
/// a business rule is never hardcoded — the three shift templates exist as seed rows precisely so
/// that 10:00–19:00 is a decision somebody made rather than a constant in the source.
///
/// Two numbers rather than one, unlike `SupportActivitySettings.offlineAfterMinutes` which is
/// deliberately shared. These are not the same question asked at different moments: arriving late
/// and leaving early are judged differently by most teams, and a single tolerance would force one
/// of them to be wrong. Both are tolerances, so both are clamped at zero when read — a negative
/// grace would quietly become a requirement to arrive early.
///
/// A singleton, `id = "global"`, like every other settings row in this schema.
model TeamManagementSettings {
  id        String  @id @default("global")
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String  @unique @default(dbgenerated("project_id_required()"))
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  /// Minutes past the scheduled start before a first message counts as a late start. A smaller
  /// overrun is still SHOWN — "+8m" is visible on the row — it is simply not called late, which is
  /// the whole distinction a grace period exists to draw.
  latenessGraceMinutes Int @default(15)

  /// Minutes before the scheduled end that a last message may fall without counting as an early
  /// finish. Worth remembering when reading it: the last message is the last message, not the
  /// moment somebody stopped working.
  earlyDepartureGraceMinutes Int @default(15)

  updatedAt DateTime @updatedAt
}

/// Evidence that somebody worked on a given local day, derived from the messages they really sent.
///
/// The rule: a genuine message from an active team member in ANY group demonstrates work activity
/// for that Dhaka calendar day. Evidence, not a verdict — this table records what was observed and
/// never on its own declares somebody present or absent.
///
/// Counts are RECOMPUTED from `Message` on every hook run, never incremented. Incrementing looks
/// cheaper and is wrong: a replayed message, a worker retry or a reconnect would each add one
/// again. Recomputing converges on the same answer however many times it runs SEQUENTIALLY.
///
/// Sequentially is not enough on its own, and this is the subtle part. Two messages arriving at
/// once give two concurrent recomputes: A reads nine messages, B reads ten and writes ten, then A
/// writes its stale nine. A lost update, and the count is quietly wrong with nothing to show for
/// it. So the recompute takes a Postgres transaction-scoped advisory lock keyed on
/// (teamMemberId, activityDate) and does the read and the write inside one transaction. The lock
/// is held in the DATABASE, not in worker memory — two worker processes have no shared memory to
/// lock in, and the whole point is that this stays correct across them.
///
/// A manual correction sits BESIDE the evidence in its own columns rather than overwriting it, so
/// "the manager says he worked, and there were no messages" stays readable as exactly that.
model TeamAttendanceDay {
  id           String             @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId    String             @default(dbgenerated("project_id_required()"))
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  teamMemberId String
  teamMember   InternalTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  /// Dhaka calendar day.
  activityDate DateTime           @db.Date

  messageCount     Int       @default(0)
  uniqueGroupCount Int       @default(0)
  firstActivityAt  DateTime?
  lastActivityAt   DateTime?

  source AttendanceSource @default(WHATSAPP_ACTIVITY)

  /// Set only when a manager overrides the evidence. Null means the evidence stands on its own.
  override           AttendanceOverride?
  overrideReason     String?
  overriddenByUserId String?
  overriddenBy       User?               @relation(fields: [overriddenByUserId], references: [id], onDelete: SetNull)
  overriddenAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups TeamAttendanceGroup[]

  @@unique([teamMemberId, activityDate])
  @@index([activityDate])
}

/// Which groups a day's activity happened in, and how much in each.
///
/// One row per group per day rather than one per message: seven messages across two groups is two
/// rows, not seven. The composite primary key is the upsert target, so a recompute rewrites these
/// in place instead of accumulating duplicates.
///
/// `accountId` is kept because the same WhatsApp group is a separate row per account and that
/// attribution has to survive — even though the attendance itself belongs to the person rather
/// than to whichever number happened to receive them.
model TeamAttendanceGroup {
  attendanceDayId String
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId       String            @default(dbgenerated("project_id_required()"))
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  attendanceDay   TeamAttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  groupId         String
  group           WhatsAppGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  accountId       String
  account         WhatsAppAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  messageCount Int      @default(0)
  firstAt      DateTime
  lastAt       DateTime

  @@id([attendanceDayId, groupId])
  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Release Notes -- a permanent, publishable record of what shipped.
//
// Deliberately its own small module rather than reusing an existing entity: audited first, and
// nothing already in this schema is this. `SystemLog` records what the SOFTWARE did technically;
// this records what was DELIVERED to the people using it, in their language, and is meant to be
// read by every user, not just an admin debugging something. `NotificationTemplate` is wording for
// an alert this app sends automatically; a release note is authored content about the product
// itself. Neither is a version history, so this is additive, not a duplicate.

/// What kind of change a release mostly consists of -- for the badge next to its version, not a
/// state. Named with the model prefix (`ReleaseNoteType`, not `ReleaseType`) to match every other
/// enum in this schema (`RuleStatus`, `DutyStatus`, `LeaveStatus`, ...).
enum ReleaseNoteType {
  MAJOR
  FEATURE
  IMPROVEMENT
  BUG_FIX
  SECURITY
  MAINTENANCE
}

/// DRAFT -> PUBLISHED -> ARCHIVED, mirroring `RuleStatus`'s own three-and-a-half-state shape
/// (DRAFT/ACTIVE/DISABLED/ARCHIVED) rather than inventing a different vocabulary for what is
/// structurally the same lifecycle: authored-but-not-live, live, and retired-but-kept.
///
/// PUBLISHED and ARCHIVED are BOTH publicly visible -- "every release should remain available
/// historically" is a stated requirement, and archiving a release is retiring it from being the
/// *current* one, not erasing that it happened. Only DRAFT is hidden from every user-facing read;
/// see `getPublishedReleaseNotes()`.
enum ReleaseNoteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// One entry in the product's changelog.
///
/// Content is seven plain `String[]` sections (one bullet per array element) rather than a single
/// markdown/rich-text body: this codebase has no markdown renderer or rich-text editor anywhere
/// (audited before adding one), and `String[] @default([])` is already this schema's established
/// way to store a short list of lines (`Message.mentionedPhones`, `AutomationRule.keywords`,
/// `AiSettings.takeoverNotifyGroupIds`, ...). A real array is also what lets the public page render
/// each bullet as its own list item with zero parsing -- a markdown blob would need a renderer this
/// app doesn't have, for content that was always going to be authored as bullets in the first place.
///
/// `affectedModules` is likewise a plain `String[]`, not a Prisma enum of module names. The set of
/// modules this product ships grows continuously (Team Management shipped this week), and an enum
/// would need a schema migration every time a new one is added just to tag a release with it. The
/// admin editor offers a fixed suggested list from `packages/shared` for consistency, but the
/// column itself accepts anything, so a module added after this ships is never a migration blocker.
///
/// `version` is `@unique` -- one row per version, the same way `ShiftTemplate.name` or
/// `LeaveType.name` are the natural identity for their own small admin-managed catalogs.
///
/// Editing a PUBLISHED row is allowed (a typo fix, a late correction) and the previous content is
/// preserved first as a `ReleaseNoteRevision` -- see that model. A DRAFT can be freely edited and
/// deleted with no history kept, since nothing public was ever built on it; a PUBLISHED or ARCHIVED
/// row can never be deleted at all, only unpublished/archived, matching this app's existing
/// soft-delete-over-hard-delete standard and Phase 10's explicit "must never accidentally
/// disappear" requirement -- there is deliberately no code path that hard-deletes one.
model ReleaseNote {
  id          String            @id @default(cuid())
  version     String            @unique
  title       String
  summary     String?
  /// The Dhaka calendar day being announced, not a timestamp -- matches `DutyAssignment.dutyDate`'s
  /// own `@db.Date` for the same reason: a release date is a day, not a moment.
  releaseDate DateTime          @db.Date
  releaseType ReleaseNoteType   @default(FEATURE)
  status      ReleaseNoteStatus @default(DRAFT)

  whatsNew        String[] @default([])
  improvements    String[] @default([])
  bugFixes        String[] @default([])
  security        String[] @default([])
  breakingChanges String[] @default([])
  knownIssues     String[] @default([])
  technicalNotes  String[] @default([])

  affectedModules String[] @default([])

  createdByUserId String?
  createdBy       User?   @relation("ReleaseNoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// Set once, on the FIRST publish, and never cleared by a later unpublish/archive/re-publish --
  /// same reasoning as `AiFallbackDecision.aiProviderId` being a snapshot rather than a live link:
  /// this is a record of who published it and when, and un-publishing must not make that fact
  /// disappear.
  publishedByUserId String?
  publishedBy       User?     @relation("ReleaseNotePublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  publishedAt       DateTime?

  /// 0 while this has never been published. Becomes 1 the moment it is first published (that
  /// publish itself writes revision v1, a snapshot of exactly what went live), and increments by
  /// one on every later edit made while PUBLISHED or ARCHIVED, or on every later re-publish — each
  /// bump pairs with a new `ReleaseNoteRevision` row of the same number. A pure status transition
  /// with no content change (archive, unpublish) never touches this. Mirrors
  /// `AiKnowledgeItem.currentVersion` exactly, the one other place this schema keeps a running
  /// edit counter beside its own history table.
  currentVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions ReleaseNoteRevision[]

  // Serves the admin list, which is almost always filtered to one status and sorted newest-first.
  @@index([status, releaseDate])
  // Serves the public feed, which reads PUBLISHED *and* ARCHIVED together (an IN-list, not an
  // equality match the composite index above serves as well) sorted newest-first.
  @@index([releaseDate])
}

/// An after-image snapshot of one `ReleaseNote`'s content — version 1 is exactly what was true the
/// moment it was first published, version 2 is what it became after the first post-publish edit,
/// and so on — so "what did v1.8.0 actually say the day it shipped" stays answerable even after a
/// later correction. Modelled directly on `AiKnowledgeVersion`, this schema's other content-history
/// table, and the same reasoning: an incrementing `version` int unique per parent, the full set of
/// editable columns duplicated onto the snapshot row, an optional actor, `createdAt` only — nothing
/// here is ever updated once written, and the parent's own `currentVersion` says which number its
/// live row currently matches.
///
/// Nothing is snapshotted for a DRAFT edit, or for a pure status change (archive/unpublish/
/// re-publish) with no content change: a draft was never public, and a status flip did not alter
/// what the words say, so there is nothing new here worth a row.
model ReleaseNoteRevision {
  id            String      @id @default(cuid())
  releaseNoteId String
  releaseNote   ReleaseNote @relation(fields: [releaseNoteId], references: [id], onDelete: Cascade)
  /// 1, 2, 3, ... per releaseNoteId -- which edit this was, not a foreign version number.
  version       Int

  title           String
  summary         String?
  releaseDate     DateTime          @db.Date
  releaseType     ReleaseNoteType
  status          ReleaseNoteStatus
  whatsNew        String[]
  improvements    String[]
  bugFixes        String[]
  security        String[]
  breakingChanges String[]
  knownIssues     String[]
  technicalNotes  String[]
  affectedModules String[]

  changedByUserId String?
  changedBy       User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@unique([releaseNoteId, version])
}

// ============================================================================
// AI Sandbox — Conversation Learning
// ----------------------------------------------------------------------------
// An isolated place to ask the AI a question and see exactly what production
// WOULD have done with it, without a customer being involved at any point.
//
// The isolation is structural, not a promise. A sandbox turn is its own row in
// its own table: nothing here writes a Message, an AiFallbackDecision, an
// OutboundMessage, a SupportActivity, a SupportSession or a Notification, and
// no production reader ever selects from these tables. That is why this is a
// separate model rather than an `isTest` flag on AiFallbackDecision — a flag is
// one forgotten `where` clause away from test traffic appearing in the AI
// Activity log, in Team Performance, or in the figures on Overview.
//
// The other direction is gated too: an approved sandbox answer is a "validated
// learning example" and nothing more until somebody explicitly promotes it, and
// even then it lands in the knowledge base UNVERIFIED, in the same review queue
// every other machine-written entry goes through. Sandbox never reaches a
// customer in one step.
// ============================================================================

/// Where a turn is in the worker's queue. Mirrors the claim-style lifecycle every
/// other queue in this worker uses (OutboundMessage, KnowledgeImport): the web app
/// only ever writes PENDING, and exactly one worker tick moves it to PROCESSING.
enum SandboxTurnStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

/// What production would have done with this message. The same two outcomes
/// AiFallbackDecision records, deliberately named identically so a sandbox result
/// reads the same way the AI Activity log does.
enum SandboxOutcome {
  AI_REPLIED
  HUMAN_FALLBACK
}

/// The admin's verdict on an AI answer. WAITING is the default and is a real
/// state, not an absence — "nobody has judged this yet" is exactly what the
/// review list needs to show.
enum SandboxReviewStatus {
  WAITING
  APPROVED
  REJECTED
}

model SandboxSession {
  id        String  @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String  @default(dbgenerated("project_id_required()"))
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// Optional name for the scenario being tested ("billing question, no client id").
  label     String?

  /// Optional: answer as though the message arrived in this group. Affects only the
  /// group name in the prompt and the same-group tie-break in knowledge ranking —
  /// it never reads that group's real messages and never writes anything to it.
  /// SetNull rather than Cascade: a deactivated group must not delete test history.
  groupId String?
  group   WhatsAppGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turns SandboxTurn[]

  @@index([createdAt])
}

model SandboxTurn {
  id        String         @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String         @default(dbgenerated("project_id_required()"))
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sessionId String
  session   SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// What the admin typed, standing in for a customer message.
  userMessage String
  status      SandboxTurnStatus @default(PENDING)

  /// --- What the AI decided, once the worker has run this turn -------------
  outcome         SandboxOutcome?
  /// The diagnostic code production would have recorded on a handover
  /// (NO_BUSINESS_KNOWLEDGE, AI_DECLINED, LOW_CONFIDENCE, AI_UNAVAILABLE...).
  /// This is the single most useful thing a sandbox can show: not just what the
  /// AI said, but which gate would have stopped it saying it.
  reason          String?
  responseText    String?
  intent          String?
  scope           String?
  confidenceScore Int?
  modelId         String?
  tokensUsed      Int?
  /// Titles of the verified knowledge entries that grounded this answer, so the
  /// reviewer can see WHY it answered the way it did rather than guessing.
  knowledgeTitles String[]
  /// Set only when the turn itself failed (provider unreachable, etc.) — distinct
  /// from a HUMAN_FALLBACK outcome, which is the system working correctly.
  error           String?

  /// --- The admin's correction ----------------------------------------------
  /// The answer as an admin rewrote it. `responseText` is never overwritten, so the
  /// original AI answer stays readable beside the correction — that pair is the audit
  /// trail. Null means unedited. The FINAL answer is always `editedResponseText ??
  /// responseText`, and it is the only text Verify and Make Knowledge ever use. Also how
  /// an admin writes the answer to a turn the AI handed over and drafted nothing for.
  editedResponseText String?
  /// Plain ids, not relations — same reasoning as promotedKnowledgeItemId below.
  editedById         String?
  editedAt           DateTime?

  /// --- The admin's review -------------------------------------------------
  review       SandboxReviewStatus @default(WAITING)
  reviewedById String?
  reviewedBy   User?               @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  /// Set once an approved example has been explicitly promoted into the knowledge
  /// base, so it can never be promoted twice. Deliberately NOT a relation: the
  /// knowledge item is free to be archived or deleted without taking the test
  /// history with it, and a dangling id here is readable as "was promoted".
  promotedKnowledgeItemId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([sessionId, createdAt])
  /// The worker's claim query.
  @@index([status, createdAt])
  /// The review list's own query shape, mirroring AiKnowledgeItem's review index.
  @@index([review, createdAt])
}

// ============================================================================
// Knowledge Builder — on-demand "Learn from Conversations"
// ----------------------------------------------------------------------------
// The admin-driven counterpart to startGroupKnowledgeProcessor. That job runs on
// its own, hourly, one group at a time, oldest-first, and writes straight into
// AiKnowledgeItem as unverified. This one is the opposite in every respect an
// admin cares about: THEY pick the groups, THEY pick the time range, they press
// a button, and they get a reviewable list back.
//
// Three rules keep the two from interfering with each other:
//
//  1. This path NEVER writes WhatsAppGroup.knowledgeBuiltAt/knowledgeBuiltThroughAt.
//     Those are the background builder's incremental watermark; moving them here
//     would make that job silently skip conversations nobody has learned from.
//  2. This path NEVER writes AiKnowledgeItem directly. It produces candidates;
//     only an explicit human approval turns one into a knowledge entry.
//  3. It reads Message rows and nothing else. No WhatsApp traffic, no rules, no
//     queue — the same read-only posture as the background builder.
// ============================================================================

/// How the analysed window was chosen. LATEST_MESSAGES reads the most recent N
/// messages per group; the rest bound by time. Stored rather than resolved to
/// dates up front so the run still reads as the intent it was created with.
enum ConversationRangeKind {
  LATEST_MESSAGES
  LAST_24_HOURS
  LAST_7_DAYS
  CUSTOM
}

enum ConversationAnalysisStatus {
  QUEUED
  RUNNING
  COMPLETE
  /// Finished, but at least one group failed — the candidates from the groups
  /// that succeeded are kept, matching KnowledgeImport's own PARTIAL semantics.
  PARTIAL
  FAILED
}

enum ConversationCandidateStatus {
  WAITING
  APPROVED
  REJECTED
}

model ConversationAnalysisRun {
  id        String  @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String  @default(dbgenerated("project_id_required()"))
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  label     String?

  /// Snapshot of the selection, in the order it will be worked through. A plain
  /// array rather than a join table: it is an immutable record of what was asked
  /// for, and a group later deactivated must not silently drop out of the history.
  groupIds     String[]
  rangeKind    ConversationRangeKind
  rangeStart   DateTime?
  rangeEnd     DateTime?
  /// Only for LATEST_MESSAGES.
  messageLimit Int?

  status            ConversationAnalysisStatus @default(QUEUED)
  groupsTotal       Int                        @default(0)
  /// Doubles as the cursor: groupIds[groupsDone] is the next group to process.
  groupsDone        Int                        @default(0)
  candidatesCreated Int                        @default(0)
  /// The last group-level failure, kept so a PARTIAL run can say what went wrong.
  error             String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  candidates ConversationCandidate[]

  @@index([status, createdAt])
  @@index([createdAt])
}

model ConversationCandidate {
  id        String                  @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId String                  @default(dbgenerated("project_id_required()"))
  project   Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  runId     String
  run       ConversationAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  groupId   String?
  group     WhatsAppGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Snapshot, so a renamed or deactivated group still reads correctly on an old run.
  groupName String

  title      String
  category   AiKnowledgeCategory
  question   String?
  answer     String
  /// Ordered steps the extractor found in the conversation, or null when it found none — carried
  /// through review so an approved candidate keeps its procedure instead of arriving in the
  /// knowledge base as an answer with the steps stripped off.
  procedure  String?
  module     String?
  confidence Int

  status       ConversationCandidateStatus @default(WAITING)
  reviewedById String?
  reviewedBy   User?                       @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  /// Set once approval has created the knowledge entry, so one candidate can never
  /// be published twice. Not a relation, for the same reason SandboxTurn's is not:
  /// archiving the knowledge entry must not delete the record that it came from here.
  promotedKnowledgeItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------------------------
// Main Admin Configuration (MAIN_ADMIN_WORKSPACE.md §5): the organisation, platform-wide.
//
// None of these carries a projectId: a department, a job title or a person belongs to the company,
// not to one project. They are deliberately NOT the WhatsApp support `Team` (per project, with
// TeamMembership history used by Team Report) and NOT a permission role (`PermissionModule`, what a
// login may do). A job title grants nothing.
// ---------------------------------------------------------------------------------------------

/// A department of the organisation. Deactivated rather than deleted once an employee uses it.
model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  /// Optional short code ("SUP", "BILL"), unique when given.
  code        String?    @unique
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]
}

/// A job title ("Support Executive"). A label for a person — never a permission.
model JobTitle {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

/// A person in the organisation — separate from their login (`User`), which they may or may not
/// have, and from their WhatsApp roster entries (`InternalTeamMember`, one per project).
model Employee {
  id           String         @id @default(cuid())
  /// "EMP-000123": assigned once, from the `employee_code_seq` sequence, never reused or edited.
  employeeCode String         @unique
  fullName     String
  email        String?        @unique
  phone        String?
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitleId   String?
  jobTitle     JobTitle?      @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  /// Their login, if they have one. One login per person and one person per login.
  userId       String?        @unique
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  status       EmployeeStatus @default(ACTIVE)
  joinedOn     DateTime?      @db.Date
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([departmentId])
  @@index([jobTitleId])
}

/// One person clearing one WhatsApp operation (Add Number to Groups, Groups Admin Maker) from THEIR
/// operation tracker — the job indicator and a module page's "Current operation". Display only: the
/// job, its items and everything it already did are untouched, and its own page still shows it.
/// The operation stays hidden while its state is `stateAtDismissal`; when it moves on (a review is
/// continued, a running job finishes or needs a person) it shows again, because that is news.
/// Per user, not per job: clearing it for yourself never hides it from a colleague.
model WhatsAppOperationDismissal {
  id               String   @id @default(cuid())
  projectId        String   @default(dbgenerated("project_id_required()"))
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "ADD_NUMBER_TO_GROUPS" | "ADMIN_MAKER" — the operation kind, as packages/shared names it.
  kind             String
  /// The job row's id (GroupParticipantAddJob / GroupAdminPromotionJob).
  jobId            String
  /// The operation state it was cleared in (WhatsAppOperationState).
  stateAtDismissal String
  dismissedAt      DateTime @default(now())

  @@unique([projectId, userId, kind, jobId])
  @@index([projectId, userId])
}

// ---------------------------------------------------------------------------------------------
// Mood Detection (MOOD_DETECTION.md). Detection is separate from action: a CustomerMoodEvent is one
// customer message's reading; a MoodAlert is the cooldown unit (one per escalation of one customer
// in one group); a MoodAlertAction is one configured action of that alert, retried on its own.

enum MoodEventStatus {
  /// Recorded by the pipeline's deterministic pre-filter; waiting for the mood processor.
  PENDING
  PROCESSING
  /// Finished: final mood decided, trigger evaluated, any alert created.
  ANALYZED
  FAILED
}

enum MoodAlertActionStatus {
  PENDING
  PROCESSING
  DONE
  /// Deliberately not done (no destination, unreachable member, safety refused the send…).
  SKIPPED
  FAILED
}

/// Settings → Mood Detection. One row per project; an absent row means the defaults (off).
model MoodDetectionSettings {
  id                                String   @id @default("global")
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId                         String   @unique @default(dbgenerated("project_id_required()"))
  project                           Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  enabled                           Boolean  @default(false)
  analyzeText                       Boolean  @default(true)
  analyzeEmoji                      Boolean  @default(true)
  analyzeStickers                   Boolean  @default(true)
  /// Ask the AI (the RESPONSE job's model) about ambiguous readings only. The deterministic
  /// pre-filter always runs first; a message with no emotional signal never reaches the AI.
  useAiClassification               Boolean  @default(false)
  /// LOW | BALANCED | HIGH | CUSTOM (packages/shared/src/mood.ts SENSITIVITY_THRESHOLDS).
  sensitivity                       String   @default("BALANCED")
  /// The threshold (50–99) used when sensitivity is CUSTOM.
  minConfidence                     Int      @default(80)
  /// One alert per customer per group inside this window; a higher level inside it adds only the
  /// actions the lower one did not take.
  cooldownMinutes                   Int      @default(30)
  /// Internal escalation group(s): WhatsApp group ids (…@g.us), chosen with the group picker —
  /// the same form as every other alert destination.
  internalGroupIds                  String[] @default([])
  /// Per-mood action policy (MoodPolicies). Null = DEFAULT_MOOD_POLICIES.
  policies                          Json?
  /// Who an internal alert mentions when the group has no assigned member:
  /// OPTED_IN (members opted into Mood alerts, at most three) | NONE.
  unassignedMention                 String   @default("OPTED_IN")
  /// Skip the customer-facing message when nobody is assigned to the group.
  skipCustomerMessageWhenUnassigned Boolean  @default(false)
  /// How long "Require human takeover" holds AI replies back unless a person replies first.
  requireHumanHours                 Int      @default(24)
  updatedById                       String?
  updatedAt                         DateTime @updatedAt
}

/// One customer message's mood reading — the job row the processor claims, and the history.
model CustomerMoodEvent {
  id              String          @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId       String          @default(dbgenerated("project_id_required()"))
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// One reading per message: the idempotency guard for replays and redeliveries.
  messageId       String          @unique
  message         Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  accountId       String
  account         WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId         String
  group           WhatsAppGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// The WhatsApp group itself (…@g.us). Two accounts in one group store one Message row each, so
  /// trend, twin detection and the alert cooldown key on this rather than on a group row.
  whatsappGroupId String
  /// The customer, as Message.senderPhone (digits or a LID). Mood is per customer; the group's
  /// mood is an aggregate of these.
  customerKey     String
  /// The message's own WhatsApp time — what trend and "mood at the time of response" read.
  messageAt       DateTime
  /// Final reading (packages/shared/src/mood.ts MOODS). Text, not an enum: a new mood needs no
  /// migration. Before analysis: the deterministic reading.
  mood            String
  /// 0–1.
  confidence      Float
  scores          Json?
  /// Structured reasons (MOOD_SIGNALS). Never model reasoning.
  signals         String[]        @default([])
  previousMood    String?
  /// MOOD_LEVEL of the final mood (0–4).
  level           Int             @default(0)
  /// The pre-filter judged the reading ambiguous enough to be worth an AI classification.
  aiRequested     Boolean         @default(false)
  aiUsed          Boolean         @default(false)
  triggered       Boolean         @default(false)
  /// Why it did or did not trigger, in words (decideMoodTrigger().because or a skip reason).
  decisionNote    String?
  status          MoodEventStatus @default(PENDING)
  attempts        Int             @default(0)
  lastError       String?
  scheduledAt     DateTime
  analyzedAt      DateTime?
  alertId         String?
  alert           MoodAlert?      @relation(fields: [alertId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, scheduledAt])
  @@index([whatsappGroupId, customerKey, messageAt])
  @@index([groupId, messageAt])
  @@index([projectId, messageAt])
}

/// One escalation of one customer in one group — the cooldown unit. Exactly one alert per
/// escalation: later angry messages inside the cooldown attach to it instead of alerting again.
model MoodAlert {
  id              String              @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId       String              @default(dbgenerated("project_id_required()"))
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  accountId       String
  account         WhatsAppAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId         String
  group           WhatsAppGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// The WhatsApp group (…@g.us): the cooldown is per WhatsApp group and customer, whichever
  /// account's copy of the message arrived first.
  whatsappGroupId String
  customerKey     String
  /// The highest mood this alert reached, its level, and the priority that mood's policy set.
  mood            String
  level           Int
  priority        String
  confidence      Float
  signals         String[]            @default([])
  /// The message that opened it, and the latest one that raised or extended it.
  firstMessageId  String
  latestMessageId String
  /// Readings that triggered while this alert was open (the first included).
  triggerCount    Int                 @default(1)
  openedAt        DateTime            @default(now())
  cooldownUntil   DateTime
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  events          CustomerMoodEvent[]
  actions         MoodAlertAction[]

  @@index([whatsappGroupId, customerKey, cooldownUntil])
  @@index([groupId, openedAt])
  @@index([projectId, openedAt])
}

/// One configured action of one alert, retried independently: a failed team notification never
/// blocks the AI pause, and the AI pause never waits on WhatsApp.
model MoodAlertAction {
  id          String                @id @default(cuid())
  /// The project this row belongs to. Every write must name it: the default raises (no default
  /// project since MULTI_PROJECT_PLAN.md Phase 3).
  projectId   String                @default(dbgenerated("project_id_required()"))
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  alertId     String
  alert       MoodAlert             @relation(fields: [alertId], references: [id], onDelete: Cascade)
  /// CONVERSATION | NEEDS_ATTENTION | NOTIFY_TEAM | INTERNAL_ALERT | CUSTOMER_MESSAGE
  action      String
  status      MoodAlertActionStatus @default(PENDING)
  attempts    Int                   @default(0)
  /// What was done or why not, in words.
  detail      String?
  lastError   String?
  scheduledAt DateTime
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([alertId, action])
  @@index([status, scheduledAt])
}
