# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values before running Docker Compose.
# Both `app` and `worker` read DATABASE_URL to reach the same `postgres` service.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=support_automation
POSTGRES_PASSWORD=change_me
POSTGRES_DB=support_automation
POSTGRES_PORT=5432

# Used by both apps/web and apps/worker (Prisma). Host is the Compose service name.
DATABASE_URL=postgresql://support_automation:change_me@postgres:5432/support_automation?schema=public

# --- apps/web (Next.js dashboard) ---
NODE_ENV=production
WEB_PORT=3000
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me

# --- Seed data (Phase 2) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me

# --- apps/worker (OpenWA) ---
# Chromium binary path inside the worker container (set in the worker Dockerfile's base image).
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Directory OpenWA is configured to persist its session/auth data to.
# This MUST match the path verified at runtime in Phase 5 and the docker-compose volume mount.
WHATSAPP_SESSION_DIR=/app/sessions
WHATSAPP_SESSION_NAME=support-automation
# Puppeteer stealth plugin — helps avoid headless-automation detection during
# the WhatsApp Web login/QR flow. Default true; set to "false" only if it
# causes an unrelated browser.setMaxListeners issue (see OpenWAProvider.ts).
WHATSAPP_USE_STEALTH=true
# OpenWA's default customUserAgent hardcodes Chrome/104.0.0.0, which current
# WhatsApp Web now rejects with a "please update your browser" page instead
# of showing the QR (see OpenWAProvider.ts, Phase 5.1 root cause). Override
# to match whatever Chrome/Chromium major version is actually installed —
# check with `chromium --version` inside the worker container/image.
WHATSAPP_CUSTOM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36
# Phase 5.2 — bounds how long a single getAllGroups() attempt is allowed to
# run before commandProcessor.ts treats it as failed and retries. Fires
# before Puppeteer's own unconfigurable 180s protocolTimeout, with a clear
# error, so a slow/stuck sync can no longer crash the whole worker (see
# commandProcessor.ts's syncGroupsWithTimeoutAndRetry).
WHATSAPP_GROUP_SYNC_TIMEOUT_MS=150000

# --- Notifications (configurable in-app too; env vars are the initial/default values) ---
TEAMS_WEBHOOK_URL=
WHATSAPP_NOTIFICATION_GROUP_ID=
