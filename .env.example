# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values before running Docker Compose.
# Both `app` and `worker` read DATABASE_URL to reach the same `postgres` service.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
# No POSTGRES_PORT / host port mapping: Postgres is never published to the host or the public
# internet in this stack — app/worker/migrate reach it internally over the automation_net Docker
# network via the `postgres` service name only. See docker-compose.yml's postgres service comment.
POSTGRES_USER=support_automation
POSTGRES_PASSWORD=change_me
POSTGRES_DB=support_automation

# Used by both apps/web and apps/worker (Prisma). Host is the Compose service name.
DATABASE_URL=postgresql://support_automation:change_me@postgres:5432/support_automation?schema=public

# Timezone for both apps/web (Rule Tester's "now") and apps/worker (live rule evaluation,
# including AutomationRule.conditions.timeWindow hour/day comparisons). Must be an IANA tz name.
# Defaults to Asia/Dhaka to match this deployment; change if operating elsewhere.
TZ=Asia/Dhaka

# --- apps/web (Next.js dashboard) ---
NODE_ENV=production
WEB_PORT=8668
# Production: https://assist.softifybd.com — must match the public origin exactly, or every
# login redirects back to /login.
NEXTAUTH_URL=http://localhost:8668
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me
# The session cookie (apps/web/src/server/auth.ts) and Teams OAuth state cookie
# (apps/web/src/server/teamsAuth/index.ts) are Secure by default in production, which browsers
# silently refuse to store/send over plain HTTP — logins would appear to work but bounce back to
# /login on the very next click. Leave unset (Secure stays on) once you have a TLS-terminating
# reverse proxy in front of the app. Set to "false" ONLY for a deployment intentionally served over
# plain HTTP with no TLS — the session cookie then travels in cleartext.
COOKIE_SECURE=true

# --- AI Learning module (apps/web) ---
# Encrypts AI provider API keys at rest. Generate with: openssl rand -base64 32
AI_CREDENTIALS_ENCRYPTION_KEY=change_me

# --- Seed data (Phase 2) ---
# Applied automatically on every `docker compose up` by the one-shot `migrate` service
# (idempotent — only sets these on first creation, never resets an already-changed password).
# Change these before exposing the dashboard outside your own machine/network.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin

# --- apps/worker (OpenWA) ---
# Chromium binary path inside the worker container (set in the worker Dockerfile's base image).
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Directory OpenWA is configured to persist its session/auth data to.
# This MUST match the path verified at runtime in Phase 5 and the docker-compose volume mount.
WHATSAPP_SESSION_DIR=/app/sessions
WHATSAPP_SESSION_NAME=support-automation
# Puppeteer stealth plugin — helps avoid headless-automation detection during
# the WhatsApp Web login/QR flow. Default true; set to "false" only if it
# causes an unrelated browser.setMaxListeners issue (see OpenWAProvider.ts).
WHATSAPP_USE_STEALTH=true
# OpenWA's default customUserAgent hardcodes Chrome/104.0.0.0, which current
# WhatsApp Web now rejects with a "please update your browser" page instead
# of showing the QR (see OpenWAProvider.ts, Phase 5.1 root cause). Override
# to match whatever Chrome/Chromium major version is actually installed —
# check with `chromium --version` inside the worker container/image.
WHATSAPP_CUSTOM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36
# Phase 5.2 — bounds how long a single getAllGroups() attempt is allowed to
# run before commandProcessor.ts treats it as failed and retries. Fires
# before Puppeteer's own unconfigurable 180s protocolTimeout, with a clear
# error, so a slow/stuck sync can no longer crash the whole worker (see
# commandProcessor.ts's syncGroupsWithTimeoutAndRetry).
WHATSAPP_GROUP_SYNC_TIMEOUT_MS=150000

# Diagnostics for the hardest failure this worker has: a session reporting itself healthy while
# nothing arrives. Leave both off — they are for an investigation, not for running.
#   WHATSAPP_DEBUG_BROWSER  the library's own console output and a screenshot on a launch failure.
#   WHATSAPP_DEBUG_EVENTS   every event the library raises, printed with its namespace. This is how
#                           you tell "WhatsApp told us nothing" apart from "we stopped listening",
#                           which reading the library's source cannot answer: it establishes what
#                           the library COULD emit, not what today's WhatsApp Web build makes it do.

WHATSAPP_DEBUG_BROWSER=false
WHATSAPP_DEBUG_EVENTS=false

# --- Notifications (configurable in-app too; env vars are the initial/default values) ---
TEAMS_WEBHOOK_URL=
WHATSAPP_NOTIFICATION_GROUP_ID=

# --- AI provider from the environment (optional) ---
# Seeds an OpenRouter AiProvider + model config on worker boot, so a deployment is usable without
# opening the dashboard first. Never overwrites a provider an admin already configured.
# OpenRouter resolves a bare model id (gpt-4o-mini) to its vendor-prefixed form itself.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Softify Forge: product knowledge from the ISPDIGITAL repository (optional) ---
# Read-only. Lets the assistant learn what the product does so it can answer customer questions.
# Nothing happens until BOTH are set and an admin enables the integration in the dashboard
# (AI Learning -> Product Knowledge). See FORGE_SETUP.md.
FORGE_API_KEY=
FORGE_API_URL=https://forge.softifybd.com/api/v1

# --- Google Sheets work management (GOOGLE_SHEETS.md) — optional ---
# OPTIONAL FALLBACK. Each project saves its own OAuth client under Settings → Google Sheets; these are
# used only by a project that has not. One Google OAuth client ("Web application"). Authorised redirect URI:
#   <NEXTAUTH_URL>/api/google/oauth/callback
# Enable the Google Drive API, Google Sheets API and Drive Activity API in the same Google Cloud
# project. The secret stays on the server (app and worker) and is never sent to a browser.
# Empty = the module explains how to set it up.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- WhatsApp Message & Media Storage (MEDIA_STORAGE.md) ---
# Where media files live. MUST be the same directory for apps/web (which serves them) and
# apps/worker (which downloads them). docker-compose.yml mounts the `support_automation_media`
# volume at /app/media in both containers. For local development set an absolute path, e.g.
# MEDIA_STORAGE_DIR=C:/softify-media — there is deliberately no default outside Docker.
# Database backups do NOT include these files: back the volume up separately.
MEDIA_STORAGE_DIR=/app/media
# Only "local" exists today; an S3-compatible driver is a future addition behind the same interface.
MEDIA_STORAGE_DRIVER=local
# Below this much free space (MB) on the media disk, no new file is written.
MEDIA_MIN_FREE_DISK_MB=2048
# Downloads running at once in the worker (1–8).
MEDIA_DOWNLOAD_CONCURRENCY=2

# ── Messaging channels: Facebook Messenger, Instagram DM, Telegram (OMNICHANNEL.md) ──────────────
# Nothing is needed here: each project connects its own Page / Instagram account / bot under
# Settings → Messaging Channels, and the credentials are stored encrypted with
# AI_CREDENTIALS_ENCRYPTION_KEY. Webhook addresses are built from NEXTAUTH_URL, which must be the
# public https:// address for Meta and Telegram to reach them.
# Optional: the Meta Graph API version used for Messenger and Instagram calls (default v25.0).
# META_GRAPH_API_VERSION=v25.0

# ── Connect with Facebook: the PLATFORM's Meta app (docs/meta-integration/META_DEVELOPER_SETUP.md) ──
# One app for every customer: customers press "Connect with Facebook" and choose their Pages; they
# never see any of these. Off unless META_INTEGRATION_ENABLED=true. Never commit real values.
META_INTEGRATION_ENABLED=
META_APP_ID=
# Secret. App settings → Basic → App Secret.
META_APP_SECRET=
# Made up by you (16–128 letters/digits/-/_), also entered in the app's Webhooks settings.
META_WEBHOOK_VERIFY_TOKEN=
# Exactly as registered in Facebook Login for Business → Valid OAuth Redirect URIs.
# Defaults to <NEXTAUTH_URL>/api/meta/oauth/callback.
META_OAUTH_REDIRECT_URI=
# Optional: a Facebook Login for Business configuration id (replaces the scope list).
META_LOGIN_CONFIG_ID=
# Workspaces that may use it: project ids, comma-separated, or * for every workspace. Empty means NO
# workspace (it fails closed), so switching the integration on never reaches a customer by itself.
META_ALLOWED_PROJECT_IDS=

# --- SaaS hostname routing: emergency switch (SAAS_PLATFORM_PLAN.md §8) ---
# "true" forces hostname routing OFF, whatever Main Admin -> Domains says, so every address opens
# exactly as before routing existed. For recovery if the admin address is lost; leave empty normally.
SAAS_HOST_ROUTING_DISABLED=

# SaaS billing emails (worker): subscription reminders and owner invitations. Leave PLATFORM_SMTP_HOST
# empty to send nothing — the in-app renewal notice still shows. PLATFORM_SMTP_TLS: TLS or STARTTLS
# (default: TLS on port 465, STARTTLS otherwise).
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_TLS=
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_FROM_ADDRESS=
PLATFORM_SMTP_FROM_NAME=

# WhatsApp profile pictures (WHATSAPP_AVATARS.md): emergency stop for the whole server. "true" = nothing is recorded,
# fetched or served, whatever each project's WHATSAPP_AVATARS feature says. Leave empty normally.
WHATSAPP_AVATARS_DISABLED=
