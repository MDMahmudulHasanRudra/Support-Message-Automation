  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:isolated": "cross-env \"DATABASE_URL=postgresql://support_automation_test:support_automation_test@localhost:5433/support_automation_test?schema=public&connection_limit=5&pool_timeout=30&connect_timeout=30\" AI_CREDENTIALS_ENCRYPTION_KEY=dGVzdC1vbmx5LWtleS1uZXZlci11c2VkLWluLXByb2Q= vitest run"
  },
  "dependencies": {
    "@open-wa/wa-automate": "^4.76.0",
    "@prisma/client": "^5.20.0",
    "@support-automation/ai-client": "workspace:*",
    "@support-automation/db": "workspace:*",
    "@support-automation/engine": "workspace:*",
    "@support-automation/forge-client": "workspace:*",
    "@support-automation/shared": "workspace:*",
    "@support-automation/teams-client": "workspace:*",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
